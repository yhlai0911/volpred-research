{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/yhlai0911/volpred-research/.codex/hooks/pretooluse-bash-optimizer.sh'"
          }
        ]
      },
      {
        "matcher": "ScheduleWakeup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/yhlai0911/volpred-research/scripts/hooks/deny_wakeup_interactive.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/yhlai0911/.local/bin/graphify hook-check"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd /Users/yhlai0911/volpred-research && bash scripts/save_session_state.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/yhlai0911/volpred-research/scripts/auto_start_codex_loop.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash /Users/yhlai0911/volpred-research/scripts/warm_tcc_authorization.sh",
            "timeout": 35
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/yhlai0911/volpred-research/.codex/hooks/email_pool_reminder.sh'",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd /Users/yhlai0911/volpred-research && bash scripts/save_session_state.sh 2>/dev/null || true",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python3 /Users/yhlai0911/volpred-research/scripts/hooks/enforce_final_text.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}