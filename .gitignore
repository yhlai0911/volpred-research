# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg

# Virtual environment
.venv/
venv/

# IDE
.idea/
.vscode/
*.swp
*.swo
.pytest_cache/

# Data cache
data/cache/*.db

# Storage — large binary files
storage/reports/*.pdf
storage/knowledge_index/

# OS
.DS_Store
Thumbs.db

# Node / Frontend build artifacts
node_modules/
.next/
.next.stale.*/
out/

# Frontend repos (separate git repos)
frontend-v2-fix/

# Env / Secrets — NEVER commit
.env
.env.*
!.env.example
frontend-v2-fix/.env.local
frontend-v2/.env.local

# Claude worktrees (temporary)
.claude/worktrees/

# Agent skills rendered output (canonical source is agent-specs/skills/)
# Tracking both .agents/skills/ and .claude/skills/ creates 3-way drift.
# Canonical: agent-specs/ → rendered to .claude/skills/ (actively read by Claude Code).
# .agents/skills/ is a legacy third copy — gitignore from 2026-04-17 to simplify canonical governance.
.agents/skills/
.claude/scheduled_tasks.lock

# Local control-plane runtime state
storage/ops/tasks/
storage/ops/agents/
storage/ops/executions/
storage/ops/approvals/
storage/ops/rollback_points/
storage/ops/*.lock
storage/ops/locks/
storage/ops/writer_log.jsonl

# Supabase local
supabase/.temp/

# Backups (large, not needed in repo)
backups/
.codex-backups/
舊前端/
.worktree_tmp_*
texput.log

# Archive: keep tracked root-clutter records, ignore local archived payloads
archive/*
!archive/root-clutter/
archive/root-clutter/*
!archive/root-clutter/README.md
!archive/root-clutter/tracked/
!archive/root-clutter/tracked/**
archive/root-clutter/local/

# Compiled PDFs (regenerable from LaTeX)
paper/*/main.pdf
paper/*/main.aux
paper/*/main.log
paper/*/main.out
paper/*/main.toc
paper/*/main.bbl
paper/*/main.blg
paper/*/main.synctex.gz

# Large data files
data/intraday/*.csv

# Temp files
/tmp/
*.tmp
*.bak
*.orig

# Keep data/vixtwn (small) but ignore large 5-min CSVs
!data/
!data/vixtwn/
CLAUDE.md.backup.*
