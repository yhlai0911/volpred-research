#!/bin/bash
# Pre-push silent-fallback gate (2026-06-28).
# The git_push_backup wrapper gates AUTONOMOUS pushes, but MANUAL `git push`
# bypasses it — that's how dbcddc032 reached origin with new=1 and turned CI red.
# This git-level pre-push hook covers BOTH manual and scripted pushes: it runs
# the audit and blocks the push if HEAD carries new silent fallbacks, so red code
# can never reach origin regardless of who pushes.
#
# Install (idempotent): bash scripts/git_hooks/install.sh
# (copies this to .git/hooks/pre-push + chmod +x)
#
# Fail-open on audit error (uv missing / baseline absent): a broken gate must not
# block backups. Only a definitive new>0 blocks.
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$ROOT" || exit 0

# --- Gate 1: source encoding sweep (2026-07-02, zero tolerance) -------------
# Mojibake in a .py silently kills its gate — pytest collection dies and
# regression tests stop running unnoticed (docs/error_log.md 2026-07-02 14:11).
# Stdlib-only script; fail-open when script/python absent or on env error
# (exit 2). Only a definitive corruption (exit 1) blocks.
if [ -f scripts/audit_source_encoding.py ]; then
  PY_BIN="$(command -v python3 2>/dev/null)"
  if [ -n "$PY_BIN" ]; then
    ENC_OUT="$("$PY_BIN" scripts/audit_source_encoding.py 2>&1)"
    ENC_RC=$?
    if [ "$ENC_RC" -eq 1 ]; then
      printf '%s\n' "$ENC_OUT" | grep '^BAD '
      echo ""
      echo "[pre-push] BLOCKED: corrupted .py source (utf-8/U+FFFD/py_compile) — CI Source Encoding Gate would go red."
      echo "[pre-push] Rebuild the damaged lines from git history or semantics; do NOT delete the file."
      exit 1
    fi
  fi
fi

# --- Gate 2: silent-fallback audit (2026-06-28, baseline) -------------------
UV_BIN="${UV_BIN:-/opt/homebrew/bin/uv}"
[ -x "$UV_BIN" ] || UV_BIN="$(command -v uv 2>/dev/null)"
[ -n "$UV_BIN" ] || exit 0  # no uv → can't gate → fail-open

OUT="$("$UV_BIN" run python scripts/audit_silent_fallbacks.py --strict \
  --baseline storage/qa/silent_fallback_baseline.json 2>&1)"
RC=$?
NEW="$(printf '%s\n' "$OUT" | grep -oE 'new=[0-9]+' | head -1 | cut -d= -f2)"
if [ "$RC" -ne 0 ] && [ -n "$NEW" ] && [ "$NEW" -gt 0 ]; then
  printf '%s\n' "$OUT" | grep '^NEW '
  echo ""
  echo "[pre-push] BLOCKED: ${NEW} new silent fallback(s) — CI Silent Fallback Gate would go red."
  echo "[pre-push] Fix each (add 'from volpred.ops.diagnostics import warn' + warn(), or '# silent-ok: <reason>')."
  echo "[pre-push] If the NEW lines are only a line-shift of an existing baselined entry:"
  echo "[pre-push]   $UV_BIN run python scripts/audit_silent_fallbacks.py --write-baseline storage/qa/silent_fallback_baseline.json"
  echo "[pre-push] then retry the push."
  exit 1
fi
exit 0
