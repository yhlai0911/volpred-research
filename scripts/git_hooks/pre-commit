#!/bin/bash
# Pre-commit gate — stops a defect that pre-push already knows how to catch from
# ever entering a commit in the first place. Two gates, both mirrored from
# scripts/git_hooks/pre-push.
#
# Why (2026-07-11, boss via Telegram msg 481):
#   The silent-fallback rule was only enforced at pre-push. So a new bare
#   `except: return []` would land in a commit, sit there, and only surface
#   hours later when cron_git_push_backup.sh held the push and paged the boss.
#   Same defect, same fix, over and over. Moving the gate one step earlier means
#   the offending line never becomes a commit in the first place.
#
# Why gate 2 (2026-07-12, boss via email-12143: "立刻底層修好"):
#   The encoding gate had the identical shape — pre-push only. Commit e23fc0b82
#   landed 5 mojibake comment lines in tests/test_dreaming_review.py; every
#   git-push-backup for the next 9 hours failed exit=1 and the repo went
#   un-backed-up until the CRITICAL alert reached the owner. Same class as msg
#   481, one gate later. So it gets the same fix, not a new watchdog.
#
# Anti-stacking: neither gate is a new mechanism. The enforcement owners stay
#   scripts/audit_silent_fallbacks.py (+ storage/qa/silent_fallback_baseline.json)
#   and scripts/audit_source_encoding.py. pre-push stays authoritative — it audits
#   the pushed COMMIT TREE and so still catches --no-verify and supervisor
#   auto-commits. pre-commit only moves the trigger point earlier, and audits the
#   working tree (like the audits themselves do), which is what `git add` stages
#   from in every real path.
#
# Escape hatch: git commit --no-verify (pre-push will still catch it).

set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 0

# Only pay the cost when Python actually changed.
if ! git diff --cached --name-only --diff-filter=ACM | grep -qE '\.py$'; then
  exit 0
fi

PY="$(command -v uv >/dev/null 2>&1 && echo "uv run python" || echo python3)"

# --- Gate 1: source encoding (2026-07-12, zero tolerance) --------------------
# Cheapest gate first: mojibake makes the file undecodable, so every downstream
# audit and pytest collection on it silently stops running.
ENC="scripts/audit_source_encoding.py"
if [ -f "$ENC" ]; then
  ENC_OUT="$($PY "$ENC" 2>&1)"
  if [ $? -ne 0 ]; then
    echo "[pre-commit] BLOCKED — corrupted (non-UTF-8) .py source:"
    printf '%s\n' "$ENC_OUT" | grep '^BAD ' | sed 's/^/[pre-commit]   /' | head -20
    echo "[pre-commit] Rebuild the damaged lines from git history or semantics; do NOT delete the file."
    echo "[pre-commit] Cause is almost always non-ASCII text pushed through a shell heredoc/sed."
    exit 1
  fi
fi

# --- Gate 2: silent fallbacks (2026-07-11, baseline) ------------------------
AUDIT="scripts/audit_silent_fallbacks.py"
BL="storage/qa/silent_fallback_baseline.json"
[ -f "$AUDIT" ] && [ -f "$BL" ] || exit 0

OUT="$($PY "$AUDIT" --strict --baseline "$BL" --limit 20 2>&1)"
RC=$?

if [ "$RC" -ne 0 ]; then
  echo "[pre-commit] BLOCKED — this commit introduces new silent fallback(s):"
  echo "$OUT" | sed 's/^/[pre-commit]   /'
  echo "[pre-commit] Fix each: add 'from volpred.ops.diagnostics import warn' + warn(...) before the fallback,"
  echo "[pre-commit] or mark it '# silent-ok: <reason>' when it is genuinely a legit silent path."
  echo "[pre-commit] Rule: .claude/rules/no-silent-fallback.md"
  exit 1
fi

exit 0
