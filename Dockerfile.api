FROM python:3.12-slim

WORKDIR /app

# Install only the API runtime surface. The research package has heavyweight
# modelling deps (torch/CUDA, xgboost, lancedb) that the mirror API does not
# need; pulling them makes this small service slow and fragile to deploy.
RUN pip install --no-cache-dir \
    fastapi==0.135.1 \
    pydantic==2.12.5 \
    uvicorn==0.41.0

# Copy project files needed by the API routers.
COPY src/ src/
COPY config/ config/
COPY research_program.md idea.md ./

# Create empty dirs (runtime data comes from volume mount)
RUN mkdir -p storage data

# Expose port (Zeabur uses 8080 by default via $PORT)
EXPOSE 8080

# Run API — use $PORT env var (Zeabur sets this), fallback to 8080
CMD ["sh", "-c", "uvicorn api.main:app --host 0.0.0.0 --port ${PORT:-8080}"]

ENV PYTHONPATH=/app/src
