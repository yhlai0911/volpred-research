FROM python:3.12-slim

WORKDIR /app

# Install uv
RUN pip install uv

# Copy project files
COPY pyproject.toml uv.lock ./
COPY src/ src/
COPY storage/ storage/
COPY research_program.md ./
COPY data/ data/

# Install dependencies
RUN uv sync --no-dev

# Expose port
EXPOSE 8787

# Run API
CMD ["uv", "run", "uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8787"]

ENV PYTHONPATH=/app/src
