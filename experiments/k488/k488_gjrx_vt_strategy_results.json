      "GJRX_VT_Blend: w = 12/\u03c3_GARCHX (annualized)",
      "GJR_VT_Blend: w = 12/\u03c3_GJR (control)",
      "Hybrid_VT_Blend: w = 12/(0.5*VIX + 0.5*\u03c3_GARCHX)"
    ],
    "models": {
      "GJR-GARCH-X(VIX)": "h_t = \u03c9 + \u03b1\u00b7\u03b5\u00b2_{t-1} + \u03b3\u00b7I(\u03b5<0)\u00b7\u03b5\u00b2_{t-1} + \u03b2\u00b7h_{t-1} + \u03b4\u00b7VIX\u00b2_{t-1}/252",
