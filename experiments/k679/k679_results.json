    "strategies": {
      "12/VIX": "w = min(12/VIX, 1.0) \u2014 absolute VIX level",
      "Percentile": "w = 1 - percentile_rank(VIX, 252d) \u2014 relative to recent history",
      "Z-Score": "w = clip(1 - z/3, 0, 1) where z = (VIX - mean_252d) / std_252d",
      "Adaptive 12/VIX": "w = min(k/VIX, 1.0) where k = 12 * (avg_252d / expanding_avg)"
    }
  },
