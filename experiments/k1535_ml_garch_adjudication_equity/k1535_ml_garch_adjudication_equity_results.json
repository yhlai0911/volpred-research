    "claimed_winner": "PatchTST-lite over LSTM/CNN-LSTM/Vanilla-Transformer and ARIMA/GARCH(1,1)/HAR-RV on daily RV, h=1/5/22",
    "weaknesses_targeted": {
      "M1": "weak baseline \u2014 only plain Gaussian GARCH(1,1)",
      "M2": "no significance test on the DL models (DM/MCS classical-only)",
      "M3": "possible covariate asymmetry (RV proxy to NN, return^2 to GARCH)"
    },
    "paper_numbers_verified": "unverified \u2014 not cross-checked against PDF in smoke"
  },
