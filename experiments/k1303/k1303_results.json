      "mean J-share_{t-22..t-1}"
    ],
    "split": "70/30 chronological",
    "pass_rule": "|DM_HLN_t| > 3 AND HAR-CJ lower QLIKE (Harvey 2016 threshold)",
    "seed": 42
  },
