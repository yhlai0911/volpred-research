        "dcot_month_complete": "nweeks >= 4 AND every gap between consecutive reports <= 9d, INCLUDING the entry gap from the previous month's last report AND month_end - last_report <= 6d",
        "dcot_rule_detects": "a skipped week anywhere, first week included, because continuity is measured against the previous report rather than against the month boundary: deleting any single report makes one gap about 14 days (observed gaps in this cache are only 6, 7 or 8 days). A month with no earlier report at all -- the first month of the series -- can never be certified and is dropped.",
        "rv_month_complete": "trading days >= 15 AND expected_trading_days - trading days <= 2 AND max(trading days across commodities that month) - trading days <= 2 AND expected_trading_days - max(trading days that month) <= 1",
