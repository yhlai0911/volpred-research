  "design": {
    "train_end": "2019-12-31",
    "oos_start": "2020-01-02",
    "portfolio_return_formula": "(1+r_asset_usd)*(1+(1-h_t)*r_usdtwd)-1",
    "hedge_ratio_clip": [
