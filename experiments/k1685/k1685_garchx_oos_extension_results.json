  "experiment_id": "K1685",
  "title": "Extended-OOS re-check of A4f vs GJR under the K988/K1393-faithful spec",
  "paper": "garch-x-vix (Paper 9), review item P0-2",
  "run_at": "2026-07-11T19:49:21.396346+00:00",
