      0.05,
      0.01
    ],
    "gpd_tail_fraction": 0.1,
    "fz_loss": "Fissler-Ziegel style joint VaR/ES loss for left-tail returns; lower is better; ES < VaR < 0 enforced.",
    "e_backtest_es": "Sequential ES e-process following Wang-Wang-Ziegel / Zhao public R reference: positive loss L=-return, e=max(L-VaR,0)/((1-p)*(ES-VaR)), GREM=0.5*GREE+0.5*GREL, window=250, detection thresholds 2/5/10.",
    "dm_hac_gate": "Harvey-style |t| > 3.0",
    "lookahead_guard": "For forecast date t, GARCH refits use y.iloc[:pos] only, excluding r_t; daily recursion uses r[t-1] and previous sigma2 only."
