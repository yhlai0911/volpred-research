    "dm_test": "Newey-West HAC on QLIKE loss diff, lag=max(H-1,1), negative t means augmented better.",
    "bootstrap": "Stationary block bootstrap on QLIKE loss diff, reps=1000, block_len=1.5*H, fixed seed offsets from 42.",
