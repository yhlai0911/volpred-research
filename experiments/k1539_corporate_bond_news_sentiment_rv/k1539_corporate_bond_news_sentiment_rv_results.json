  "method": {
    "proxy_definition": [
      "FRBSF Daily News Sentiment is converted to bad-news stress as -sentiment, then rolling z-scored.",
      "GDELT corporate-credit keyword tone is attempted and, if available, also inverted and z-scored.",
      "The final news_stress_z is the rolling z-score of the average available stress components."
    ],
    "lookahead_guard": "news_stress_z is used only through signal_lag = news_stress_z.shift(1); targets begin at date t.",
    "return_targets": "Forward 5d and 21d log returns for HYG/LQD/BKLN/VCIT/VCSH.",
    "risk_targets": [
      "Forward 5d and 21d log(1 + annualized realized variance).",
      "Forward 5d and 21d log(1 + annualized downside semivariance).",
      "Forward 5d and 21d negative HYG-minus-LQD log return as a spread-stress proxy."
    ],
    "controls": [
      "own lagged 21-day realized variance",
      "SPY lagged 21-day realized variance",
      "lagged log VIX",
      "lagged HYG-LQD 21-day underperformance"
    ],
    "formal_tests": [
      "OLS predictive regressions with Newey-West HAC standard errors.",
      "Harvey-style |t|>=3 gate, with negative expected sign for returns and positive expected sign for risk.",
      "Bonferroni and BH q-values within return and risk families.",
      "Expanding-window OOS MSE comparison for risk targets, with HAC DM test on augmented-minus-baseline squared-error loss."
    ]
  },
  "related_prior": [
    "K1487: GDELT novel-risk keyword intensity did not improve HAR/VIX RV forecasts for HYG/TLT/SPY/QQQ.",
