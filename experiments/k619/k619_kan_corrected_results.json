      "architecture": "1 KAN layer (8->5) + Linear output",
      "hidden_size": 5,
      "n_bases": 8,
      "parameters": 366,
      "features": [
        "|r_t-1|",
        "|r_t-2|",
        "|r_t-3|",
        "|r_t-4|",
        "|r_t-5|",
        "rv5",
        "rv22",
