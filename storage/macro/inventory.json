      "RSAFS": "Retail Sales (log-diff)",
      "PAYEMS": "Nonfarm Payrolls (log-diff)",
      "PERMIT": "Building Permits (level)"
    },
    "us_daily_regressors": {
      "DGS10": "10Y Treasury Yield",
