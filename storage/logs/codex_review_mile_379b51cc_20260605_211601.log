   429	    ci_rs = bootstrap_mse_ci(e_rs ** 2)
   430	
   431	    # In-sample R2 (sanity)
   432	    def _r2(y, yhat):
   433	        ss_res = float(((y - yhat) ** 2).sum())
   434	        ss_tot = float(((y - y.mean()) ** 2).sum())
   435	        return 1.0 - ss_res / ss_tot if ss_tot > 0 else float("nan")
   436	    r2_rv_is = _r2(y[idx_train], predict_ols(beta_rv, X_rv[idx_train]))
   437	    r2_rs_is = _r2(y[idx_train], predict_ols(beta_rs, X_rs[idx_train]))
