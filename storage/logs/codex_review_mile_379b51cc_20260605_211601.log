   352	def dm_hln(loss_a: np.ndarray, loss_b: np.ndarray, h: int = 1) -> Tuple[float, float]:
   353	    """Diebold-Mariano with Harvey-Leybourne-Newbold small-sample correction.
   354	
   355	    d_t   = loss_a - loss_b
   356	    DM    = mean(d) / sqrt(Var_lr(d)/T)
   357	    HLN   = DM * sqrt((T + 1 - 2h + h(h-1)/T) / T)
   358	    p     = 2 * (1 - t_cdf(|HLN|, df=T-1))
   359	    """
   360	    from scipy import stats as sp_stats
   361	    d = np.asarray(loss_a, dtype=float) - np.asarray(loss_b, dtype=float)
   362	    T = len(d)
   363	    if T < 3:
   364	        return float("nan"), float("nan")
   365	    mu = d.mean()
   366	    # Newey-West HAC variance with h-1 lags (here h=1 => just sample variance)
   367	    if h <= 1:
   368	        gamma0 = ((d - mu) ** 2).mean()
   369	        v = gamma0
   370	    else:
   371	        gammas = [((d[:T - k] - mu) * (d[k:] - mu)).mean() for k in range(h)]
   372	        v = gammas[0] + 2 * sum(gammas[1:])
   373	    if v <= 0:
   374	        return float("nan"), float("nan")
   375	    dm = mu / np.sqrt(v / T)
   376	    corr = np.sqrt((T + 1 - 2 * h + h * (h - 1) / T) / T)
   377	    hln = dm * corr
   378	    p = 2.0 * (1.0 - sp_stats.t.cdf(abs(hln), df=T - 1))
   379	    return float(hln), float(p)
   380	
   381	
   382	def bootstrap_mse_ci(losses: np.ndarray, n_boot: int = 1000,
   383	                     seed: int = SEED) -> Tuple[float, float]:
   384	    rng = np.random.default_rng(seed)
   385	    T = len(losses)
   386	    means = np.empty(n_boot)
   387	    for b in range(n_boot):
   388	        idx = rng.integers(0, T, T)
   389	        means[b] = losses[idx].mean()
   390	    return float(np.quantile(means, 0.025)), float(np.quantile(means, 0.975))
