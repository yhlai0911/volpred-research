   471	def spearman_corr(actual, forecast):
   472	    """Spearman rank correlation."""
   473	    a = np.asarray(actual, dtype=np.float64)
   474	    f = np.asarray(forecast, dtype=np.float64)
   475	    valid = np.isfinite(a) & np.isfinite(f)
   476	    a, f = a[valid], f[valid]
   477	    if len(a) < 10:
   478	        return np.nan
   479	    corr, _ = sp_stats.spearmanr(a, f)
