   296	def fit_har_ols(y, X):
   297	    """OLS fit: y = [1, X] @ beta. Returns beta, residuals."""
   298	    n = len(y)
   299	    X_c = np.column_stack([np.ones(n), X])
   300	    try:
   301	        beta = np.linalg.lstsq(X_c, y, rcond=None)[0]
   302	        y_hat = X_c @ beta
   303	        resid = y - y_hat
   304	        ss_res = np.sum(resid ** 2)
   305	        ss_tot = np.sum((y - np.mean(y)) ** 2)
   306	        r2 = 1 - ss_res / ss_tot if ss_tot > 0 else 0
   307	        return beta, r2
   308	    except Exception:
   309	        return None, None
