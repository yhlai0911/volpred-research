   313	# 3) HAR / HAR-PD feature builder
   314	# ======================================================================
   315	def build_features(daily: pd.DataFrame) -> pd.DataFrame:
   316	    """Build HAR-RV (baseline) and HAR-PD-RV (paper eq. 11) features.
   317	
   318	    HAR-RV (baseline):
   319	        log RV_{t-1}, log mean RV_{[t-5,t-1]}, log mean RV_{[t-22,t-1]}
   320	
   321	    HAR-PD-RV (treatment, per paper eq. 11):
   322	        R2_{t-1,d}, R2_{t-1,w}, R2_{t-1,m}      (squared-path features, 3 λ)
   323	        (plus auxiliary R1_{t-1,d} for diagnostics; the primary spec follows
   324	         paper eq. 11 which uses R2 only — R1 is the "trend" feature reserved
   325	         for HAR-PD-RS / HAR-PD-CJ extensions.)
   326	
   327	    Apples-to-apples lag convention: HAR-RV uses .shift(1)+rolling; HAR-PD
   328	    uses .shift(1) on the close series inside compute_path_features().
   329	
   330	    Target: log(RV_{t+1}) via .shift(-1) on RV column.
   331	    """
   332	    d = daily.copy().sort_values("date").reset_index(drop=True)
   333	    eps = 1e-12
   334	
   335	    rv_lag1 = d["rv"].shift(1)
   336	    d["rv_d"] = rv_lag1
   337	    d["rv_w"] = rv_lag1.rolling(window=5, min_periods=5).mean()
   338	    d["rv_m"] = rv_lag1.rolling(window=22, min_periods=22).mean()
   339	
   340	    # Path features
   341	    pf = compute_path_features(d["close_eod"], max_lag=22,
   342	                                lambdas=(4.0, 1.0, 0.25))
   343	    d = pd.concat([d, pf], axis=1)
   344	
   345	    d["Y"] = np.log(d["rv"].shift(-1).clip(lower=eps))
   346	
   347	    har_cols = ["rv_d", "rv_w", "rv_m"]
   348	    pd_cols = ["R2_d", "R2_w", "R2_m"]
   349	
   350	    d = d.dropna(subset=har_cols + pd_cols + ["Y"]).reset_index(drop=True)
   351	
   352	    # Log-transform HAR-RV features (RV>0).
   353	    for c in har_cols:
   354	        d[c] = np.log(d[c].clip(lower=eps))
   355	    # R2 features are non-negative path variances; use log1p (with small
   356	    # floor) so OLS is on a comparable scale; R2 can be 0 only if all
   357	    # past returns are exactly 0 which never happens in practice.
   358	    for c in pd_cols:
   359	        d[c] = np.log(d[c].clip(lower=eps))
   360	    return d
