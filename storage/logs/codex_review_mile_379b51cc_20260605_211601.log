   525	    target = df['log_rv_full'].values
   526	    forecasts_log = np.full(n, np.nan)
   527	
   528	    beta = None
   529	    last_fit_t = -999
   530	
   531	    for t in range(oos_start, n - 1):
   532	        # Refit if needed
   533	        if beta is None or (t - last_fit_t) >= refit_freq:
   534	            # Build training set: all available data up to t
