   417	    yhat_rs_te = predict_ols(beta_rs, X_rs[idx_test])
   418	
   419	    e_rv = y[idx_test] - yhat_rv_te
   420	    e_rs = y[idx_test] - yhat_rs_te
   421	    mse_rv = float((e_rv ** 2).mean())
   422	    mse_rs = float((e_rs ** 2).mean())
