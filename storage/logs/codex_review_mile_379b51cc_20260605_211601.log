   300	    eps = 1e-12
   301	
   302	    rv_lag1 = d["rv"].shift(1)
   303	    rsp_lag1 = d["rs_plus"].shift(1)
   304	    rsn_lag1 = d["rs_minus"].shift(1)
   305	
   306	    # Weekly = avg of last 5 daily values [t-5, ..., t-1]
   307	    d["rv_d"] = rv_lag1
   308	    d["rv_w"] = rv_lag1.rolling(window=5, min_periods=5).mean()
   309	    d["rv_m"] = rv_lag1.rolling(window=22, min_periods=22).mean()
   310	
   311	    d["rsp_d"] = rsp_lag1
   312	    d["rsp_w"] = rsp_lag1.rolling(window=5, min_periods=5).mean()
   313	    d["rsp_m"] = rsp_lag1.rolling(window=22, min_periods=22).mean()
   314	
   315	    d["rsn_d"] = rsn_lag1
   316	    d["rsn_w"] = rsn_lag1.rolling(window=5, min_periods=5).mean()
   317	    d["rsn_m"] = rsn_lag1.rolling(window=22, min_periods=22).mean()
   318	
   319	    # Target: log(RV_{t+1})  -- shift up so row at date t carries Y for next day
   320	    rv_shift = d["rv"].shift(-1)
