   382	def gjr_oos_forecast(returns_series, oos_start_idx, refit_freq=63):
   383	    """
   384	    OOS GJR forecasts with rolling refit.
   385	    Returns array of conditional variance forecasts (in return-scale, not *100).
   386	    """
   387	    n = len(returns_series)
   388	    forecasts = np.full(n - oos_start_idx, np.nan)
   389	    last_fit = None
   390	    last_fit_idx = -999
   391	
   392	    for i in range(oos_start_idx, n):
   393	        idx = i - oos_start_idx
   394	        # Refit if needed
   395	        if last_fit is None or (i - last_fit_idx) >= refit_freq:
   396	            train_rets = returns_series[:i]
   397	            if len(train_rets) < MIN_TRAIN:
   398	                continue
   399	            res = fit_gjr_garch(train_rets.values)
   400	            if res is not None:
   401	                last_fit = res
   402	                last_fit_idx = i
   403	
   404	        if last_fit is not None:
   405	            try:
   406	                # One-step-ahead forecast
   407	                fcast = last_fit.forecast(horizon=1, reindex=False)
   408	                h = fcast.variance.values[-1, 0]
   409	                # Convert from (ret*100)^2 back to ret^2 scale
   410	                forecasts[idx] = h / (100 ** 2)
   411	
   412	                # Re-estimate recursion: h[t] = omega + alpha*r^2[t-1] + gamma*r^2[t-1]*I + beta*h[t-1]
   413	                # This is the proper OOS recursive update (not stale variance)
   414	                params = last_fit.params
   415	                omega = params.get('omega', 0)
   416	                alpha = params.get('alpha[1]', 0)
   417	                gamma_param = params.get('gamma[1]', 0)
   418	                beta_param = params.get('beta[1]', 0)
   419	
   420	                r_prev = returns_series.iloc[i - 1] * 100  # in *100 scale
   421	                h_prev = forecasts[idx - 1] * (100 ** 2) if idx > 0 and np.isfinite(forecasts[idx - 1]) else h
   422	                indicator = 1.0 if r_prev < 0 else 0.0
   423	                h_new = omega + alpha * r_prev ** 2 + gamma_param * r_prev ** 2 * indicator + beta_param * h_prev
   424	                forecasts[idx] = h_new / (100 ** 2)
   425	            except Exception:
   426	                pass
   427	
   428	    return forecasts
