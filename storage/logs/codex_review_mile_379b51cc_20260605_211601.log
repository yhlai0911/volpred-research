   362	
   363	def fit_gjr_garch(returns, p=1, o=1, q=1):
   364	    """
   365	    Fit GJR-GARCH(1,1,1) using arch package.
   366	    Returns model result or None.
   367	    """
   368	    try:
   369	        from arch import arch_model
   370	        am = arch_model(returns * 100, vol='GARCH', p=p, o=o, q=q,
   371	                        dist='studentst', mean='Constant', rescale=False)
   372	        res = am.fit(disp='off', show_warning=False)
   373	        if res.convergence_flag != 0:
   374	            # Try with default starting values
   375	            res = am.fit(disp='off', show_warning=False,
   376	                         starting_values=None)
   377	        return res
   378	    except Exception:
   379	        return None
