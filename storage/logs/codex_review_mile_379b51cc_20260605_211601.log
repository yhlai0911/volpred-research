                    d = bs[:, i] - bs[:, j]
                    d0 = d - np.mean(d)
                    se = np.std(d0) / np.sqrt(n)
                    if se > 1e-15:
                        bt = max(bt, abs(np.mean(d0)) / se)
            boot_t[b] = bt

        p_val = np.mean(boot_t >= t_max)
        if p_val >= alpha:
            break
        avg = np.mean(sub, axis=0)
        worst = np.argmax(avg)
        remaining.pop(worst)

