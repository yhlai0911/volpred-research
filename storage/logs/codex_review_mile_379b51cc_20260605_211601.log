   377	def dm_hln(loss_a: np.ndarray, loss_b: np.ndarray, h: int = 1) -> Tuple[float, float]:
   378	    """Diebold-Mariano with Harvey-Leybourne-Newbold small-sample correction.
   379	
   380	    d_t = loss_a - loss_b ; positive => a worse => b preferred.
   381	    """
   382	    from scipy import stats as sp_stats
   383	    d = np.asarray(loss_a, dtype=float) - np.asarray(loss_b, dtype=float)
   384	    T = len(d)
   385	    if T < 3:
   386	        return float("nan"), float("nan")
   387	    mu = d.mean()
   388	    if h <= 1:
   389	        v = ((d - mu) ** 2).mean()
   390	    else:
   391	        gammas = [((d[:T - k] - mu) * (d[k:] - mu)).mean() for k in range(h)]
   392	        v = gammas[0] + 2 * sum(gammas[1:])
   393	    if v <= 0:
   394	        return float("nan"), float("nan")
   395	    dm = mu / np.sqrt(v / T)
   396	    corr = np.sqrt((T + 1 - 2 * h + h * (h - 1) / T) / T)
   397	    hln = dm * corr
   398	    p = 2.0 * (1.0 - sp_stats.t.cdf(abs(hln), df=T - 1))
   399	    return float(hln), float(p)
