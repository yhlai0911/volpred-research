   263	def prepare_har_features(df):
   264	    """
   265	    Add log-RV and rolling averages for HAR regressors.
   266	    Floor small RV values before log to avoid -inf.
   267	    """
   268	    df = df.copy()
   269	
   270	    # Floor and log-transform
   271	    for col in ['rv_full', 'rv_day', 'rv_night']:
   272	        df[f'log_{col}'] = np.log(df[col].clip(lower=SMALL_CONST))
   273	
   274	    # Night ratio: RV_night / RV_total
   275	    df['night_ratio'] = df['rv_night'] / df['rv_full'].clip(lower=SMALL_CONST)
   276	    df['night_ratio'] = df['night_ratio'].clip(0, 1)
   277	
   278	    # Rolling averages: 5-day and 22-day (for HAR weekly/monthly)
   279	    for col in ['log_rv_full', 'log_rv_day', 'log_rv_night']:
   280	        df[f'{col}_5d'] = df[col].rolling(5).mean()
   281	        df[f'{col}_22d'] = df[col].rolling(22).mean()
   282	
   283	    df['night_ratio_5d'] = df['night_ratio'].rolling(5).mean()
   284	    df['night_ratio_22d'] = df['night_ratio'].rolling(22).mean()
   285	
   286	    # Squared daily return for GJR and cross-model comparison
   287	    df['r_squared'] = df['daily_return'] ** 2
   288	
   289	    return df
