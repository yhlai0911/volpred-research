   410	    idx_test = np.arange(n_train, T)
   411	
   412	    # Fit on training, predict test
   413	    beta_rv = fit_ols(X_rv[idx_train], y[idx_train])
   414	    beta_rs = fit_ols(X_rs[idx_train], y[idx_train])
   415	
