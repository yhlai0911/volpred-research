   366	# ======================================================================
   367	# 4) ABD3 FIX: Standard 1-step HAR feature builder
   368	#    Features at t-1 predict target RV_t (not RV_{t+1})
   369	# ======================================================================
   370	def build_har_features(daily: pd.DataFrame) -> pd.DataFrame:
   371	    """Build HAR-RV and HAR-CJ features with STANDARD 1-step lag.
   372	
   373	    ABD Fix 3: Target = log(RV_t), features use t-1 values.
   374	    Standard HAR: RV_t = a + b_d*RV_{t-1} + b_w*RV_w + b_m*RV_m + eps
   375	
   376	    All features use .shift(1) so feature at row t reflects day t-1 value.
   377	    Rolling windows also shifted: rv_w = mean(RV_{t-5..t-1}).
   378	
   379	    Returns dataframe with:
   380	      Y            = log(RV_t)  -- target at row t (NO future shift)
   381	      rv_d, rv_w, rv_m  = HAR-RV features
   382	      cv_d, cv_w, cv_m  = HAR-CJ continuous-component features
   383	      j_d,  j_w,  j_m   = HAR-CJ jump-component features (log1p scale)
   384	    """
   385	    d = daily.copy().sort_values("date").reset_index(drop=True)
   386	    eps = 1e-12
   387	
   388	    # ABD3 Fix: shift(1) so feature at row t = value from day t-1
   389	    rv_lag1 = d["rv"].shift(1)
   390	    cv_lag1 = d["cv"].shift(1)
   391	    j_lag1 = d["j"].shift(1)
   392	
   393	    # HAR-RV features: daily, weekly (mean of last 5 days), monthly (mean of last 22 days)
   394	    # Rolling applied to lagged series → rv_w at row t = mean(rv_{t-5..t-1})
   395	    d["rv_d"] = rv_lag1
   396	    d["rv_w"] = rv_lag1.rolling(window=5, min_periods=5).mean()
   397	    d["rv_m"] = rv_lag1.rolling(window=22, min_periods=22).mean()
   398	
   399	    # HAR-CJ continuous features
   400	    d["cv_d"] = cv_lag1
   401	    d["cv_w"] = cv_lag1.rolling(window=5, min_periods=5).mean()
   402	    d["cv_m"] = cv_lag1.rolling(window=22, min_periods=22).mean()
   403	
   404	    # HAR-CJ jump features: J expressed as FRACTION of RV (jump share, dimensionless [0,1])
   405	    # This prevents explosive betas caused by the extreme scale mismatch between
   406	    # log(CV) (~-10 log scale) and log1p(J_abs) (~0.000006). Using J/RV puts the
   407	    # j features in [0,1] range, making OLS coefficients interpretable.
   408	    # j_share_{t-1} = J_{t-1} / RV_{t-1} (= 0 on non-jump days after threshold)
   409	    j_share_lag1 = j_lag1 / rv_lag1.clip(lower=eps)  # dimensionless jump share
   410	    d["j_d"] = j_share_lag1
   411	    d["j_w"] = j_share_lag1.rolling(window=5, min_periods=5).mean()
   412	    d["j_m"] = j_share_lag1.rolling(window=22, min_periods=22).mean()
   413	
   414	    # ABD3 Fix: Target = log(RV_t) — same-day realized variance (no shift(-1))
   415	    d["Y"] = np.log(d["rv"].clip(lower=eps))
   416	
   417	    feat_cols_rv = ["rv_d", "rv_w", "rv_m"]
   418	    feat_cols_cv = ["cv_d", "cv_w", "cv_m"]
   419	    feat_cols_j = ["j_d", "j_w", "j_m"]
   420	
   421	    d = d.dropna(subset=feat_cols_rv + feat_cols_cv + feat_cols_j + ["Y"]).reset_index(drop=True)
   422	
   423	    # Log-transform RV and CV features (strictly positive)
   424	    for c in feat_cols_rv + feat_cols_cv:
   425	        d[c] = np.log(d[c].clip(lower=eps))
   426	    # j features are already in [0,1] (jump share ratio) — no log transform needed
   427	    # (many zeros; log1p of a ratio in [0,1] compresses variation further)
   428	    for c in feat_cols_j:
   429	        d[c] = d[c].clip(lower=0.0)  # ensure non-negative; no log transform
   430	    return d
   431	
