                    t_stats[i, j] = abs(np.mean(d)) / se
                    t_stats[j, i] = t_stats[i, j]

        t_max = np.max(t_stats)
        boot_t = np.zeros(n_boot)
        for b in range(n_boot):
            idx = np.random.randint(0, n, size=n)
            bs = sub[idx]
            bt = 0.0
            for i in range(m_count):
