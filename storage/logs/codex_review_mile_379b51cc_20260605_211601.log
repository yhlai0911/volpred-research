   483	def dm_test_nw(loss1, loss2, h=1):
   484	    """
   485	    Diebold-Mariano test with Newey-West HAC.
   486	    Negative t -> model 1 is better.
   487	    Harvey (2016): |t| > 3.0 for significance.
   488	    """
   489	    d = np.asarray(loss1, dtype=np.float64) - np.asarray(loss2, dtype=np.float64)
   490	    valid = np.isfinite(d)
   491	    d = d[valid]
   492	    n = len(d)
   493	    if n < 10:
   494	        return np.nan, np.nan
   495	
   496	    d_bar = np.mean(d)
   497	    # Newey-West HAC variance
   498	    max_lag = max(1, int(np.floor(n ** (1 / 3))))
   499	    gamma_0 = np.mean((d - d_bar) ** 2)
   500	    nw_var = gamma_0
   501	    for lag in range(1, max_lag + 1):
   502	        w = 1 - lag / (max_lag + 1)
   503	        gamma_k = np.mean((d[lag:] - d_bar) * (d[:-lag] - d_bar))
   504	        nw_var += 2 * w * gamma_k
   505	
   506	    if nw_var <= 0:
