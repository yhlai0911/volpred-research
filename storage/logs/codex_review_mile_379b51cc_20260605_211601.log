    70	# ─── Layer 3: Spearman Rank Correlation ──────────────────────────
    71	
    72	def spearman_corr(actual: np.ndarray, predicted: np.ndarray) -> Tuple[float, float]:
    73	    """Spearman rank correlation. Returns (rho, p_value)."""
    74	    valid = np.isfinite(actual) & np.isfinite(predicted)
    75	    if valid.sum() < 10:
    76	        return (np.nan, np.nan)
    77	    rho, p = stats.spearmanr(actual[valid], predicted[valid])
    78	    return (float(rho), float(p))
    79	
    80	
    81	# ─── Layer 4: Diebold-Mariano Test ──────────────────────────────
    82	
    83	def dm_test(loss1: np.ndarray, loss2: np.ndarray, h: int = 1) -> Tuple[float, float]:
    84	    """Diebold-Mariano test with Newey-West HAC.
    85	    Negative t → model 1 is better. Harvey (2016): |t| > 3.0 for significance.
    86	    """
    87	    d = np.asarray(loss1, dtype=np.float64) - np.asarray(loss2, dtype=np.float64)
    88	    valid = np.isfinite(d)
    89	    d = d[valid]
    90	    n = len(d)
    91	    if n < 10:
    92	        return (0.0, 1.0)
    93	
    94	    d_mean = np.mean(d)
