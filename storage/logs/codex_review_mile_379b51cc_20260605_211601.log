   433	# ======================================================================
   434	# 5) OLS helpers
   435	# ======================================================================
   436	def fit_ols(X: np.ndarray, y: np.ndarray) -> np.ndarray:
   437	    X1 = np.column_stack([np.ones(len(X)), X])
   438	    beta, *_ = np.linalg.lstsq(X1, y, rcond=None)
   439	    return beta
   440	
   441	
   442	def predict_ols(beta: np.ndarray, X: np.ndarray) -> np.ndarray:
   443	    X1 = np.column_stack([np.ones(len(X)), X])
   444	    return X1 @ beta
   445	
