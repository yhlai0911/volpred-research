   267	# ======================================================================
   268	# 2) Path-feature constructors (paper eq. 4, 5, 11)
   269	# ======================================================================
   270	def _exp_kernel_weights(N: int, lam: float) -> np.ndarray:
   271	    """K_lambda(tau) = lambda * exp(-lambda * tau), tau = 1..N (lag in days)."""
   272	    tau = np.arange(1, N + 1, dtype=float)
   273	    return lam * np.exp(-lam * tau)
   274	
   275	
   276	def compute_path_features(close_eod: pd.Series, max_lag: int = 22,
   277	                          lambdas: Tuple[float, float, float] = (4.0, 1.0, 0.25)
   278	                          ) -> pd.DataFrame:
   279	    """Compute R1 (signed-trend) and R2 (squared-path-vol) for three λ.
   280	
   281	    For each row t, uses r̃_{t-i} for i=1..max_lag where r̃_{t-i} = (S_{t-1}-S_{t-1-i})/S_{t-1-i}.
   282	    The OUTER `.shift(1)` of S protects against using day-t close to predict day-t RV.
   283	
   284	    Returns DataFrame indexed same as close_eod with columns:
   285	        R1_d, R1_w, R1_m, R2_d, R2_w, R2_m
   286	    (suffix d/w/m → λ_fast/λ_med/λ_slow per spec).
   287	    """
   288	    s = close_eod.astype(float)
   289	    s_lag1 = s.shift(1)  # never use day-t close
   290	    # We construct r̃_{t-i} = (s_lag1[t] - s_lag1[t-i]) / s_lag1[t-i]
   291	    # so r̃ at "lag i" is the cumulative return from (t-1-i) to (t-1).
   292	    # Build a 2-D array of r̃ for i=1..max_lag.
   293	    n = len(s_lag1)
   294	    r_tilde = np.full((n, max_lag), np.nan, dtype=float)
   295	    for i in range(1, max_lag + 1):
   296	        denom = s_lag1.shift(i)  # this is S_{t-1-i}
   297	        r_tilde[:, i - 1] = (s_lag1 - denom) / denom
   298	
   299	    # NaN at early rows naturally; fillna -> propagate (we keep NaN, dropna later)
   300	    out = pd.DataFrame(index=close_eod.index)
   301	    suffixes = ("d", "w", "m")
   302	    for lam, sfx in zip(lambdas, suffixes):
   303	        w = _exp_kernel_weights(max_lag, lam)
   304	        # Normalize weights to sum 1 so coefficient scale is comparable across λ.
   305	        w = w / w.sum()
   306	        # R1 = sum_i w_i * r̃_{t-i}  ; r_tilde is N rows × max_lag cols
   307	        out[f"R1_{sfx}"] = (r_tilde * w[None, :]).sum(axis=1)
   308	        out[f"R2_{sfx}"] = ((r_tilde ** 2) * w[None, :]).sum(axis=1)
   309	    return out
   310	
