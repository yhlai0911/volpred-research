   448	# 6) Per-asset evaluation with ABD2 fix: QLIKE + HAC DM
   449	# ======================================================================
   450	def evaluate_asset(name: str, daily_raw: pd.DataFrame) -> Dict:
   451	    """Evaluate HAR-RV vs HAR-CJ for one asset.
   452	
   453	    ABD2 Fix: Use QLIKE pointwise losses + HAC dm_test from model_evaluation.py.
   454	    ABD3 Fix: Standard 1-step lag (features t-1 → target t).
   455	    ABD1 Fix: Jump threshold applied to daily before feature building.
   456	    """
   457	    print(f"\n[{name}] Applying 3-sigma jump threshold...")
   458	    daily = apply_jump_threshold(daily_raw)
   459	
   460	    # Jump descriptives after thresholding
   461	    j_share_raw = float((daily["raw_j"] / daily["rv"].clip(lower=1e-12)).mean())
   462	    j_share_thresh = float((daily["j"] / daily["rv"].clip(lower=1e-12)).mean())
   463	    frac_jump = float(daily["jump_day"].mean())
   464	
   465	    print(f"[{name}] N daily rows raw = {len(daily)}")
   466	    feat = build_har_features(daily)
   467	    print(f"[{name}] N HAR rows after warm-up = {len(feat)}")
   468	
   469	    if len(feat) < 60:
   470	        print(f"[{name}] WARNING: small sample, 70/30 split may be unstable")
   471	
   472	    rv_cols = ["rv_d", "rv_w", "rv_m"]
   473	    cj_cols = ["cv_d", "cv_w", "cv_m", "j_d", "j_w", "j_m"]
   474	
   475	    y = feat["Y"].to_numpy(dtype=float)
   476	    X_rv = feat[rv_cols].to_numpy(dtype=float)
   477	    X_cj = feat[cj_cols].to_numpy(dtype=float)
   478	
   479	    T = len(feat)
   480	    n_train = int(np.floor(T * 0.7))
   481	    n_features_cj = 6
   482	    if n_train <= n_features_cj + 5 or (T - n_train) < 5:
   483	        return {
   484	            "asset": name,
   485	            "error": f"insufficient sample: T={T}, n_train={n_train}, n_test={T-n_train}",
   486	            "n_har_rows": int(T),
   487	            "note": "60d yfinance 5-min cap is the bottleneck. Use Polygon/IEX for longer US 5-min history.",
   488	        }
   489	    idx_train = np.arange(n_train)
   490	    idx_test = np.arange(n_train, T)
   491	
   492	    beta_rv = fit_ols(X_rv[idx_train], y[idx_train])
   493	    beta_cj = fit_ols(X_cj[idx_train], y[idx_train])
   494	
   495	    yhat_rv_te = predict_ols(beta_rv, X_rv[idx_test])
   496	    yhat_cj_te = predict_ols(beta_cj, X_cj[idx_test])
   497	
   498	    # ABD3: Target is log(RV_t); to compute QLIKE we need actual RV_t (not log)
   499	    # feat["Y"] = log(RV_t), so actual RV_t = exp(Y)
   500	    y_test = y[idx_test]
   501	    rv_actual = np.exp(y_test)               # actual RV_t (level)
   502	    rv_hat_rv = np.exp(yhat_rv_te)           # HAR-RV forecast (level)
   503	    rv_hat_cj = np.exp(yhat_cj_te)          # HAR-CJ forecast (level)
   504	
   505	    # ABD2 Fix: QLIKE pointwise losses (Patton 2011)
   506	    qlike_rv = qlike_pointwise(rv_actual, rv_hat_rv)
   507	    qlike_cj = qlike_pointwise(rv_actual, rv_hat_cj)
   508	
   509	    mean_qlike_rv = float(np.nanmean(qlike_rv))
   510	    mean_qlike_cj = float(np.nanmean(qlike_cj))
   511	
   512	    # ABD2 Fix: HAC DM test with QLIKE losses
   513	    # Positive t-stat => HAR-RV loss > HAR-CJ loss => HAR-CJ preferred
   514	    dm_t, dm_p = _dm_test_hac(qlike_rv, qlike_cj, h=1)
   515	
   516	    # MSE for reference (not primary criterion)
   517	    e_rv = y_test - yhat_rv_te
   518	    e_cj = y_test - yhat_cj_te
   519	    mse_rv = float((e_rv ** 2).mean())
   520	    mse_cj = float((e_cj ** 2).mean())
   521	
   522	    def _r2(y_, yhat_):
   523	        ss_res = float(((y_ - yhat_) ** 2).sum())
   524	        ss_tot = float(((y_ - y_.mean()) ** 2).sum())
   525	        return 1.0 - ss_res / ss_tot if ss_tot > 0 else float("nan")
   526	
   527	    r2_rv_is = _r2(y[idx_train], predict_ols(beta_rv, X_rv[idx_train]))
   528	    r2_cj_is = _r2(y[idx_train], predict_ols(beta_cj, X_cj[idx_train]))
   529	    r2_rv_oos = _r2(y_test, yhat_rv_te)
   530	    r2_cj_oos = _r2(y_test, yhat_cj_te)
   531	
   532	    pass_dm = (not np.isnan(dm_t)) and abs(dm_t) > 3.0
