   402	def bootstrap_mse_diff_ci(loss_a: np.ndarray, loss_b: np.ndarray,
   403	                          n_boot: int = 500, seed: int = SEED,
   404	                          block_len: int = 10
   405	                          ) -> Tuple[float, float, float]:
   406	    """Circular block bootstrap CI on (MSE_a - MSE_b).
   407	
   408	    Stationary circular block bootstrap (Politis & Romano 1994) with
   409	    block_len=10 for daily data — preserves serial autocorrelation of
   410	    forecast loss differentials. Positive => a worse, b preferred.
   411	    Returns (point_diff, lo95, hi95).
   412	    """
   413	    rng = np.random.default_rng(seed)
   414	    a = np.asarray(loss_a, dtype=float)
   415	    b = np.asarray(loss_b, dtype=float)
   416	    T = len(a)
   417	    point = float(a.mean() - b.mean())
   418	    n_blocks = int(np.ceil(T / block_len))
   419	    diffs = np.empty(n_boot)
   420	    for k in range(n_boot):
   421	        starts = rng.integers(0, T, n_blocks)
   422	        idx = np.concatenate([
   423	            np.arange(s, s + block_len) % T for s in starts
   424	        ])[:T]
   425	        diffs[k] = a[idx].mean() - b[idx].mean()
