   434	
   435	def qlike(actual, forecast):
   436	    """
   437	    QLIKE loss: actual/forecast - log(actual/forecast) - 1
   438	    Patton (2011): proxy-robust when using r^2 as proxy for sigma^2.
   439	    """
   440	    a = np.asarray(actual, dtype=np.float64)
   441	    f = np.asarray(forecast, dtype=np.float64)
   442	    valid = np.isfinite(a) & np.isfinite(f) & (a > 0) & (f > 0)
   443	    a, f = a[valid], f[valid]
   444	    if len(a) == 0:
   445	        return np.nan
   446	    return float(np.mean(a / f - np.log(a / f) - 1))
   447	
   448	
   449	def mse(actual, forecast):
   450	    """Mean Squared Error."""
   451	    a = np.asarray(actual, dtype=np.float64)
   452	    f = np.asarray(forecast, dtype=np.float64)
   453	    valid = np.isfinite(a) & np.isfinite(f)
   454	    a, f = a[valid], f[valid]
   455	    if len(a) == 0:
   456	        return np.nan
   457	    return float(np.mean((a - f) ** 2))
   458	
   459	
   460	def mae(actual, forecast):
   461	    """Mean Absolute Error."""
   462	    a = np.asarray(actual, dtype=np.float64)
   463	    f = np.asarray(forecast, dtype=np.float64)
   464	    valid = np.isfinite(a) & np.isfinite(f)
   465	    a, f = a[valid], f[valid]
   466	    if len(a) == 0:
   467	        return np.nan
   468	    return float(np.mean(np.abs(a - f)))
