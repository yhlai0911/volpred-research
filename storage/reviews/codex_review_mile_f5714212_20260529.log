   332	def compute_scores(strategies, profile):
   333	    """
   334	    Compute weighted scores for each strategy given an investor profile.
   335	
   336	    Score = w1 * norm(Sharpe) + w2 * norm(-MDD) + w3 * norm(-Complexity) + w4 * capital_eligible
   337	
   338	    Returns list of (strategy_key, score, details) sorted by score descending.
   339	    """
   340	    weights = profile["weights"]
   341	    constraints = profile["constraints"]
   342	
   343	    # Collect eligible strategies (apply hard constraints)
   344	    eligible_keys = []
   345	    hard_filtered = {}
   346	    for key, strat in strategies.items():
   347	        # Market access check
   348	        if strat["market"] not in constraints["market_access"]:
   349	            hard_filtered[key] = f"No {strat['market']} market access"
   350	            continue
   351	        # Capital check
   352	        if strat["min_capital_usd"] > constraints["available_capital_usd"]:
   353	            hard_filtered[key] = f"Requires ${strat['min_capital_usd']:,} (has ${constraints['available_capital_usd']:,})"
   354	            continue
   355	        eligible_keys.append(key)
   356	
   357	    if not eligible_keys:
   358	        return [], hard_filtered
   359	
   360	    # Extract raw values for eligible strategies
   361	    sharpe_vals = [strategies[k]["live_sharpe"] for k in eligible_keys]
   362	    mdd_vals = [abs(strategies[k]["mdd_pct"]) for k in eligible_keys]  # abs so higher = worse
   363	    complexity_vals = [strategies[k]["complexity"] for k in eligible_keys]
   364	    capital_vals = [
   365	        1.0 if strategies[k]["min_capital_usd"] <= constraints["available_capital_usd"] * 0.5 else 0.7
   366	        for k in eligible_keys
   367	    ]  # Bonus if capital is well above minimum
   368	
   369	    # Normalize
   370	    norm_sharpe = normalize(sharpe_vals, higher_is_better=True)
   371	    norm_mdd_safety = normalize(mdd_vals, higher_is_better=False)  # Lower MDD = higher score
   372	    norm_simplicity = normalize(complexity_vals, higher_is_better=False)  # Lower complexity = higher score
   373	    norm_capital = np.array(capital_vals)
   374	
   375	    # Apply soft penalties
   376	    results = []
   377	    for i, key in enumerate(eligible_keys):
   378	        strat = strategies[key]
   379	        base_score = (
   380	            weights["sharpe"] * norm_sharpe[i]
   381	            + weights["mdd_safety"] * norm_mdd_safety[i]
   382	            + weights["simplicity"] * norm_simplicity[i]
   383	            + weights["capital_eligible"] * norm_capital[i]
   384	        )
   385	
   386	        # Soft penalties
   387	        penalty = 0.0
   388	        penalty_reasons = []
   389	
   390	        # MDD exceeds tolerance (soft penalty, proportional to excess)
   391	        if strat["mdd_pct"] < constraints["max_mdd_tolerance_pct"]:
   392	            excess = abs(strat["mdd_pct"]) - abs(constraints["max_mdd_tolerance_pct"])
   393	            penalty += 0.15 * (excess / 10.0)  # 1.5% penalty per 10% excess MDD
   394	            penalty_reasons.append(f"MDD {strat['mdd_pct']:.1f}% exceeds tolerance {constraints['max_mdd_tolerance_pct']:.1f}%")
   395	
   396	        # Complexity exceeds preference (soft penalty)
   397	        if strat["complexity"] > constraints["max_complexity"]:
   398	            penalty += 0.10 * (strat["complexity"] - constraints["max_complexity"])
   399	            penalty_reasons.append(f"Complexity {strat['complexity']} > preference {constraints['max_complexity']}")
   400	
   401	        # Low rebalance preference penalty
   402	        if constraints.get("prefers_low_rebalance") and strat["rebalance_freq"] == "daily":
