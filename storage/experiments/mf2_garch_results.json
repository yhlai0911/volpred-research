  "model": "MF2-GARCH (Conrad & Engle 2025 style)",
  "description": "Two-component multiplicative GARCH: σ²_t = τ_t × g_t. τ_t = exp(ω + θ × log(MA_k(r²))), g_t = GJR-GARCH on demeaned returns. Tested 5 long-run τ variants (MA22, MA63, MA126, EMA, dual) against GJR-GARCH(1,1) baseline.",
  "specification": {
    "long_run_variants": {
      "ma22": "τ_t = exp(ω + θ × log(MA(22) of r²))",
      "ma63": "τ_t = exp(ω + θ × log(MA(63) of r²))",
      "ma126": "τ_t = exp(ω + θ × log(MA(126) of r²))",
      "ema": "τ_t = exp(ω + θ × log(EMA(λ=0.97) of r²))",
      "dual": "τ_t = exp(ω + θ₁ × log(MA22) + θ₂ × log(MA126))"
    },
    "short_run": "g_t = (1-α-β-γ/2) + (α+γ·I_{r<0})·(r²/τ) + β·g_{t-1}",
    "total": "σ²_t = τ_t × g_t"
  },
  "benchmark": "GJR-GARCH(1,1)",
