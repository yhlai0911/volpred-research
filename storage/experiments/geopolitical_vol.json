  "experiment_id": "geopolitical_vol_20260321",
  "title": "Geopolitical Risk Index → Volatility Prediction",
  "model": "GPR proxies (gold/oil momentum z-scores) + VIX regression",
  "description": "Tests whether geopolitical risk proxies (GLD 5-day return z-score, USO 5-day return z-score, GLD-SPY divergence) predict financial volatility beyond what VIX captures. Includes incremental R² tests, Granger causality, event studies (Crimea, Trade War, Iran, Ukraine, Israel), VT strategy overlays, cross-asset GPR sensitivity, and regime-conditional analysis.",
  "hypothesis": "Geopolitical risk (proxied by gold/oil momentum) contains forward-looking volatility information not captured by VIX.",
  "direction": "面向 G: 地緣政治風險",
  "attribution": "[提出: 用戶, 執行: Claude]",
