   343	# --------------------------------------------------------------------------- #
   344	# HAR features with explicit lagging
   345	# --------------------------------------------------------------------------- #
   346	
   347	def build_har_design(md: MarketData) -> Tuple[pd.DataFrame, Dict]:
   348	    """Build the log-HAR design matrix.
   349	
   350	    Target      y_t   = log RV_t
   351	    Regressors  x_t   = [1, log RV_{t-1}, log RV^{(5)}_{t-1}, log RV^{(22)}_{t-1}]
   352	
   353	    Corsi (2009) aggregates RV in LEVELS over the last 5 / 22 days, then (in the
   354	    log specification) takes logs of those averages.
   355	
   356	    LOOKAHEAD CONTROL: every regressor is built from the RV series and then
   357	    explicitly ``.shift(1)``-ed, so row t contains only information realized on
   358	    or before t-1.  The target at row t is RV_t itself.  This is the single
   359	    place where the lag is applied; nothing downstream re-aligns.
   360	    """
   361	    rv = pd.Series(md.rv, index=pd.DatetimeIndex(md.dates), name="rv")
   362	
   363	    # Censored (limit-locked) sessions are NaN everywhere they enter, so they
   364	    # can neither be a target nor contaminate a log feature or a rolling mean.
   365	    rv_valid = rv.where(np.isfinite(rv) & (rv > 0))
   366	
   367	    rv_d = rv_valid
   368	    rv_w = rv_valid.rolling(LAG_W, min_periods=LAG_W).mean()
   369	    rv_m = rv_valid.rolling(LAG_M, min_periods=LAG_M).mean()
   370	
   371	    # --- the lag: signals are strictly information available at t-1 ---------
   372	    signal_d = np.log(rv_d).shift(1)
   373	    signal_w = np.log(rv_w).shift(1)
   374	    signal_m = np.log(rv_m).shift(1)
   375	
   376	    design = pd.DataFrame(
   377	        {
   378	            "y": np.log(rv_valid),          # target: log RV_t (contemporaneous, by definition)
   379	            "rv_actual": rv_valid,          # level target for QLIKE/MSE
   380	            "x_const": 1.0,
   381	            "x_d": signal_d,
   382	            "x_w": signal_w,
   383	            "x_m": signal_m,
   384	        }
   385	    )
   386	
   387	    meta = {
   388	        "lag_convention": "regressors = .shift(1) of log RV aggregates; target = log RV_t",
   389	        "weekly_definition": "log of the level-average of RV over the last 5 sessions",
   390	        "monthly_definition": "log of the level-average of RV over the last 22 sessions",
   391	        "rolling_min_periods": {"weekly": LAG_W, "monthly": LAG_M},
   392	    }
   393	    return design, meta
   394	
   395	
   396	def build_common_ledger(design: pd.DataFrame) -> Tuple[np.ndarray, Dict]:
   397	    """One ledger shared by every model.
   398	
   399	    An origin is admissible only if the target and ALL regressors are finite.
   400	    Because all four models consume the identical regressor set, the admissible
   401	    set is identical across models by construction; we still record per-reason
   402	    counts so any loss of origins is auditable.
   403	    """
   404	    need = ["y", "rv_actual", "x_d", "x_w", "x_m"]
   405	    finite = design[need].apply(lambda c: np.isfinite(c.to_numpy(dtype=float)))
   406	    admissible = finite.all(axis=1).to_numpy()
   407	
   408	    reasons = {
   409	        "target_invalid": int((~finite["y"]).sum()),
   410	        "daily_feature_invalid": int((~finite["x_d"]).sum()),
   411	        "weekly_feature_invalid": int((~finite["x_w"]).sum()),
   412	        "monthly_feature_invalid": int((~finite["x_m"]).sum()),
   413	    }
   414	    dropped_dates = [str(d.date()) for d in design.index[~admissible]]
   415	    info = {
   416	        "n_rows": int(len(design)),
   417	        "n_admissible": int(admissible.sum()),
   418	        "n_dropped": int((~admissible).sum()),
   419	        "drop_reasons_nonexclusive": reasons,
   420	        "dropped_dates_head": dropped_dates[:30],
   421	        "dropped_dates_tail": dropped_dates[-10:],
   422	        "identical_across_models": True,
   423	        "identical_across_models_why": (
   424	            "all four models consume the same [const, x_d, x_w, x_m] regressors and the same "
   425	            "log RV target, so no model can silently drop an origin the others keep"
   426	        ),
   427	    }
   428	    return admissible, info
   429	
