   626	def test_holm_bonferroni_step_down():
   627	    out = K.holm_bonferroni({"a": 0.004, "b": 0.02, "c": 0.9}, 0.05)
   628	    # rank 1: 0.004 <= 0.05/3 -> reject;  rank 2: 0.020 <= 0.05/2 -> reject
   629	    assert out["a"]["reject"] is True and out["a"]["holm_threshold"] == pytest.approx(0.05 / 3)
   630	    assert out["b"]["reject"] is True and out["b"]["holm_threshold"] == pytest.approx(0.05 / 2)
   631	    assert out["c"]["reject"] is False
   632	
   633	    # step-down: once a rank fails, everything below it fails too, even if a
   634	    # later raw p-value would clear its own threshold on its own.
   635	    stepped = K.holm_bonferroni({"a": 0.03, "b": 0.04}, 0.05)
   636	    assert stepped["a"]["reject"] is False, "0.03 > 0.05/2"
   637	    assert stepped["b"]["reject"] is False, (
   638	        "0.04 <= 0.05/1 in isolation, but Holm stops at the first failure"
   639	    )
