  1030	def _three_model_market(t_stat: float, qlike_margin: float = -0.002):
  1031	    """All three models present, so the Holm family is the real m = 3."""
  1032	    rows = {m: _nested_row(model=m, t_stat=t_stat, qlike_margin=qlike_margin)
  1033	            for m in K.STATE_SPACE_MODELS}
  1034	    for row in rows.values():                     # claim Holm passed, for all of them
  1035	        row["holm"] = {"reject": True, "p_raw": row["p_value_one_sided"],
  1036	                       "rank": 1, "holm_threshold": 0.05 / 3}
  1037	    regime = {m: qlike_margin for m in K.STATE_SPACE_MODELS}
  1038	    return {
  1039	        "status": "OK",
  1040	        "mean_qlike": {"HAR_FIXED": 0.161, **{m: 0.159 for m in K.STATE_SPACE_MODELS}},
  1041	        "cw_vs_own_restriction_primary": rows,
  1042	        "mcs_qlike": {"superior_set": ["HAR_FIXED", *K.STATE_SPACE_MODELS]},
  1043	        "regime_breakdown": {
  1044	            "high": {"n": 900, "qlike_vs_own_restriction": dict(regime)},
  1045	            "low": {"n": 900, "qlike_vs_own_restriction": dict(regime)},
  1046	        },
  1047	    }
  1048	
