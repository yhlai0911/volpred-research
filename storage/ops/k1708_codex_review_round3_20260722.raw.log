   453	def _nested_row(model: str = "HAR_KF_MLE", t_stat: float = 4.0,
   454	                qlike_margin: float = -0.002) -> dict:
   455	    """A CW row that matches NESTING_REGISTRY, built FROM the registry.
   456	
   457	    Reading the identity fields out of the registry rather than retyping them
   458	    means the fixture cannot drift away from what the verdict checks -- and it
   459	    keeps the mislabelling tests honest, because they have to mutate a value
   460	    that was correct a line earlier.
   461	    """
   462	    spec = K.NESTING_REGISTRY[model]
   463	    p = _one_sided_p(t_stat)
   464	    return {
   465	        "t_stat": t_stat,
   466	        "p_value_one_sided": p,
   467	        "reject_at_5pct": t_stat > 1.645,
   468	        "control_series": spec["control"],
   469	        "restriction": spec["restriction"],
   470	        "forecast_map": spec["forecast_map"],
   471	        "exact_on_scored_object": spec["exact_on_scored_object"],
   472	        "qlike_vs_control": qlike_margin,
   473	        "holm": {"p_raw": p, "rank": 1, "holm_threshold": 0.05 / 3,
   474	                 "reject": p <= 0.05 / 3},
   475	    }
