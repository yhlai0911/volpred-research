   240	def test_filter_survives_burnin_rows_with_nan_regressors_and_finite_y():
   241	    """Regression: guarding the update on isfinite(y) alone is not enough.
   242	
   243	    On the lag burn-in rows y is finite while the regressors are NaN. The old
   244	    code took the update branch there, so the Kalman gain was NaN, beta was
   245	    poisoned on the very first row, and every later forecast was NaN -- both
   246	    state-space models were silently destroyed end to end.
   247	    """
   248	    X, y = _burnin_block()
   249	    assert np.isfinite(y[0]), "probe is void unless y is finite on a burn-in row"
   250	    assert not np.all(np.isfinite(X[0])), "probe is void unless X has NaN on that row"
   251	
   252	    beta0 = np.zeros(4)
   253	    P0 = np.eye(4) * 0.1
   254	    pm, pv, ll = K.kalman_filter_har(X, y, beta0, P0, 0.25, Q=np.diag(np.full(4, 1e-6)))
   255	
   256	    assert np.isfinite(ll), "log-likelihood is undefined -> the filter is poisoned"
   257	    n_ok = int(np.isfinite(pm).sum())
   258	    assert n_ok > 0.7 * len(pm), f"only {n_ok}/{len(pm)} finite forecasts"
   259	    # burn-in rows must yield no forecast rather than a fabricated one
   260	    assert not np.isfinite(pm[0])
