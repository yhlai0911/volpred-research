   748	def test_nesting_controls_are_produced_by_the_declared_forecast_map():
   749	    """Round-2 BLOCKER-4b: the registry test must CALL the generator, not read its label.
   750	
   751	    The previous version asserted ``spec["forecast_map"] == "forecast_kalman"``
   752	    and a boolean.  A string is exactly what survives the mistake it is meant to
   753	    catch -- the 2026-07-17 defect was a control built by ``forecast_ols_block``
   754	    while the registry said otherwise, and no string comparison could have seen
   755	    it.  So this runs the production generator and then, independently,
   756	    dereferences the registry's ``forecast_map`` NAME and applies the registry's
   757	    restriction through it.  The two must agree exactly.
   758	    """
   759	    X, y, origins, refit_points, fitted = _control_inputs()
   760	    _, controls = K.build_nesting_controls(
   761	        X, y, origins, refit_points,
   762	        fitted["HAR_KF_DISC"], fitted["HAR_KF_MLE"], fitted["HAR_S_BM"], jensen=True,
   763	    )
   764	    assert set(controls) == {s["control"] for s in K.NESTING_REGISTRY.values()}
   765	
   766	    for model, spec in K.NESTING_REGISTRY.items():
   767	        control = spec["control"]
   768	        forecaster = getattr(K, spec["forecast_map"])  # the NAME must resolve to the map
   769	        patch = K.RESTRICTION_PATCH[control]
   770	        hyper = {rp: patch(fitted[model][rp]) for rp in refit_points}
   771	        by_origin = {int(i): K.hyper_for(int(i), hyper) for i in origins}
   772	
   773	        if spec["forecast_map"] == "forecast_kalman":
   774	            mu, var = forecaster(X, y, origins, K.STATE_INIT_ROWS, by_origin)
   775	        else:
   776	            mu, var = forecaster(X, y, origins, by_origin)
   777	        expected = K.lognormal_mean(mu, var, True)
   778	
   779	        got = controls[control][origins]
   780	        want = expected[origins]
   781	        assert np.all(np.isfinite(got) & (got > 0)), f"{control} is not a usable series"
   782	        np.testing.assert_array_equal(
   783	            got, want,
   784	            err_msg=(f"{control} is not what {spec['forecast_map']} produces at "
   785	                     f"{spec['restriction']} -- the registry's label and the production "
   786	                     "generator have come apart"),
   787	        )
