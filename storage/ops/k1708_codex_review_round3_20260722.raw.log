   222	# --------------------------------------------------------------------------- #
   223	# Data: US availability audit (honest FAIL_NO_DATA rather than an r^2 stand-in)
   224	# --------------------------------------------------------------------------- #
   225	
   226	def audit_us_intraday(intraday_dir: Path) -> Dict:
   227	    """Audit local US intraday bytes for SPY/QQQ.
   228	
   229	    The brief forbids substituting squared daily returns for realized variance.
   230	    yfinance only serves ~60 calendar days of 5-minute bars, so the local
   231	    archive is a rolling window, not a history.  We report exactly what exists.
   232	    """
   233	    out: Dict[str, Dict] = {}
   234	    required = TRAIN_MIN + LAG_M + MIN_OOS_ORIGINS
   235	    for ticker in ("SPY", "QQQ"):
   236	        files = sorted(intraday_dir.glob(f"{ticker}_5min_*.csv"))
   237	        dates = sorted(f.stem.replace(f"{ticker}_5min_", "") for f in files)
   238	        n = len(dates)
   239	        out[ticker] = {
   240	            "n_local_intraday_days": n,
   241	            "first_date": dates[0] if dates else None,
   242	            "last_date": dates[-1] if dates else None,
   243	            "required_days_for_design": required,
   244	            "status": "OK" if n >= required else "FAIL_NO_DATA",
   245	            "reason": (
   246	                None
   247	                if n >= required
   248	                else (
   249	                    f"only {n} local 5-min session files; design needs >= {required} "
   250	                    f"({LAG_M} lag burn-in + {TRAIN_MIN} training + {MIN_OOS_ORIGINS} OOS origins). "
   251	                    "yfinance retains ~60 days of intraday bars, so this cannot be backfilled "
   252	                    "from the current source. Squared daily returns are NOT an admissible "
   253	                    "substitute for a 5-min RV target (see README)."
   254	                )
   255	            ),
   256	        }
   257	    return out
