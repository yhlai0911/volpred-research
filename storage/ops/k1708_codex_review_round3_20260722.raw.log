+def registry_identity_violations(name: str, cw: Dict) -> List[str]:
+    """Does this CW row actually describe the comparison the registry declares?
+
+    BLOCKER-2 of the 2026-07-19 round-2 review: the previous version read
+    ``exact_on_scored_object`` and ``holm.reject`` straight off the payload, so
+    pasting those two labels onto ANY comparison bought a CONDITIONAL_PASS --
+    the reviewer demonstrated it by relabelling the descriptive HAR_FIXED row
+    and watching it qualify.  A field the verdict trusts but never checks is not
+    evidence, it is a declaration; and a declaration is exactly what an
+    overclaiming edit produces.  So identity is re-derived from
+    ``NESTING_REGISTRY`` here, and the caller re-derives Holm from the p-values,
+    rather than either being taken on the payload's word.
+
+    Returns the list of reasons this row may not become inference; empty list
+    means the row is what it says it is.
+    """
+    spec = NESTING_REGISTRY.get(name)
+    if spec is None:
+        return [f"{name} has no NESTING_REGISTRY entry, so no comparison of it can be inference"]
+
+    bad: List[str] = []
+    for field_name, want in (("control_series", spec["control"]),
+                             ("restriction", spec["restriction"]),
+                             ("forecast_map", spec["forecast_map"])):
+        got = cw.get(field_name)
+        if got != want:
+            bad.append(f"{field_name}={got!r}, registry declares {want!r}")
+
+    if bool(cw.get("exact_on_scored_object")) != bool(spec["exact_on_scored_object"]):
+        bad.append(
+            f"exact_on_scored_object={cw.get('exact_on_scored_object')!r} contradicts the "
+            f"registry ({spec['exact_on_scored_object']!r})"
+        )
+
+    inconsistency = t_p_inconsistency(cw)
+    if inconsistency:
+        bad.append(inconsistency)
+    return bad
+
+
+def t_p_inconsistency(cw: Dict) -> Optional[str]:
+    """The one-sided p must be the one this t implies, or the row is not internally honest.
+
+    ``clark_west_test`` sets ``p = 1 - Phi(t)``.  Without this check a row could
+    carry a t below the bar and a p small enough to sail through Holm, or the
+    reverse -- two numbers that cannot both have come from the same test.
+    """
+    from scipy import stats as sps
+
+    t = cw.get("t_stat")
+    p = cw.get("p_value_one_sided")
+    if t is None or p is None:
+        return "row is missing t_stat or p_value_one_sided"
+    expected = float(1.0 - sps.norm.cdf(float(t)))
+    if not np.isclose(float(p), expected, rtol=1e-6, atol=1e-12):
+        return (f"p_value_one_sided={float(p):.6g} but 1-Phi(t={float(t):.6g})={expected:.6g}; "
+                "t and p did not come from the same test")
+    return None
+
