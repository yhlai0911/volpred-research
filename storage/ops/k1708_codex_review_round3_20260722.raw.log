  1366	        patch = RESTRICTION_PATCH[control]
  1367	        hyper = {rp: patch(fitted[rp]) for rp in refit_points}
  1368	        by_origin = {int(i): hyper_for(int(i), hyper) for i in origins}
  1369	        mu, var = forecaster(X, y, origins, STATE_INIT_ROWS, by_origin)
  1370	        return lognormal_mean(mu, var, jensen)
  1371	
