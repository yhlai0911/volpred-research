  1358	    # refresh parameters every REFIT_EVERY days because a daily Kalman MLE is
  1359	    # unaffordable; HAR_FIXED refreshes every origin. That gap is compute budget,
  1360	    # not mechanism, and it does not cancel out. Price it -- but separately.
  1361	    fixed_block_hyper = {rp: {"refit_origin": rp} for rp in refit_points}
  1362	    fb_by_origin = {int(i): hyper_for(int(i), fixed_block_hyper) for i in origins}
  1363	    mu_fb, var_fb = forecast_ols_block(X, y, origins, fb_by_origin)
  1364	
