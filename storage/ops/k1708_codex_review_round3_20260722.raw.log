   173	def test_kalman_forecast_never_uses_its_own_observation():
   174	    """pred_mean[t] must be invariant to y[t]: the state updates only after the
   175	    one-step forecast for t has been recorded."""
   176	    rng = np.random.default_rng(3)
   177	    n = 300
   178	    X = np.column_stack([np.ones(n), rng.normal(size=(n, 3))])
   179	    y = X @ np.array([0.1, 0.5, 0.2, 0.2]) + rng.normal(0, 0.3, n)
   180	    b0, P0 = np.zeros(4), np.eye(4) * 0.1
   181	
   182	    pm_a, pv_a, _ = K.kalman_filter_har(X, y, b0, P0, 0.09, discount=0.98)
   183	
   184	    t = 150
   185	    y2 = y.copy()
   186	    y2[t] += 10.0
   187	    pm_b, pv_b, _ = K.kalman_filter_har(X, y2, b0, P0, 0.09, discount=0.98)
   188	
   189	    assert pm_a[t] == pytest.approx(pm_b[t], rel=1e-12), "forecast for t moved when y[t] moved"
   190	    assert pv_a[t] == pytest.approx(pv_b[t], rel=1e-12)
   191	    # but the NEXT forecast must react, else the filter is not learning at all
   192	    assert pm_a[t + 1] != pytest.approx(pm_b[t + 1], rel=1e-9)
