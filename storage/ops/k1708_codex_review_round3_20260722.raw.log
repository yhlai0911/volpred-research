  2230	def t_p_inconsistency(cw: Dict) -> Optional[str]:
  2231	    """The one-sided p must be the one this t implies, or the row is not internally honest.
  2232	
  2233	    ``clark_west_test`` sets ``p = 1 - Phi(t)``.  Without this check a row could
  2234	    carry a t below the bar and a p small enough to sail through Holm, or the
  2235	    reverse -- two numbers that cannot both have come from the same test.
  2236	    """
  2237	    from scipy import stats as sps
  2238	
  2239	    t = cw.get("t_stat")
  2240	    p = cw.get("p_value_one_sided")
  2241	    if t is None or p is None:
  2242	        return "row is missing t_stat or p_value_one_sided"
  2243	    expected = float(1.0 - sps.norm.cdf(float(t)))
  2244	    if not np.isclose(float(p), expected, rtol=1e-6, atol=1e-12):
  2245	        return (f"p_value_one_sided={float(p):.6g} but 1-Phi(t={float(t):.6g})={expected:.6g}; "
  2246	                "t and p did not come from the same test")
  2247	    return None
  2248	
