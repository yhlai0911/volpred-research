  1094	def test_bar_move_is_a_subset_when_the_comparator_is_held_fixed():
  1095	    """The half of the claim that IS provable: raising the bar can only shrink the set."""
  1096	    rng = np.random.default_rng(7)
  1097	    for _ in range(200):
  1098	        t_stats = {m: float(v) for m, v in zip(K.STATE_SPACE_MODELS, rng.normal(1.5, 2.5, 3))}
  1099	        mkt = {"cw_vs_fixed_descriptive_not_nested":
  1100	               {m: {"t_stat": t} for m, t in t_stats.items()}}
  1101	        audit = K.gate_transition_audit(mkt)["cw_vs_HAR_FIXED"]
  1102	        assert audit["bar_move_is_a_subset"], t_stats
  1103	
