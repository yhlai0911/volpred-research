   112	def test_clark_west_sign_convention():
   113	    """Positive CW t must mean evidence FOR the large (state-space) model."""
   114	    rng = np.random.default_rng(42)
   115	    n = 2000
   116	    truth = rng.normal(10, 1, n)
   117	    extra = rng.normal(0, 1, n)
   118	    actual = truth + extra + rng.normal(0, 0.5, n)
   119	    f_small = truth
   120	    f_large = truth + extra + rng.normal(0, 0.2, n)  # genuinely better
   121	
   122	    res = K.clark_west_test(actual, f_small, f_large)
   123	    assert res["t_stat"] > 1.645
   124	    assert res["reject_at_5pct"] is True
   125	    assert res["direction"] == "large_model_better"
   126	
