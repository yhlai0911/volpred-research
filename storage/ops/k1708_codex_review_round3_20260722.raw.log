   345	def test_kf_mle_params_are_optimal_for_the_filter_that_forecasts():
   346	    """Estimation and production must be the same filter, not two similar ones.
   347	
   348	    An earlier revision estimated (Q, sigma2) from a filter initialised at the refit
   349	    origin, then forecast with a filter initialised hundreds of rows earlier. Both
   350	    are past-only, so nothing looked wrong -- but the reported likelihood, and the
   351	    parameters maximising it, belonged to a recursion that never produced a forecast.
   352	    Replaying the stored parameters through the production filter moved the
   353	    log-likelihood by ~1.05 and that origin's mean forecast by 0.0024 log units.
   354	
   355	    The pin is the likelihood: what the MLE reports must be what the forecaster runs.
   356	    """
   357	    X, y, actual = _synthetic_design()
   358	    rp, init_upto = 800, K.STATE_INIT_ROWS
   359	    _, _, mle, _, info = K.select_hypers_at_refit(X, y, actual, rp, init_upto)
   360	
   361	    # rebuild the prior exactly the way forecast_kalman does: from the RETURNED sigma2
   362	    beta0, XtX_inv, _ = K._init_block(X, y, init_upto)
   363	    s2 = mle["sigma2"]
   364	    _, _, ll_production = K.kalman_filter_har(
   365	        X[:rp], y[:rp], beta0, s2 * XtX_inv, s2, Q=mle["Q"], start=init_upto
   366	    )
   367	
   368	    assert ll_production == pytest.approx(info["kf_mle"]["loglik"], rel=1e-9), (
   369	        "the reported likelihood is not the production filter's -> the model that was "
   370	        "estimated and the model that forecasts are different models"
   371	    )
