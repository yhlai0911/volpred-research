   263	def test_kalman_mle_scale_ignores_nonfinite_rows():
   264	    """Regression: the MLE's OLS scale must be fit on jointly-finite rows only.
   265	
   266	    Handing it the burn-in made X'X all-NaN -> sigma2_ols NaN -> math.log(nan)
   267	    returns nan WITHOUT raising -> every optimiser start was a NaN vector and
   268	    every likelihood evaluation hit the sentinel. It failed as 'the model does
   269	    not converge', which is the most misleading way for this to fail.
   270	    """
   271	    X, y = _burnin_block()
   272	    beta0, XtX_inv, _ = K._init_block(X, y, 150)
   273	    Q, sigma2, info = K.kalman_mle(X, y, beta0, XtX_inv, start=150)
   274	
   275	    assert np.all(np.isfinite(np.diag(Q))), "Q has non-finite entries"
   276	    assert np.isfinite(sigma2) and sigma2 > 0
   277	    assert np.isfinite(info["loglik"]), "likelihood undefined -> starts were NaN again"
