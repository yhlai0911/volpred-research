   223	def _burnin_block(n: int = 300, seed: int = 11):
   224	    """A design that reproduces the real shape: the first LAG_M rows have NaN
   225	    regressors while y is already finite."""
   226	    rng = np.random.default_rng(seed)
   227	    md = K.MarketData(
   228	        market="SYNTH",
   229	        dates=pd.date_range("2015-01-01", periods=n, freq="B").to_numpy(dtype="datetime64[D]"),
   230	        rv=np.exp(rng.normal(-9.0, 0.5, n)),
   231	        trace={},
   232	        notes={},
   233	    )
   234	    design, _ = K.build_har_design(md)
   235	    X = design[["x_const", "x_d", "x_w", "x_m"]].to_numpy(dtype=float)
   236	    y = design["y"].to_numpy(dtype=float)
   237	    return X, y
