   830	
   831	    def jitter(scale):
   832	        return actual * np.exp(rng.normal(0.0, scale, n))
   833	
   834	    forecasts = {m: jitter(0.30) for m in ("HAR_FIXED", "HAR_ROLL") + K.STATE_SPACE_MODELS}
   835	    controls = {K.NESTING_REGISTRY[m]["control"]: jitter(0.31) for m in K.STATE_SPACE_MODELS}
   836	    boundary = K.boundary_diagnostic([])
   837	
   838	    out = K.evaluate(forecasts, actual, origins, regime, benchmark="HAR_FIXED",
   839	                     n_boot=50, boundary=boundary, controls=controls)
   840	
