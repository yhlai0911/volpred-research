   374	def test_restricted_filter_reproduces_expanding_window_ols_exactly():
   375	    """discount = 1 must not be flatter than the benchmark -- it must BE it.
   376	
   377	    The whole inference design rests on the null living inside the alternative:
   378	    Clark-West is used precisely because "coefficients are constant" is a parameter
   379	    restriction of the state-space model. If the restricted filter merely resembled
   380	    expanding-window OLS, that nesting would be a statement of intent and CW would be
   381	    correcting a bias the comparison does not have.
   382	
   383	    Equality holds only because (a) the prior is conjugate to the filter -- P0 =
   384	    sigma2 (X'X)^-1 from the initialisation block, with the sigma2 the filter itself
   385	    uses -- and (b) the initialisation rows are not filtered a second time. Spend that
   386	    data twice, as filtering from row 0 under a prior fitted on early rows does, and
   387	    the posterior precision inflates, the predictive variance shrinks, and this fails.
   388	
   389	    What this does NOT prove, stated here so the test is not read as more than it is:
   390	    that HAR_KF_DISC at delta=1 equals HAR_FIXED on the LEVEL forecasts that are
   391	    actually scored. It does not, and cannot: the comparison below hands the filter's
   392	    own fixed sigma2 to the OLS side on purpose, whereas the real HAR_FIXED re-fits
   393	    sigma2 at every origin while the filter carries the refit block's. That residual
   394	    is the parameter-refresh schedule, it survives into exp(mu + var/2), and it is
   395	    measured by schedule_artifact_diagnostic rather than asserted away here.
   396	    """
   397	    X, y = _burnin_block(n=500, seed=13)
   398	    init_upto = 150
   399	    beta0, XtX_inv, s2 = K._init_block(X, y, init_upto)
   400	
   401	    pm, pv, _ = K.kalman_filter_har(X, y, beta0, s2 * XtX_inv, s2, discount=1.0, start=init_upto)
   402	
   403	    assert not np.isfinite(pm[:init_upto]).any(), (
   404	        "the filter produced forecasts inside its own prior's block -> it re-ran over data "
   405	        "that is already in P0"
   406	    )
   407	
   408	    valid = np.isfinite(y) & np.all(np.isfinite(X), axis=1)
   409	    probes = [i for i in range(init_upto + 5, len(y), 41) if valid[i]]
   410	    assert len(probes) >= 5, "probe is void without several origins to check"
   411	    for i in probes:
   412	        idx = np.where(valid[:i])[0]
   413	        beta_t, _, XtXinv_t = K.ols_fit(X[idx], y[idx])
   414	        # the filter's own fixed sigma2 on purpose: OLS re-estimates its scale daily,
   415	        # the filter carries the block's. The coefficient path is what is claimed here.
   416	        mu_o, var_o = K.ols_predict_with_var(beta_t, s2, XtXinv_t, X[i])
   417	        assert pm[i] == pytest.approx(mu_o, rel=1e-8), (
   418	            f"restricted filter is not expanding-window OLS at row {i} -> the nesting the "
   419	            "Clark-West design assumes does not hold in the code"
   420	        )
   421	        assert pv[i] == pytest.approx(var_o, rel=1e-8)
   422	
