  1050	def test_holm_cannot_bind_at_the_pre_registered_bar():
  1051	    """README 8.2 says Holm is not the binding constraint at t >= 3. Check it.
  1052	
  1053	    A claim like this in prose is where a gate quietly stops being what it says
  1054	    it is; asserting it means the README and the code cannot drift apart.
  1055	    """
  1056	    for t in np.linspace(K.GATE_T_CRITICAL, 6.0, 25):
  1057	        family = {m: _one_sided_p(float(t)) for m in K.STATE_SPACE_MODELS}
  1058	        holm = K.holm_bonferroni(family, K.GATE_FAMILY_ALPHA)
  1059	        assert all(h["reject"] for h in holm.values()), (
  1060	            f"Holm binds at t = {t}, which contradicts README 8.2"
  1061	        )
  1062	
  1063	
  1064	def test_holm_starts_biting_the_moment_the_t_bar_is_relaxed(monkeypatch):
  1065	    """The other half of the same claim: relaxing the bar cannot silently drop Holm.
  1066	
  1067	    The code comment in ``evaluate`` promises exactly this. With the bar back at
  1068	    the old 1.645, three models at t = 1.9 all clear the bar, improve QLIKE, sit
  1069	    in the MCS set and agree across regimes -- and every one of them carries a
  1070	    hand-set ``holm.reject = True``.  Only the recomputed Holm stands between
  1071	    that payload and a CONDITIONAL_PASS.
  1072	    """
  1073	    monkeypatch.setattr(K, "GATE_T_CRITICAL", 1.645)
  1074	    mkt = _three_model_market(t_stat=1.9)
  1075	
  1076	    # precondition: the bar itself is cleared, so Holm is what is left
  1077	    assert all(r["t_stat"] > 1.645 for r in mkt["cw_vs_own_restriction_primary"].values())
  1078	    # and raw p is above alpha/m but below alpha -- the window Holm exists for
  1079	    p = _one_sided_p(1.9)
  1080	    assert K.GATE_FAMILY_ALPHA / 3 < p < K.GATE_FAMILY_ALPHA
  1081	
  1082	    v = K.derive_verdict({"markets": {"TAIFEX_TX": mkt}})
  1083	    assert v["label"] == "NULL", "Holm did not bind after the t bar was relaxed"
  1084	    for name in K.STATE_SPACE_MODELS:
  1085	        conds = v["market_assessment"]["TAIFEX_TX"]["models"][name]["conditions"]
  1086	        assert conds["cw_t_at_or_above_bar"] is True
  1087	        assert conds["holm_rejects"] is False
  1088	
