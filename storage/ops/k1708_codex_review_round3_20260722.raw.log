  1191	# --------------------------------------------------------------------------- #
  1192	# Clark-West (2007) nested-model test
  1193	# --------------------------------------------------------------------------- #
  1194	
  1195	def clark_west_test(actual: np.ndarray, f_small: np.ndarray, f_large: np.ndarray) -> Dict:
  1196	    """Clark & West (2007) MSPE-adjusted test for a NESTED forecast comparison.
  1197	
  1198	    The restricted (small) model here is the fixed-coefficient HAR; the
  1199	    unrestricted (large) model is a state-space HAR whose extra hyperparameter
  1200	    (discount < 1, or Q > 0) is exactly zero under the null.  Estimating that
  1201	    zero parameter costs variance, so the large model's MSPE is biased upward
  1202	    under the null and an unadjusted comparison favours the small model even
  1203	    when the alternative is true.  CW removes that bias:
  1204	
  1205	        f_t = (a_t - f_small_t)^2 - [ (a_t - f_large_t)^2 - (f_small_t - f_large_t)^2 ]
  1206	
  1207	    and tests H0: E[f_t] <= 0 against H1: E[f_t] > 0 (one-sided, standard
  1208	    normal critical values per Clark & West 2007 section 3).
  1209	
  1210	    The HAC variance is delegated to the repo's canonical
  1211	    ``volpred.stats.model_evaluation.dm_test`` rather than re-implemented here,
  1212	    so the automatic Newey-West bandwidth is the same one every other
  1213	    comparison in this repo uses.  ``dm_test(l1, l2)`` returns
  1214	    mean(l1 - l2) / HAC_SE; feeding it the adjusted large-model loss and the
  1215	    small-model loss gives d_t = -f_t, hence t_CW = -t_dm.
  1216	
  1217	    Reference: Clark, T.E. and West, K.D. (2007), "Approximately normal tests
  1218	    for equal predictive accuracy in nested models", Journal of Econometrics
  1219	    138(1), 291-311. doi:10.1016/j.jeconom.2006.05.023.
  1220	    """
  1221	    from scipy import stats as sps
  1222	
  1223	    a = np.asarray(actual, dtype=float)
  1224	    fs = np.asarray(f_small, dtype=float)
  1225	    fl = np.asarray(f_large, dtype=float)
  1226	
  1227	    loss_small = (a - fs) ** 2
  1228	    loss_large_adjusted = (a - fl) ** 2 - (fs - fl) ** 2
  1229	
  1230	    t_dm, _ = dm_test(loss_large_adjusted, loss_small, h=1)
  1231	    t_cw = -float(t_dm)
  1232	    p_one_sided = float(1.0 - sps.norm.cdf(t_cw))
  1233	
  1234	    mspe_small = float(np.mean(loss_small))
  1235	    mspe_large = float(np.mean((a - fl) ** 2))
  1236	    adjustment = float(np.mean((fs - fl) ** 2))
  1237	
  1238	    return {
  1239	        "t_stat": t_cw,
  1240	        "p_value_one_sided": p_one_sided,
  1241	        "reject_at_5pct": bool(t_cw > 1.645),
  1242	        "reject_at_10pct": bool(t_cw > 1.282),
  1243	        "direction": "large_model_better" if t_cw > 0 else "no_evidence_for_large_model",
  1244	        "mspe_small": mspe_small,
  1245	        "mspe_large_unadjusted": mspe_large,
  1246	        "mspe_adjustment_term": adjustment,
  1247	        "loss": "squared error on the RV level (CW is defined for squared-error loss only)",
  1248	        "hac": "canonical volpred dm_test automatic Newey-West bandwidth",
  1249	        "null": "restricted fixed-coefficient HAR is the DGP (discount=1 / Q=0)",
  1250	        "alternative": "one-sided: state-space HAR has genuine predictive content",
  1251	    }
  1252	
