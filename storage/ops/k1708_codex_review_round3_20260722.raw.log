    47	def test_features_at_row_t_ignore_rv_at_t():
    48	    """The lookahead probe: change RV on day t, row t's regressors must not move.
    49	
    50	    This is the property `.shift(1)` is supposed to buy. Asserting it directly
    51	    beats trusting that the shift is still there after an edit.
    52	    """
    53	    md = _synthetic_market()
    54	    design_a, _ = K.build_har_design(md)
    55	
    56	    t = 300
    57	    rv2 = md.rv.copy()
    58	    rv2[t] *= 5.0  # a large shock on the target day only
    59	    md2 = K.MarketData(md.market, md.dates, rv2, md.trace, md.notes)
    60	    design_b, _ = K.build_har_design(md2)
    61	
    62	    for col in ("x_d", "x_w", "x_m"):
    63	        assert design_a[col].iloc[t] == pytest.approx(design_b[col].iloc[t], rel=1e-12), (
    64	            f"{col} at row t moved when RV[t] changed -> the regressor sees its own target"
    65	        )
    66	
    67	    # ... and the target itself must move, otherwise the probe proves nothing.
    68	    assert design_a["rv_actual"].iloc[t] != pytest.approx(design_b["rv_actual"].iloc[t])
