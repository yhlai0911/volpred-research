   260	# --------------------------------------------------------------------------- #
   261	# Data: TAIFEX canonical realized variance
   262	# --------------------------------------------------------------------------- #
   263	
   264	@dataclass
   265	class MarketData:
   266	    market: str
   267	    dates: np.ndarray            # datetime64[D]
   268	    rv: np.ndarray               # day-session 5-min realized variance (level)
   269	    trace: Dict
   270	    notes: Dict
   271	
   272	
   273	def load_taifex(canonical_csv: Path) -> MarketData:
   274	    """Load the canonical TAIFEX day-session 5-min RV series.
   275	
   276	    Target = ``rv_5min`` (08:45-13:45 day session only).  ``rv_total`` is NOT
   277	    used: the night session only begins 2017-05-16, so a total-session target
   278	    would carry a structural break in the middle of the sample.
   279	
   280	    The canonical file selects, for each day, the monthly TX contract with the
   281	    highest total volume (``selection_rule = same_day_max_total_volume_monthly_TX``),
   282	    which is the roll convention the repo requires (never bare TX1).
   283	    """
   284	    df = pd.read_csv(canonical_csv, parse_dates=["date"])
   285	    df = df.sort_values("date").reset_index(drop=True)
   286	
   287	    rules = sorted(df["selection_rule"].dropna().unique().tolist())
   288	    if rules != ["same_day_max_total_volume_monthly_TX"]:
   289	        raise SystemExit(
   290	            f"FAIL_METHOD: unexpected TAIFEX selection_rule {rules!r}; the brief requires "
   291	            "volume-selected active monthly TX contracts, not TX1."
   292	        )
   293	
   294	    rv = df["rv_5min"].to_numpy(dtype=float)
   295	    dates = df["date"].to_numpy(dtype="datetime64[D]")
   296	
   297	    # Zero / non-positive RV days are limit-locked sessions (price frozen at the
   298	    # daily limit, a few hundred ticks, day_return exactly 0).  RV = 0 is a
   299	    # CENSORED observation, not a calm day: log(0) is undefined and QLIKE is
   300	    # undefined.  They are excluded fail-closed, never clipped to a small
   301	    # positive number (K1704 convention).
   302	    invalid_mask = ~(np.isfinite(rv) & (rv > 0))
   303	    invalid_dates = [str(d) for d in dates[invalid_mask]]
   304	    invalid_detail = []
   305	    for d in dates[invalid_mask]:
   306	        row = df.loc[df["date"] == pd.Timestamp(str(d))].iloc[0]
   307	        invalid_detail.append(
   308	            {
   309	                "date": str(d),
   310	                "rv_5min": float(row["rv_5min"]),
   311	                "day_return": float(row["day_return"]),
   312	                "day_open": float(row["day_open"]),
   313	                "day_close": float(row["day_close"]),
   314	                "day_n_ticks": int(row["day_n_ticks"]),
   315	                "day_n_bars": int(row["day_n_bars"]),
   316	                "interpretation": "limit-locked session: price frozen, RV=0 is censoring not calm",
   317	            }
   318	        )
   319	
   320	    notes = {
   321	        "target_column": "rv_5min",
   322	        "target_definition": "TAIFEX day-session (08:45-13:45) 5-minute realized variance",
   323	        "why_not_rv_total": (
   324	            "night session starts 2017-05-16 (2227/3549 rows have has_night=True); a total-session "
   325	            "target would introduce a mid-sample structural break in the target definition"
   326	        ),
   327	        "contract_selection_rule": "same_day_max_total_volume_monthly_TX",
   328	        "n_rows_raw": int(len(df)),
   329	        "n_roll_days": int((df["is_roll"] == True).sum()),  # noqa: E712
   330	        "invalid_rv_days": invalid_dates,
   331	        "invalid_rv_detail": invalid_detail,
   332	        "invalid_rv_policy": "excluded fail-closed from target AND from log-feature construction; never clipped",
   333	    }
   334	    return MarketData(
   335	        market="TAIFEX_TX",
   336	        dates=dates,
   337	        rv=rv,
   338	        trace=trace_file(canonical_csv),
   339	        notes=notes,
   340	    )
