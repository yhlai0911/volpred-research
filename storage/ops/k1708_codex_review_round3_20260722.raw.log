   310	def test_discount_filter_gets_the_full_training_scale():
   311	    """The sigma2 reaching the OOS filter must be the full training set's.
   312	
   313	    The delta search fits its scale on data strictly before the inner validation
   314	    block, so that no candidate is ranked using a sigma2 that already saw the block
   315	    it is scored on. An earlier revision then handed that same scale to the outer
   316	    OOS filter, so the challenger forecast on a sigma2 up to 252 trading days stale
   317	    while the expanding benchmark re-fitted its own at every origin. sigma2 sets the
   318	    Kalman gain, the predictive variance, and through exp(mu + var/2) the forecast
   319	    itself -- the asymmetry lands on the exact quantity the two models are compared
   320	    by, at a QLIKE margin well under one percent.
   321	    """
   322	    X, y, actual = _synthetic_design()
   323	    rp, init_upto = 800, K.STATE_INIT_ROWS
   324	    val_start = max(K.LAG_M + 100, rp - K.INNER_VAL)
   325	
   326	    _, disc, _, _, info = K.select_hypers_at_refit(X, y, actual, rp, init_upto)
   327	
   328	    _, _, sigma2_full = K._init_block(X, y, rp)
   329	    _, _, sigma2_selection = K._init_block(X, y, val_start)
   330	    # the probe proves nothing unless the two scales genuinely differ
   331	    assert sigma2_full != pytest.approx(sigma2_selection, rel=1e-6)
   332	
   333	    assert disc["sigma2"] == pytest.approx(sigma2_full, rel=1e-12), (
   334	        "the OOS filter is not running on the full training set's scale"
   335	    )
   336	    assert disc["sigma2"] != pytest.approx(sigma2_selection, rel=1e-9), (
   337	        "the delta search's selection-only scale escaped to the OOS filter again"
   338	    )
   339	    # both must be in the log, or the asymmetry is unauditable from the results JSON
   340	    d_log = info["discount"]
   341	    assert d_log["sigma2_selection_only"] == pytest.approx(sigma2_selection, rel=1e-12)
   342	    assert d_log["sigma2_production_full_training"] == pytest.approx(sigma2_full, rel=1e-12)
   343	
