  2367	def derive_verdict(payload: Dict) -> Dict:
  2368	    """Mechanically derive the verdict from the pre-registered criteria.
  2369	
  2370	    Governing gate (2026-07-19 decision, README sections 8.1 and 10):
  2371	      statistic  Clark-West (2007), one-sided, model vs ITS OWN restriction
  2372	      bar        t >= GATE_T_CRITICAL, the pre-registered Harvey-strength value
  2373	      family     Holm-Bonferroni at GATE_FAMILY_ALPHA over the nested comparisons
  2374	      plus       point QLIKE improvement vs the same control, MCS superior-set
  2375	                 membership, and the same sign in both regimes
  2376	      per market every one of the above, on that market's own numbers
  2377	    """
  2378	    markets = payload.get("markets") or {}
  2379	    if not any(v.get("status") == "OK" for v in markets.values()):
  2380	        return {"label": "FAIL_NO_DATA", "rationale": "no market produced an admissible ledger",
  2381	                "market_assessment": {m: {"qualifies": False, "reason": v.get("status")}
  2382	                                      for m, v in markets.items()}}
  2383	
  2384	    assessment = {m: assess_market(v) for m, v in markets.items()}
  2385	    qualified = sorted(m for m, a in assessment.items() if a["qualifies"])
  2386	    admissible = sorted(m for m, v in markets.items() if v.get("status") == "OK")
  2387	
  2388	    if len(qualified) >= 2:
  2389	        label = "SUPPORTED"
  2390	    elif len(qualified) == 1:
  2391	        label = "CONDITIONAL_PASS"
  2392	    else:
  2393	        label = "NULL"
  2394	
  2395	    tw = markets.get("TAIFEX_TX", {})
  2396	    ss = set((tw.get("mcs_qlike") or {}).get("superior_set") or [])
  2397	
  2398	    return {
  2399	        "label": label,
  2400	        "qualified_markets": qualified,
  2401	        "markets_with_admissible_data": admissible,
  2402	        "market_assessment": assessment,
  2403	        "supported_unreachable": len(admissible) < 2,
  2404	        "supported_unreachable_reason": (
  2405	            "SUPPORTED requires every declared condition met in >= 2 markets; SPY and QQQ have "
  2406	            "no admissible local RV data, so at most one market can qualify."
  2407	        ) if len(admissible) < 2 else None,
  2408	        "state_space_in_mcs_superior_set": [m for m in STATE_SPACE_MODELS if m in ss],
  2409	        "governing_test": (
  2410	            f"Clark-West (2007) one-sided vs each model's OWN restriction at t >= "
  2411	            f"{GATE_T_CRITICAL}, Holm-Bonferroni at {GATE_FAMILY_ALPHA} across the nested "
  2412	            "family, plus point QLIKE improvement vs the same control, MCS superior-set "
  2413	            "membership, and consistency in both regimes"
  2414	        ),
  2415	        "criterion_substitution": (
  2416	            "The brief specified DM-HLN |t| >= 3. Ordinary DM is not valid inference under "
  2417	            "nesting -- it is biased toward the restricted model -- so the STATISTIC is "
  2418	            "substituted for Clark-West (2007), the standard nested-model correction. The BAR "
  2419	            "is not substituted: the pre-registered Harvey-strength critical value t >= 3 "
  2420	            "travels with it, and Holm-Bonferroni across the three nested comparisons is "
  2421	            "applied on top. An earlier version of this file governed on one-sided CW at 5% "
  2422	            "with no multiplicity correction, which was materially looser than what was "
  2423	            "pre-registered; that was verdict-shopping risk and has been reversed. Ordinary DM "
  2424	            "remains as a diagnostic cross-check."
  2425	        ),
  2426	        "gw_excluded_from_criterion": (
  2427	            "README section 10 originally listed GW support among the SUPPORTED conditions. GW "
  2428	            "(2006) stays valid under nesting only with a finite estimation window, and the "
  2429	            "fitted hyperparameters do not deliver one (delta = 1.0 and Q at the lower bound; "
  2430	            "see gw_boundary_diagnostic). A gate condition that cannot be validly evaluated is "
  2431	            "not a check, so it is removed from the criterion rather than rubber-stamped, and "
  2432	            "GW is reported as a diagnostic. Recorded here because dropping a declared "
  2433	            "condition silently would be the same class of defect as never implementing it."
