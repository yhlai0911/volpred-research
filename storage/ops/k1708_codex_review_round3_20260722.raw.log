 experiments/k1708/test_k1708.py       | 568 ++++++++++++++++++++++++++++++----
 4 files changed, 1281 insertions(+), 109 deletions(-)
diff --git a/experiments/k1708/K1708.py b/experiments/k1708/K1708.py
index 433e5735d..0300ed674 100644
--- a/experiments/k1708/K1708.py
+++ b/experiments/k1708/K1708.py
@@ -1308,6 +1308,99 @@ CONTROL_FOR = {m: v["control"] for m, v in NESTING_REGISTRY.items()}
 SCHEDULE_COST_CONTROL = "HAR_FIXED_BLOCK_CADENCE"
 
 
+def hyper_for(i: int, table: Dict[int, Dict]) -> Dict:
+    """The hyperparameter block in force at origin ``i``: the latest refit at or before it.
+
+    Promoted from a closure inside ``run_market`` on 2026-07-19 so that
+    ``build_nesting_controls`` -- and the tests that call it -- use the same
+    lookup the models do.  Returns the stored dict itself, not a copy: the
+    forecasters detect block boundaries by object identity (``h is not cur``).
+    """
+    keys = [k for k in sorted(table) if k <= i]
+    return table[keys[-1]]
+
+# The restriction each control imposes, as a hyperparameter patch on its model's
+# own fitted block. Kept next to the registry so that "what does this model's
+# null look like" has one answer, and so a test can apply the same patch to the
+# same map and check the production control against it.
+RESTRICTION_PATCH = {
+    "HAR_KF_DISC_AT_DELTA_ONE": lambda h: {"discount": 1.0, "sigma2": h["sigma2"]},
+    "HAR_KF_MLE_AT_Q_ZERO": lambda h: {"Q": np.zeros((N_FEATURES, N_FEATURES)),
+                                       "sigma2": h["sigma2"]},
+    "HAR_S_BM_AT_SIGMA_ETA_ZERO": lambda h: dict(h, sig2_eta=0.0),
+}
+
+
+def build_nesting_controls(
+    X: np.ndarray,
+    y: np.ndarray,
+    origins: np.ndarray,
+    refit_points: Sequence[int],
+    kf_disc_hyper: Dict,
+    kf_mle_hyper: Dict,
+    harsl_hyper: Dict,
+    jensen: bool,
+) -> Tuple[Dict[str, np.ndarray], Dict[str, np.ndarray]]:
+    """Build every control series, each through ITS OWN model's forecast map.
+
+    Extracted from ``run_market`` on 2026-07-19 (round 2) so that the tests can
+    exercise the production generator instead of asserting on the registry's
+    strings.  The round-2 review's point was exact: a test that checks
+    ``spec["forecast_map"] == "forecast_kalman"`` checks a label, and a label is
+    the one thing that survives the mistake it is supposed to catch.  It is a
+    pure extraction -- same calls, same order, no numerical change.
+
+    Returns ``(diagnostic_series, nesting_controls)``: the first is everything
+    including the schedule-cost series, the second is only what the verdict may
+    consume, i.e. exactly the controls named in ``NESTING_REGISTRY``.
+    """
+    # HAR_FIXED_BLOCK_CADENCE: not a nesting control. The state-space models
