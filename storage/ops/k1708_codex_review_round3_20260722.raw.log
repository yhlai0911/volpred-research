   128	def test_clark_west_is_correctly_sized_under_the_nested_null():
   129	    """Under H0 the large model adds pure noise: raw MSPE favours the small model,
   130	    but CW must be centred at zero and reject at about its nominal rate.
   131	
   132	    This is the whole reason CW replaces DM in this experiment -- if this test
   133	    fails, the NULL verdict would be a mechanical artifact rather than evidence.
   134	    """
   135	    rng = np.random.default_rng(7)
   136	    n, reps = 1500, 200
   137	    t_stats = []
   138	    raw_mspe_favours_small = 0
   139	    for _ in range(reps):
   140	        truth = rng.normal(10, 1, n)
   141	        actual = truth + rng.normal(0, 1, n)
   142	        f_small = truth
   143	        f_large = truth + rng.normal(0, 0.3, n)  # extra parameters that are zero under H0
   144	        res = K.clark_west_test(actual, f_small, f_large)
   145	        t_stats.append(res["t_stat"])
   146	        if res["mspe_large_unadjusted"] > res["mspe_small"]:
   147	            raw_mspe_favours_small += 1
   148	
   149	    t_stats = np.array(t_stats)
   150	    # the bias CW exists to remove: unadjusted MSPE almost always prefers the small model
   151	    assert raw_mspe_favours_small / reps > 0.9
   152	
   153	    assert abs(t_stats.mean()) < 0.15, f"CW is not centred under H0: mean t = {t_stats.mean()}"
   154	    assert 0.8 < t_stats.std() < 1.2, f"CW t is not ~N(0,1): sd = {t_stats.std()}"
   155	    rej = float(np.mean(t_stats > 1.645))
   156	    assert rej < 0.11, f"CW over-rejects under H0: {rej:.3f} at a nominal 0.05"
   157	
