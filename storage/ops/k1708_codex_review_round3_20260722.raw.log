  2539	def gate_transition_audit(mkt: Dict) -> Dict:
  2540	    """Both gates' screens, side by side, on whatever this payload actually has.
  2541	
  2542	    Replaces the withdrawn "strictly tighter" argument with a table of facts, so
  2543	    that the tightness question is checked rather than reasoned about.  It
  2544	    separates the two moves the fix made, because only one of them is orderable:
  2545	
  2546	      BAR, comparator held fixed (1.645 -> 3.0)
  2547	        Orderable, and checked per comparator below: ``{t >= 3}`` really is a
  2548	        subset of ``{t > 1.645}`` for whatever t-vector is present.  Adding the
  2549	        Holm / MCS / regime / per-market conjuncts is likewise monotone -- extra
  2550	        conjuncts can only shrink the passing set.
  2551	
  2552	      COMPARATOR (vs HAR_FIXED -> vs own restriction)
  2553	        NOT orderable, in either direction.  t_own and t_fixed are different
  2554	        statistics computed on different pairs; neither dominates the other, and
  2555	        a model can clear one while failing the other in either direction.
  2556	        ``test_comparator_move_is_not_orderable_in_either_direction`` exhibits
  2557	        both crossings explicitly.
  2558	
  2559	    So the honest summary is: the fix made the gate STRICTLY TIGHTER along the
  2560	    bar and the conjuncts, and moved it SIDEWAYS along the comparator.  "The
  2561	    corrected gate cannot turn the stored NULL positive" is NOT established by
  2562	    argument, and on the stored artifact it cannot be established empirically
  2563	    either -- see ``evaluable`` below.
  2564	    """
  2565	    out: Dict = {}
  2566	    for label, fields in (("cw_vs_HAR_FIXED", LEGACY_CW_FIELDS),
  2567	                          ("cw_vs_own_restriction", NESTED_CW_FIELDS)):
  2568	        rows = next((mkt[f] for f in fields if mkt.get(f)), None)
  2569	        if not rows:
  2570	            out[label] = {
  2571	                "evaluable": False,
  2572	                "reason": (f"none of {list(fields)} is present in this payload, so this "
  2573	                           "comparator's statistic was never computed on these data"),
  2574	            }
  2575	            continue
  2576	        t_stats = {n: rows[n].get("t_stat") for n in STATE_SPACE_MODELS if n in rows}
  2577	        clears_legacy = sorted(n for n, v in t_stats.items()
  2578	                               if v is not None and float(v) > LEGACY_GATE_T_CRITICAL)
  2579	        clears_current = sorted(n for n, v in t_stats.items()
  2580	                                if v is not None and float(v) >= GATE_T_CRITICAL)
  2581	        out[label] = {
  2582	            "evaluable": True,
  2583	            "t_stats": {k: (float(v) if v is not None else None) for k, v in t_stats.items()},
  2584	            f"clears_t_gt_{LEGACY_GATE_T_CRITICAL}": clears_legacy,
  2585	            f"clears_t_ge_{GATE_T_CRITICAL}": clears_current,
  2586	            "bar_move_is_a_subset": set(clears_current).issubset(set(clears_legacy)),
  2587	        }
  2588	
  2589	    both = all(v.get("evaluable") for v in out.values())
  2590	    out["cross_comparator_comparison"] = {
  2591	        "possible": both,
  2592	        "note": (
  2593	            "Both comparators present: the two screens can be compared cell by cell. Note that "
  2594	            "agreement here is a fact about THIS sample, not an ordering between the gates."
  2595	            if both else
  2596	            "NOT POSSIBLE on this payload. The stored full-sample artifact predates the fix and "
  2597	            "carries only the HAR_FIXED comparison; the own-restriction control series were "
  2598	            "never persisted (not in results.json, not in the forecast ledger). So the corrected "
  2599	            "gate has never been evaluated on real data, and no table can say whether it would "
  2600	            "reach the same NULL. Establishing that requires the rerun deferred in README 14."
  2601	        ),
  2602	    }
  2603	    return out
