  1503	def boundary_diagnostic(tuning_log: List[Dict]) -> Dict:
  1504	    """Do the FITTED hyperparameters have the finite memory GW's validity needs?
  1505	
  1506	    README section 12 committed to answering this from the tuning log rather than
  1507	    from the design's intention, and to demoting the GW-vs-HAR_ROLL test if
  1508	    boundary solutions turned out to be common.  This computes the fact;
  1509	    ``evaluate`` acts on it.  A discount of exactly 1.0 is an infinite-memory
  1510	    filter and Q = 0 is a filter that never moves, so at those points the
  1511	    "finite estimation window" premise is not weakened, it is absent.
  1512	    """
  1513	    n = len(tuning_log)
  1514	    d_one = [int(e["refit_origin_index"]) for e in tuning_log
  1515	             if float(e["discount"]["chosen"]) >= 1.0]
  1516	    q_lb = [int(e["refit_origin_index"]) for e in tuning_log
  1517	            if e["kf_mle"].get("at_lower_bound")]
  1518	    eta_lb = [int(e["refit_origin_index"]) for e in tuning_log
  1519	              if e["harsl_bm"].get("state_variance_at_lower_bound")]
  1520	    return {
  1521	        "n_refits": n,
  1522	        "HAR_KF_DISC_discount_equals_one": {"n": len(d_one), "refit_origins": d_one},
  1523	        "HAR_KF_MLE_q_at_lower_bound": {"n": len(q_lb), "refit_origins": q_lb},
  1524	        "HAR_S_BM_sig2_eta_at_lower_bound": {"n": len(eta_lb), "refit_origins": eta_lb},
  1525	        "finite_memory_precondition_holds": not (d_one or q_lb or eta_lb),
  1526	        "note": (
  1527	            "counted from tuning.log, not asserted from the design. Any non-zero count means "
  1528	            "at least one hyperparameter block has unbounded estimation memory, which is the "
  1529	            "condition GW (2006) needs to stay valid under nesting."
  1530	        ),
  1531	    }
