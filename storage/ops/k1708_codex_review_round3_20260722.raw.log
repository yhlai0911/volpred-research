   202	    with open(path, "rb") as fh:
   203	        for chunk in iter(lambda: fh.read(1 << 20), b""):
   204	            h.update(chunk)
   205	    return h.hexdigest()
   206	
   207	
   208	def sha256_text(text: str) -> str:
   209	    return hashlib.sha256(text.encode("utf-8")).hexdigest()
   210	
   211	
   212	def trace_file(path: Path) -> Dict:
   213	    st = path.stat()
   214	    return {
   215	        "path": str(path),
   216	        "sha256": sha256_file(path),
   217	        "size_bytes": st.st_size,
   218	        "mtime_ns": st.st_mtime_ns,
   219	    }
