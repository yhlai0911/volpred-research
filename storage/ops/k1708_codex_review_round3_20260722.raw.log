    36	def _synthetic_market(n: int = 400, seed: int = 0):
    37	    rng = np.random.default_rng(seed)
    38	    rv = np.exp(rng.normal(-9.0, 0.5, n))
    39	    dates = pd.date_range("2015-01-01", periods=n, freq="B").to_numpy(dtype="datetime64[D]")
