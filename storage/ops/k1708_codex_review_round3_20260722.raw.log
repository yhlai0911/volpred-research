  2190	def registry_identity_violations(name: str, cw: Dict) -> List[str]:
  2191	    """Does this CW row actually describe the comparison the registry declares?
  2192	
  2193	    BLOCKER-2 of the 2026-07-19 round-2 review: the previous version read
  2194	    ``exact_on_scored_object`` and ``holm.reject`` straight off the payload, so
  2195	    pasting those two labels onto ANY comparison bought a CONDITIONAL_PASS --
  2196	    the reviewer demonstrated it by relabelling the descriptive HAR_FIXED row
  2197	    and watching it qualify.  A field the verdict trusts but never checks is not
  2198	    evidence, it is a declaration; and a declaration is exactly what an
  2199	    overclaiming edit produces.  So identity is re-derived from
  2200	    ``NESTING_REGISTRY`` here, and the caller re-derives Holm from the p-values,
  2201	    rather than either being taken on the payload's word.
  2202	
  2203	    Returns the list of reasons this row may not become inference; empty list
  2204	    means the row is what it says it is.
  2205	    """
  2206	    spec = NESTING_REGISTRY.get(name)
  2207	    if spec is None:
  2208	        return [f"{name} has no NESTING_REGISTRY entry, so no comparison of it can be inference"]
  2209	
  2210	    bad: List[str] = []
  2211	    for field_name, want in (("control_series", spec["control"]),
  2212	                             ("restriction", spec["restriction"]),
  2213	                             ("forecast_map", spec["forecast_map"])):
  2214	        got = cw.get(field_name)
  2215	        if got != want:
  2216	            bad.append(f"{field_name}={got!r}, registry declares {want!r}")
  2217	
  2218	    if bool(cw.get("exact_on_scored_object")) != bool(spec["exact_on_scored_object"]):
  2219	        bad.append(
  2220	            f"exact_on_scored_object={cw.get('exact_on_scored_object')!r} contradicts the "
  2221	            f"registry ({spec['exact_on_scored_object']!r})"
  2222	        )
  2223	
  2224	    inconsistency = t_p_inconsistency(cw)
  2225	    if inconsistency:
  2226	        bad.append(inconsistency)
  2227	    return bad
