  1387	        "HAR_KF_MLE_AT_Q_ZERO": _restricted(
  1388	            "HAR_KF_MLE_AT_Q_ZERO", kf_mle_hyper, forecast_kalman),
  1389	        # sig2_eta = 0: HAR_S_BM's own null, produced by the HARSL map itself.
  1390	        # Before 2026-07-19 this role was played by HAR_FIXED_BLOCK_CADENCE,
  1391	        # which shares the refresh schedule but not the forecast map -- so the
  1392	        # Clark-West pair was never exact. sig2_eta = 0 pins the state
