  2629	def provenance_check_recorded_numbers(payload: Dict) -> Dict:
  2630	    """Re-derive the six numbers the 2026-07-17 review printed, from the payload.
  2631	
  2632	    Returns a per-number comparison; ``all_match`` is the headline.  QLIKE
  2633	    improvements are recomputed from ``mean_qlike`` (they are not stored as
  2634	    percentages anywhere), which means a hand-edit would have had to move the
  2635	    raw means AND land on the same three rounded percentages.
  2636	    """
  2637	    tw = (payload.get("markets") or {}).get("TAIFEX_TX", {})
  2638	    mean_q = tw.get("mean_qlike") or {}
  2639	    cw_rows: Dict = next((tw[f] for f in LEGACY_CW_FIELDS if tw.get(f)), {}) or {}
  2640	    bench = mean_q.get("HAR_FIXED")
  2641	
  2642	    checks: Dict[str, Dict] = {}
  2643	    for name, expected in REVIEW_RECORDED_20260717["qlike_pct_improvement_vs_HAR_FIXED"].items():
  2644	        got = (100.0 * (bench - mean_q[name]) / bench
  2645	               if bench and name in mean_q else None)
  2646	        checks[f"qlike_pct_{name}"] = {
  2647	            "recorded": expected,
  2648	            "recomputed": None if got is None else round(got, 3),
  2649	            "matches": got is not None and abs(round(got, 3) - expected) < 5e-4,
  2650	        }
  2651	    for name, expected in REVIEW_RECORDED_20260717["cw_t_vs_HAR_FIXED"].items():
  2652	        row = cw_rows.get(name) or {}
  2653	        got = row.get("t_stat")
