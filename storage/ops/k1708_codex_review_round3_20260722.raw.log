   733	def _control_inputs(n: int = 600, seed: int = 11):
   734	    """Inputs for the real control generator, shaped like a small production block."""
   735	    X, y = _burnin_block(n=n, seed=seed)
   736	    origins = np.arange(K.STATE_INIT_ROWS + 20, n)
   737	    refit_points = [int(origins[0]), int(origins[0]) + 120]
   738	    kf_disc_hyper = {rp: {"discount": 0.985, "sigma2": 0.25} for rp in refit_points}
   739	    kf_mle_hyper = {rp: {"Q": np.eye(K.N_FEATURES) * 1e-6, "sigma2": 0.22}
   740	                    for rp in refit_points}
   741	    harsl_hyper = {rp: {"beta": np.array([-11.0, 0.1, 0.3, 0.2]), "phi": 0.9,
   742	                        "sig2_eta": 0.01, "sig2_eps": 0.25} for rp in refit_points}
   743	    fitted = {"HAR_KF_DISC": kf_disc_hyper, "HAR_KF_MLE": kf_mle_hyper,
   744	              "HAR_S_BM": harsl_hyper}
   745	    return X, y, origins, refit_points, fitted
