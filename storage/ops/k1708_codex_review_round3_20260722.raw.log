  1311	def hyper_for(i: int, table: Dict[int, Dict]) -> Dict:
  1312	    """The hyperparameter block in force at origin ``i``: the latest refit at or before it.
  1313	
  1314	    Promoted from a closure inside ``run_market`` on 2026-07-19 so that
  1315	    ``build_nesting_controls`` -- and the tests that call it -- use the same
  1316	    lookup the models do.  Returns the stored dict itself, not a copy: the
  1317	    forecasters detect block boundaries by object identity (``h is not cur``).
  1318	    """
  1319	    keys = [k for k in sorted(table) if k <= i]
  1320	    return table[keys[-1]]
