  1404	def schedule_artifact_diagnostic(
  1405	    forecasts: Dict[str, np.ndarray],
  1406	    diagnostics: Dict[str, np.ndarray],
  1407	    actual: np.ndarray,
  1408	    origins: np.ndarray,
  1409	    benchmark: str,
  1410	) -> Dict:
  1411	    """Separate the mechanism under test from the plumbing it arrives in.
  1412	
  1413	    A margin against HAR_FIXED is not a clean read on coefficient dynamics, because
  1414	    the two sides differ in more than dynamics. HAR_FIXED re-fits beta and sigma2 at
  1415	    every origin; the state-space models re-fit every 252 days (a daily Kalman MLE is
  1416	    unaffordable), and HAR_KF_MLE additionally gets its sigma2 from the likelihood
  1417	    rather than from OLS. Both differences reach the scored level forecast through
  1418	    exp(mu + var/2), and neither is about time-varying coefficients.
  1419	
  1420	    So each model is also run AT ITS OWN NULL, on its own schedule, with its own
  1421	    sigma2 -- see CONTROL_FOR. Then:
  1422	
  1423	      qlike_vs_benchmark      the headline margin, dynamics + plumbing together
  1424	      schedule_artifact_qlike what that model's plumbing is worth with the dynamics
  1425	                              switched OFF (control vs HAR_FIXED)
  1426	      qlike_vs_own_restriction the dynamics alone, schedule held fixed -- the number
  1427	                              that actually answers this experiment's question
  1428	
  1429	    Reported, never netted out of the verdict: an adjustment chosen after seeing the
  1430	    numbers is not a correction. The verdict stays on the pre-registered criterion.
  1431	    """
  1432	    a = actual[origins]
  1433	    q: Dict[str, float] = {}
  1434	    for name, f in list(forecasts.items()) + list(diagnostics.items()):
  1435	        fi = f[origins]
  1436	        if not np.all(np.isfinite(fi) & (fi > 0)):
  1437	            raise SystemExit(f"FAIL_METHOD: diagnostic series {name} is not usable")
  1438	        q[name] = float(np.mean(qlike_pointwise(a, fi)))
  1439	
  1440	    per: Dict[str, Dict] = {}
  1441	    for model, control in CONTROL_FOR.items():
  1442	        if model not in q or control not in q:
  1443	            continue
  1444	        margin = q[model] - q[benchmark]
  1445	        artifact = q[control] - q[benchmark]
  1446	        per[model] = {
  1447	            "control_series": control,
  1448	            "control_is_exact_restriction": bool(
  1449	                NESTING_REGISTRY[model]["exact_on_scored_object"]
  1450	            ),
  1451	            "qlike_vs_benchmark": margin,
  1452	            "schedule_artifact_qlike": artifact,
  1453	            "pure_schedule_cost_qlike": (q[SCHEDULE_COST_CONTROL] - q[benchmark]
  1454	                                         if SCHEDULE_COST_CONTROL in q else None),
  1455	            "qlike_vs_own_restriction": q[model] - q[control],
  1456	            "artifact_share_of_margin": (abs(artifact) / abs(margin)
  1457	                                         if abs(margin) > 1e-12 else None),
  1458	            "artifact_direction": (
  1459	                "the plumbing HELPS this model, so part of any margin is not the mechanism"
  1460	                if artifact < 0 else
  1461	                "the plumbing HANDICAPS this model, so its margin understates the mechanism"
  1462	            ),
  1463	        }
  1464	
  1465	    return {
  1466	        "mean_qlike": q,
  1467	        "per_model": per,
  1468	        "control_series_definitions": {
  1469	            "HAR_FIXED_BLOCK_CADENCE": (
  1470	                "fixed-coefficient OLS with beta AND sigma2 refreshed only at the 252-day refit "
  1471	                "cadence: HAR_FIXED wearing the state-space schedule, no dynamics in it at all"
  1472	            ),
  1473	            "HAR_KF_DISC_AT_DELTA_ONE": (
  1474	                "the discount filter at its own null: beta updates daily (it is expanding-window "
  1475	                "OLS in log space), sigma2 is the block's OLS scale"
  1476	            ),
  1477	            "HAR_KF_MLE_AT_Q_ZERO": (
  1478	                "the MLE filter at its own null: beta updates daily, sigma2 is the block's "
  1479	                "LIKELIHOOD scale -- which is systematically smaller than the OLS scale, and "
  1480	                "therefore moves exp(mu + var/2) on its own, with Q = 0 throughout"
  1481	            ),
  1482	            "HAR_S_BM_AT_SIGMA_ETA_ZERO": (
  1483	                "the HARSL filter at its own null: sig2_eta = 0, so the state never moves and "
  1484	                "beta is whatever the block's joint MLE fitted. Produced by forecast_harsl -- "
  1485	                "the SAME map as HAR_S_BM -- which is what makes the Clark-West pair exact. "
  1486	                "HAR_FIXED_BLOCK_CADENCE was used for this role before 2026-07-19; it has the "
  1487	                "same refresh schedule but comes out of forecast_ols_block, a different map "
  1488	                "with a different predictive variance, so it never nested exactly."
  1489	            ),
  1490	        },
  1491	        "how_to_read": (
  1492	            "qlike_vs_own_restriction is the mechanism with the plumbing held fixed; it is the "
  1493	            "number this experiment is actually about. A qlike_vs_benchmark that is large while "
  1494	            "qlike_vs_own_restriction is ~0 means the margin is the plumbing, not the model."
  1495	        ),
  1496	        "not_a_model": (
