   431	# --------------------------------------------------------------------------- #
   432	# Estimators
   433	# --------------------------------------------------------------------------- #
   434	
   435	def ols_fit(X: np.ndarray, y: np.ndarray) -> Tuple[np.ndarray, float, np.ndarray]:
   436	    """Return (beta, sigma2, XtX_inv). Ridge-free; falls back to lstsq."""
   437	    XtX = X.T @ X
   438	    try:
   439	        XtX_inv = np.linalg.inv(XtX)
   440	        beta = XtX_inv @ (X.T @ y)
   441	    except np.linalg.LinAlgError:
   442	        beta, *_ = np.linalg.lstsq(X, y, rcond=None)
   443	        XtX_inv = np.linalg.pinv(XtX)
   444	    resid = y - X @ beta
   445	    dof = max(len(y) - X.shape[1], 1)
   446	    sigma2 = float(resid @ resid / dof)
   447	    return beta, sigma2, XtX_inv
   448	
   449	
   450	def ols_predict_with_var(
   451	    beta: np.ndarray, sigma2: float, XtX_inv: np.ndarray, x: np.ndarray
   452	) -> Tuple[float, float]:
   453	    """One-step predictive mean and predictive variance of y (log RV).
   454	
   455	    Predictive variance includes parameter uncertainty: sigma2 * (1 + x'(X'X)^-1 x).
   456	    This is the OLS analogue of the Kalman one-step predictive variance F_t, so
   457	    the lognormal correction is applied on comparable terms across models.
   458	    """
   459	    mu = float(x @ beta)
   460	    var = float(sigma2 * (1.0 + x @ XtX_inv @ x))
   461	    return mu, var
   462	
   463	
   464	def kalman_filter_har(
   465	    X: np.ndarray,
   466	    y: np.ndarray,
   467	    beta0: np.ndarray,
   468	    P0: np.ndarray,
   469	    sigma2: float,
   470	    Q: Optional[np.ndarray] = None,
   471	    discount: Optional[float] = None,
   472	    start: int = 0,
   473	) -> Tuple[np.ndarray, np.ndarray, float]:
   474	    """Run the local-level (random-walk coefficient) HAR filter.
   475	
   476	    Measurement : y_t = x_t' beta_t + eps_t,  eps_t ~ N(0, sigma2)
   477	    Transition  : beta_t = beta_{t-1} + eta_t, eta_t ~ N(0, Q)
   478	
   479	    Two conventional ways to inject time variation:
   480	      * explicit Q             (Bekierman & Manner 2018 style, Q by MLE)
   481	      * discount factor delta  (West & Harrison 1997): P_pred = P_post / delta,
   482	        i.e. Q_t = P_{t-1|t-1} (1 - delta) / delta.  delta = 1 -> no time variation.
   483	
   484	    ``start`` is the row (beta0, P0) is the prior FOR: rows before it produced the
   485	    prior and are not filtered again, and the returned log-likelihood is the one
   486	    conditional on them.  Filtering from row 0 with a prior that was itself fitted
   487	    on early rows would spend that data twice -- the posterior precision would be
   488	    inflated, the predictive variance understated, and the Jensen term
   489	    exp(mu + var/2) understated with it, on the exact quantity these models are
   490	    compared by.  Rows before ``start`` get NaN moments, never a fabricated one.
   491	
   492	    Returns (pred_mean, pred_var, loglik) where entries are the ONE-STEP-AHEAD
   493	    predictive moments for y_t formed from information through t-1 only, i.e.
   494	    x_t' beta_{t|t-1} and x_t' P_{t|t-1} x_t + sigma2.  The state is updated with
   495	    y_t only AFTER its own forecast has been recorded, so no observation is ever
   496	    used to predict itself and no smoothed/full-sample state is touched.
   497	    """
   498	    n = len(y)
   499	    beta = beta0.astype(float).copy()
   500	    P = P0.astype(float).copy()
   501	    pred_mean = np.full(n, np.nan)
   502	    pred_var = np.full(n, np.nan)
   503	    loglik = 0.0
   504	
   505	    for t in range(int(start), n):
   506	        # --- predict (information through t-1) -----------------------------
   507	        if discount is not None:
   508	            P_pred = P / discount
   509	        else:
   510	            P_pred = P + Q
   511	        x = X[t]
   512	        if not np.all(np.isfinite(x)):
   513	            # Regressors unavailable: the 22-day lag burn-in, or a censored
   514	            # (limit-locked) session sitting inside one of the aggregates. There
   515	            # is no forecast to make and nothing to learn from, so the state just
   516	            # evolves. Guarding on y alone is NOT enough -- on those rows y is
   517	            # finite while x is not, and a single NaN in x would poison beta
   518	            # through the gain and silently destroy every later forecast.
   519	            pred_mean[t] = np.nan
   520	            pred_var[t] = np.nan
   521	            P = P_pred
   522	            continue
   523	        mu = float(x @ beta)
   524	        F = float(x @ P_pred @ x + sigma2)
   525	        if not np.isfinite(F) or F <= 0:
   526	            F = max(sigma2, 1e-12)
   527	        pred_mean[t] = mu
   528	        pred_var[t] = F
   529	
   530	        # --- update with y_t (only after the forecast is recorded) ----------
   531	        yt = y[t]
   532	        if np.isfinite(yt):
   533	            v = yt - mu
   534	            loglik += -0.5 * (math.log(2 * math.pi) + math.log(F) + v * v / F)
   535	            K = (P_pred @ x) / F
   536	            beta = beta + K * v
   537	            P = P_pred - np.outer(K, x @ P_pred)
   538	            P = 0.5 * (P + P.T)  # keep symmetric against round-off
   539	        else:
   540	            beta = beta
   541	            P = P_pred
   542	
   543	    return pred_mean, pred_var, loglik
   544	
