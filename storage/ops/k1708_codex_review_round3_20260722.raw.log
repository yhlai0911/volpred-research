  2250	def assess_market(mkt: Dict) -> Dict:
  2251	    """Every declared success condition, evaluated on ONE market's own numbers.
  2252	
  2253	    Written this way because the previous version did not do it: it read
  2254	    TAIFEX's QLIKE and CW, then counted any market with ``status == "OK"``
  2255	    toward the >= 2 requirement, whether or not that market had shown a single
  2256	    thing.  A payload with a second market present but empty returned SUPPORTED.
  2257	    The current run could not trip it (SPY/QQQ are FAIL_NO_DATA), which is
  2258	    exactly why it survived review twice -- so the check now lives per market,
  2259	    reads only that market's own numbers, and a market that shows nothing
  2260	    qualifies as nothing.
  2261	
  2262	    2026-07-19 round 2: it also no longer takes the payload's word for whether a
  2263	    comparison is nested, or for whether Holm rejected.  Both are re-derived
  2264	    here -- identity from ``NESTING_REGISTRY``, Holm from the p-values -- so
  2265	    that relabelling a row cannot buy a verdict.
  2266	    """
  2267	    if mkt.get("status") != "OK":
  2268	        return {"qualifies": False, "reason": f"status={mkt.get('status')}", "models": {}}
  2269	
  2270	    cw_all = mkt.get("cw_vs_own_restriction_primary") or {}
  2271	    if not cw_all:
  2272	        return {
  2273	            "qualifies": False,
  2274	            "reason": (
  2275	                "no exactly-nested Clark-West comparison in this payload. Since 2026-07-19 the "
  2276	                "verdict consumes cw_vs_own_restriction_primary only; cw_vs_fixed_* is "
  2277	                "descriptive and cannot qualify a market."
  2278	            ),
  2279	            "models": {},
  2280	        }
  2281	
  2282	    mcs_q = set((mkt.get("mcs_qlike") or {}).get("superior_set") or [])
  2283	    regimes = mkt.get("regime_breakdown") or {}
  2284	    scored_regimes = [r for r, blk in regimes.items()
  2285	                      if isinstance(blk, dict) and blk.get("n", 0) >= 30
  2286	                      and "qlike_vs_own_restriction" in blk]
  2287	
  2288	    # --- identity first: which rows are even entitled to be inference? --------
  2289	    # Re-derived from the registry, not read off the payload. A row that fails
  2290	    # this is excluded from the Holm family too -- otherwise a relabelled row
  2291	    # would still enlarge m and shift everyone else's thresholds.
  2292	    violations: Dict[str, List[str]] = {}
  2293	    for name in STATE_SPACE_MODELS:
  2294	        cw = cw_all.get(name)
  2295	        if cw:
  2296	            violations[name] = registry_identity_violations(name, cw)
  2297	
  2298	    verified_family = {name: float(cw_all[name]["p_value_one_sided"])
  2299	                       for name, bad in violations.items() if not bad}
  2300	    holm_recomputed = (holm_bonferroni(verified_family, GATE_FAMILY_ALPHA)
  2301	                       if verified_family else {})
  2302	
  2303	    models: Dict[str, Dict] = {}
  2304	    for name in STATE_SPACE_MODELS:
  2305	        cw = cw_all.get(name)
  2306	        if not cw:
  2307	            models[name] = {"passes": False, "missing": "no CW row"}
  2308	            continue
  2309	
  2310	        identity_ok = not violations[name]
  2311	        recomputed = holm_recomputed.get(name, {})
  2312	        claimed_holm = bool((cw.get("holm") or {}).get("reject"))
  2313	        regime_margins = {r: (regimes[r].get("qlike_vs_own_restriction") or {}).get(name)
  2314	                          for r in scored_regimes}
  2315	        conds = {
  2316	            # (1) the comparison is entitled to be inference at all -- checked
  2317	            #     against NESTING_REGISTRY, not against the payload's own flag
  2318	            "exact_nesting": identity_ok,
  2319	            # (2) the pre-registered critical value, on the nested-valid statistic
  2320	            "cw_t_at_or_above_bar": bool(cw.get("t_stat", -np.inf) >= GATE_T_CRITICAL),
  2321	            # (3) multiplicity across the family -- recomputed here from the
  2322	            #     p-values of the identity-verified rows only
  2323	            "holm_rejects": bool(recomputed.get("reject")),
  2324	            # (4) the point estimate agrees, against the SAME control
  2325	            "qlike_improves_vs_control": bool(cw.get("qlike_vs_control", np.inf) < 0),
  2326	            # (5) set evidence, not just a pairwise win
  2327	            "in_mcs_qlike_superior_set": bool(name in mcs_q),
  2328	            # (6) it holds in both volatility regimes, on the same nested pair
  2329	            "regime_consistent": bool(
  2330	                len(scored_regimes) >= 2
  2331	                and all(v is not None and v < 0 for v in regime_margins.values())
  2332	            ),
  2333	        }
  2334	        models[name] = {
  2335	            "passes": all(conds.values()),
  2336	            "conditions": conds,
  2337	            "cw_t_stat": cw.get("t_stat"),
  2338	            "cw_p_one_sided": cw.get("p_value_one_sided"),
  2339	            "qlike_vs_control": cw.get("qlike_vs_control"),
  2340	            "control_series": cw.get("control_series"),
  2341	            "regime_qlike_vs_own_restriction": regime_margins,
  2342	            "registry_identity_violations": violations[name],
  2343	            "holm_recomputed": recomputed,
