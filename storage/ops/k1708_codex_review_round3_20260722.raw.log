   790	def test_each_restriction_actually_bites():
   791	    """A control that equals its unrestricted model is not a restriction at all.
   792	
   793	    If the patch silently failed to apply, Clark-West would be comparing a model
   794	    against itself: adjustment term zero, t-stat meaningless. Cheap to check,
   795	    and it is the failure mode a typo in RESTRICTION_PATCH produces.
   796	    """
   797	    X, y, origins, refit_points, fitted = _control_inputs()
   798	    _, controls = K.build_nesting_controls(
   799	        X, y, origins, refit_points,
   800	        fitted["HAR_KF_DISC"], fitted["HAR_KF_MLE"], fitted["HAR_S_BM"], jensen=True,
   801	    )
   802	    unrestricted = {
   803	        "HAR_KF_DISC": K.forecast_kalman(
   804	            X, y, origins, K.STATE_INIT_ROWS,
   805	            {int(i): K.hyper_for(int(i), fitted["HAR_KF_DISC"]) for i in origins}),
   806	        "HAR_KF_MLE": K.forecast_kalman(
   807	            X, y, origins, K.STATE_INIT_ROWS,
   808	            {int(i): K.hyper_for(int(i), fitted["HAR_KF_MLE"]) for i in origins}),
   809	        "HAR_S_BM": K.forecast_harsl(
   810	            X, y, origins,
   811	            {int(i): K.hyper_for(int(i), fitted["HAR_S_BM"]) for i in origins}),
   812	    }
   813	    for model, spec in K.NESTING_REGISTRY.items():
   814	        mu, var = unrestricted[model]
   815	        free = K.lognormal_mean(mu, var, True)[origins]
   816	        restricted = controls[spec["control"]][origins]
   817	        assert not np.allclose(free, restricted), (
   818	            f"{spec['control']} is identical to unrestricted {model}: the restriction "
   819	            f"'{spec['restriction']}' did not take effect"
   820	        )
