  2463	def legacy_derive_verdict(payload: Dict) -> Dict:
  2464	    """Reconstruction of the pre-2026-07-19 gate, pinned to two recorded anchors.
  2465	
  2466	    The original bytes are NOT in git.  ``experiments/k1708/`` enters history as
  2467	    an ADDED tree at ``cd135b00e`` (the fix commit itself), so ``cd135b00e^``
  2468	    contains no version of this file and there is no pre-fix blob to check out.
  2469	    The pre-fix file is identified only by the sha256 in the stored
  2470	    ``code_trace`` (``43bffdd4...``), which names content that is in no object
  2471	    database.  This function is therefore a RECONSTRUCTION, and it is admissible
  2472	    as a differential baseline only because it reproduces two facts recorded
  2473	    independently of it, both asserted in ``test_k1708.py``:
  2474	
  2475	      anchor A -- the ``verdict`` block stored in ``K1708_results.json``, which
  2476	        IS the pre-fix function's own output on the real full-sample payload:
  2477	        label ``NULL``, ``qualified_markets == ["TAIFEX_TX"]``,
  2478	        ``supported_unreachable`` true, ``state_space_beating_fixed_har == []``,
  2479	        ``benchmark_in_mcs`` true, and all three models in the MCS superior set.
  2480	      anchor B -- the false positive the 2026-07-17 review demonstrated: TAIFEX
  2481	        clearing one-sided CW at 5%, plus a second market that is nothing but
  2482	        ``status == "OK"``, returns ``SUPPORTED``.
  2483	
  2484	    If either anchor stops holding, this reconstruction has drifted and every
  2485	    differential test built on it is void -- which is why both are tests and not
  2486	    comments.
  2487	    """
  2488	    markets = payload.get("markets") or {}
  2489	    if not any(v.get("status") == "OK" for v in markets.values()):
  2490	        return {"label": "FAIL_NO_DATA", "qualified_markets": [],
  2491	                "state_space_beating_fixed_har": [],
  2492	                "rationale": "no market produced an admissible ledger"}
  2493	
  2494	    # The defect: "qualified" meant nothing but a status string.
  2495	    qualified = sorted(m for m, v in markets.items() if v.get("status") == "OK")
  2496	
  2497	    tw = markets.get("TAIFEX_TX", {})
  2498	    cw_rows: Dict = next((tw[f] for f in LEGACY_CW_FIELDS if tw.get(f)), {}) or {}
  2499	    mean_q = tw.get("mean_qlike") or {}
  2500	    bench = mean_q.get("HAR_FIXED")
  2501	
  2502	    beating: List[str] = []
  2503	    for name in STATE_SPACE_MODELS:
  2504	        row = cw_rows.get(name)
  2505	        if not row:
  2506	            continue
  2507	        clears = float(row.get("t_stat", -np.inf)) > LEGACY_GATE_T_CRITICAL
  2508	        improves = bench is not None and name in mean_q and mean_q[name] < bench
  2509	        if clears and improves:
  2510	            beating.append(name)
  2511	
  2512	    if len(qualified) >= 2 and beating:
  2513	        label = "SUPPORTED"
  2514	    elif beating:
  2515	        label = "CONDITIONAL_PASS"
  2516	    else:
  2517	        label = "NULL"
  2518	
  2519	    ss = set((tw.get("mcs_qlike") or {}).get("superior_set") or [])
  2520	    return {
  2521	        "label": label,
  2522	        "qualified_markets": qualified,
  2523	        "supported_unreachable": len(qualified) < 2,
  2524	        "state_space_in_mcs_superior_set": [m for m in STATE_SPACE_MODELS if m in ss],
  2525	        "state_space_beating_fixed_har": sorted(beating),
  2526	        "benchmark_in_mcs": "HAR_FIXED" in ss,
  2527	        "governing_test": "Clark-West (2007) one-sided at 5% + point QLIKE improvement",
  2528	        "rationale": ("state-space HAR did not clear the Clark-West bar against fixed HAR"
  2529	                      if not beating else
  2530	                      f"{len(qualified)} market(s) with admissible data; {beating} cleared"),
  2531	        "RECONSTRUCTION": (
  2532	            "Not the original bytes -- experiments/k1708/ is an ADDED tree at cd135b00e, so no "
  2533	            "pre-fix blob exists. Pinned to the stored verdict block and to the reviewer's "
  2534	            "demonstrated false positive; see the docstring and the anchor tests."
  2535	        ),
