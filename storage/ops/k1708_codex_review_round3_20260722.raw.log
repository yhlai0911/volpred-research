   656	# --------------------------------------------------------------------------- #
   657	# HARSL: Bekierman & Manner (2018), the literature's state-space HAR
   658	# --------------------------------------------------------------------------- #
   659	
   660	def harsl_filter(
   661	    X: np.ndarray,
   662	    y: np.ndarray,
   663	    beta: np.ndarray,
   664	    phi: float,
   665	    sig2_eta: float,
   666	    sig2_eps: float,
   667	) -> Tuple[np.ndarray, np.ndarray, float]:
   668	    """Kalman filter for the HARSL model of Bekierman & Manner (2018), eqs (2.10)-(2.11).
   669	
   670	    Measurement : y_t = b0 + (b1 + lam_t) x_d,t + b2 x_w,t + b3 x_m,t + eps_t
   671	    Transition  : lam_{t+1} = phi lam_t + eta_{t+1},   |phi| < 1
   672	
   673	    Note what this is NOT. Only the DAILY coefficient moves, the state is a
   674	    SINGLE SCALAR, its variance is a SCALAR, and the process is a STATIONARY
   675	    AR(1) -- not a random walk, and not a time-varying coefficient vector. That
   676	    distinction is the reason this model is implemented separately from
   677	    HAR_KF_DISC/HAR_KF_MLE instead of citing B&M for those: attributing a
   678	    random-walk vector DLM to this paper would misdescribe it.
   679	
   680	    The state is initialised from its stationary distribution, lam_0 ~ N(0,
   681	    sig2_eta / (1 - phi^2)), which is the standard initialisation for a
   682	    stationary AR(1) state and uses no sample information.
   683	
   684	    Returns one-step predictive moments formed from information through t-1.
   685	    """
   686	    n = len(y)
   687	    pred_mean = np.full(n, np.nan)
   688	    pred_var = np.full(n, np.nan)
   689	    loglik = 0.0
   690	
   691	    lam = 0.0
   692	    P = sig2_eta / max(1.0 - phi * phi, 1e-8)
   693	
   694	    for t in range(n):
   695	        lam_pred = phi * lam
   696	        P_pred = phi * phi * P + sig2_eta
   697	
   698	        x = X[t]
   699	        if not np.all(np.isfinite(x)):
   700	            lam, P = lam_pred, P_pred
   701	            continue
   702	
   703	        z = float(x[1])  # the daily regressor is what loads the state
   704	        mu = float(x @ beta) + z * lam_pred
   705	        F = float(z * z * P_pred + sig2_eps)
   706	        if not np.isfinite(F) or F <= 0:
   707	            F = max(sig2_eps, 1e-12)
   708	        pred_mean[t] = mu
   709	        pred_var[t] = F
   710	
   711	        yt = y[t]
   712	        if np.isfinite(yt):
   713	            v = yt - mu
   714	            loglik += -0.5 * (math.log(2 * math.pi) + math.log(F) + v * v / F)
   715	            K = P_pred * z / F
   716	            lam = lam_pred + K * v
   717	            P = P_pred - K * z * P_pred
   718	        else:
   719	            lam, P = lam_pred, P_pred
   720	
   721	    return pred_mean, pred_var, loglik
   722	
   723	
   724	def _harsl_unpack(theta: np.ndarray) -> Tuple[np.ndarray, float, float, float]:
   725	    beta = theta[:N_FEATURES]
   726	    phi = float(np.tanh(theta[N_FEATURES]))          # keeps |phi| < 1 (stationarity)
   727	    sig2_eta = float(np.exp(np.clip(theta[N_FEATURES + 1], -40.0, 10.0)))
   728	    sig2_eps = float(np.exp(np.clip(theta[N_FEATURES + 2], -40.0, 10.0)))
   729	    return beta, phi, sig2_eta, sig2_eps
   730	
   731	
   732	def harsl_mle(X: np.ndarray, y: np.ndarray, seed: int = SEED) -> Tuple[Dict, Dict]:
   733	    """Joint MLE of (beta, phi, sig2_eta, sig2_eps) on TRAINING data only.
   734	
   735	    Bekierman & Manner estimate the model "using the Kalman filter and maximum
   736	    likelihood estimation"; the coefficients are estimated jointly with the
   737	    state parameters rather than concentrated out.
   738	    """
   739	    from scipy.optimize import minimize
   740	
   741	    # Same rule as kalman_mle: the scale fit sees only jointly-finite rows.
   742	    ok = np.isfinite(y) & np.all(np.isfinite(X), axis=1)
   743	    if ok.sum() < 50:
   744	        raise SystemExit(
   745	            f"FAIL_METHOD: only {int(ok.sum())} jointly-finite rows available for the HARSL "
   746	            "starting values."
   747	        )
   748	    beta_ols, sigma2_ols, _ = ols_fit(X[ok], y[ok])
   749	    if not np.isfinite(sigma2_ols) or sigma2_ols <= 0:
   750	        raise SystemExit(f"FAIL_METHOD: OLS scale for the HARSL MLE is not usable: {sigma2_ols}")
   751	
   752	    def negloglik(theta: np.ndarray) -> float:
   753	        beta, phi, s2_eta, s2_eps = _harsl_unpack(theta)
   754	        _, _, ll = harsl_filter(X, y, beta, phi, s2_eta, s2_eps)
   755	        if not np.isfinite(ll):
   756	            return 1e12
   757	        return -ll
   758	
   759	    rng = np.random.default_rng(seed)
   760	    base = np.concatenate([
   761	        beta_ols,
   762	        [np.arctanh(0.9)],                    # persistent but stationary start
   763	        [math.log(sigma2_ols * 1e-2)],
   764	        [math.log(sigma2_ols)],
   765	    ])
   766	    starts = [base]
   767	    for phi0 in (0.5, 0.99):
   768	        s = base.copy()
   769	        s[N_FEATURES] = np.arctanh(phi0)
   770	        starts.append(s)
   771	    for _ in range(2):
   772	        s = base.copy()
   773	        s[N_FEATURES + 1:] += rng.normal(0.0, 1.0, size=2)
   774	        starts.append(s)
   775	
   776	    best = None
   777	    n_converged = 0
   778	    for s0 in starts:
   779	        try:
   780	            res = minimize(negloglik, s0, method="Nelder-Mead",
   781	                           options={"maxiter": 4000, "xatol": 1e-4, "fatol": 1e-4})
   782	        except Exception:  # silent-ok: same contract as the KF multistart above -- per-start
   783	            continue       # failure is expected, n_converged is logged, and best is None
   784	                           # raises FAIL_METHOD a few lines down.
   785	        if res.success:
   786	            n_converged += 1
   787	        if np.isfinite(res.fun) and (best is None or res.fun < best.fun):
   788	            best = res
   789	
   790	    if best is None or best.fun >= 1e11:
   791	        raise SystemExit(
   792	            "FAIL_METHOD: HARSL likelihood was undefined at every start. Refusing to "
   793	            "report a fabricated fit."
   794	        )
   795	
   796	    beta, phi, s2_eta, s2_eps = _harsl_unpack(best.x)
   797	    hyper = {"beta": beta, "phi": phi, "sig2_eta": s2_eta, "sig2_eps": s2_eps}
   798	    info = {
   799	        "converged": bool(best.success),
   800	        "n_starts": len(starts),
   801	        "n_converged": int(n_converged),
   802	        "loglik": float(-best.fun),
   803	        "beta": [float(b) for b in beta],
   804	        "phi": phi,
   805	        "sig2_eta": s2_eta,
   806	        "sig2_eps": s2_eps,
   807	        "eta_over_eps": float(s2_eta / s2_eps) if s2_eps > 0 else None,
   808	        "state_variance_at_lower_bound": bool(best.x[N_FEATURES + 1] <= -39.0),
   809	        # 0.999 was too generous to be worth reading: it let phi = 0.9923 with
   810	        # sig2_eta = 2.3e-06 -- a state that is one shock short of a random walk
   811	        # and is fed essentially no shocks -- report as "0/10 near unit root",
   812	        # which reads more reassuring than the fit is. 0.99 is the conventional
   813	        # persistence threshold and flags it.
   814	        "phi_near_unit_root": bool(abs(phi) > 0.99),
   815	        "phi_near_unit_root_threshold": 0.99,
   816	        # The interpretable quantity: how far the daily coefficient actually
   817	        # wanders. sd(lam) = sqrt(sig2_eta / (1 - phi^2)) is the stationary
   818	        # dispersion of the state, which a near-unit-root phi and a pinned
   819	        # sig2_eta can both drive to nothing by different routes.
   820	        "stationary_state_sd": float(math.sqrt(s2_eta / max(1.0 - phi * phi, 1e-12))),
   821	        "note": (
   822	            "sig2_eta pinned at the lower bound means the data prefer NO time variation "
   823	            "in the daily coefficient -- the pile-up outcome, which is itself a result. "
   824	            "Read phi_near_unit_root together with stationary_state_sd: a persistent state "
   825	            "with near-zero innovations is degenerate too, just not at the bound"
   826	        ),
   827	    }
   828	    return hyper, info
   829	
   830	
   831	def forecast_harsl(
   832	    X: np.ndarray, y: np.ndarray, origins: np.ndarray, hyper_by_origin: Dict[int, Dict]
   833	) -> Tuple[np.ndarray, np.ndarray]:
   834	    """HARSL forecasts, re-running the scalar-state filter per hyperparameter block."""
   835	    n = len(y)
   836	    mu = np.full(n, np.nan)
   837	    var = np.full(n, np.nan)
   838	
   839	    blocks: List[Tuple[int, int, Dict]] = []
   840	    cur: Optional[Dict] = None
   841	    start = None
   842	    for i in origins:
   843	        h = hyper_by_origin[int(i)]
   844	        if cur is None or h is not cur:
   845	            if cur is not None:
   846	                blocks.append((start, int(i), cur))
   847	            cur, start = h, int(i)
   848	    if cur is not None:
   849	        blocks.append((start, int(origins[-1]) + 1, cur))
   850	
   851	    for b_start, b_end, hyper in blocks:
   852	        pm, pv, _ = harsl_filter(
   853	            X[:b_end], y[:b_end], hyper["beta"], hyper["phi"],
   854	            hyper["sig2_eta"], hyper["sig2_eps"],
   855	        )
   856	        sel = (origins >= b_start) & (origins < b_end)
   857	        for i in origins[sel]:
   858	            mu[i], var[i] = pm[i], pv[i]
   859	    return mu, var
   860	
   861	
   862	# --------------------------------------------------------------------------- #
   863	# Forecast production (per model), strictly past-only
   864	# --------------------------------------------------------------------------- #
   865	
   866	def lognormal_mean(mu: np.ndarray, var: np.ndarray, jensen: bool = True) -> np.ndarray:
   867	    """E[RV] for log RV ~ N(mu, var).
   868	
   869	    K1648's Codex review established the repo rule: a plug-in exp(mu) forecast
   870	    systematically UNDER-states the variance.  The correct conditional mean is
   871	    exp(mu + var/2).  Applied identically to every model, each with its own
   872	    predictive variance, so no model is advantaged by the convention.
   873	    """
   874	    if jensen:
   875	        return np.exp(mu + 0.5 * var)
   876	    return np.exp(mu)
   877	
   878	
   879	def forecast_ols(
   880	    X: np.ndarray, y: np.ndarray, origins: np.ndarray, window: Optional[int]
   881	) -> Tuple[np.ndarray, np.ndarray]:
   882	    """Recursive (window=None) or rolling-window OLS forecasts at each origin.
   883	
   884	    At origin index i the estimation sample is strictly rows < i that are
   885	    admissible, so the target y_i is never in its own training set.
   886	    """
   887	    n = len(y)
   888	    mu = np.full(n, np.nan)
   889	    var = np.full(n, np.nan)
   890	    valid = np.isfinite(y) & np.all(np.isfinite(X), axis=1)
   891	
   892	    for i in origins:
   893	        lo = 0 if window is None else max(0, i - window)
   894	        idx = np.where(valid[lo:i])[0] + lo
   895	        if len(idx) < 50:
   896	            continue
   897	        beta, sigma2, XtX_inv = ols_fit(X[idx], y[idx])
   898	        mu[i], var[i] = ols_predict_with_var(beta, sigma2, XtX_inv, X[i])
   899	    return mu, var
   900	
   901	
   902	def forecast_ols_block(
   903	    X: np.ndarray, y: np.ndarray, origins: np.ndarray, hyper_by_origin: Dict[int, Dict]
   904	) -> Tuple[np.ndarray, np.ndarray]:
   905	    """Expanding-window OLS whose beta AND sigma2 are refreshed only at the refit
   906	    cadence and then frozen for the block.
   907	
   908	    Not a model under test -- it never enters forecasts{}, MCS, DM or CW.  It is
   909	    HAR_FIXED wearing the state-space models' parameter-refresh schedule, and the
   910	    schedule is the ONLY thing separating the two once the coefficient dynamics
   911	    are switched off.  Its gap to HAR_FIXED is therefore the price of the refresh
   912	    cadence alone, with no time-varying coefficient anywhere in it: the number
   913	    that says whether a CW or QLIKE margin against HAR_FIXED is measuring the
   914	    mechanism or measuring the compute budget.
   915	    """
   916	    n = len(y)
   917	    mu = np.full(n, np.nan)
   918	    var = np.full(n, np.nan)
   919	    cache: Dict[int, Tuple[np.ndarray, np.ndarray, float]] = {}
   920	    for i in origins:
   921	        rp = int(hyper_by_origin[int(i)]["refit_origin"])
   922	        if rp not in cache:
   923	            cache[rp] = _init_block(X, y, rp)
   924	        beta, XtX_inv, s2 = cache[rp]
   925	        mu[i], var[i] = ols_predict_with_var(beta, s2, XtX_inv, X[i])
   926	    return mu, var
   927	
   928	
   929	def _init_block(X: np.ndarray, y: np.ndarray, upto: int) -> Tuple[np.ndarray, np.ndarray, float]:
   930	    """OLS fit on the state-initialisation block [0, upto).
   931	
   932	    Returns (beta0, XtX_inv, sigma2_ols).  The caller scales XtX_inv by whichever
   933	    observation variance the filter is actually going to use -- see ``_init_state``.
   934	    """
   935	    valid = np.isfinite(y) & np.all(np.isfinite(X), axis=1)
   936	    idx = np.where(valid[:upto])[0]
   937	    if len(idx) < 50:
   938	        raise SystemExit(
   939	            f"FAIL_METHOD: only {len(idx)} jointly-finite rows in the state-initialisation "
   940	            f"block [0, {upto}); refusing to start a filter from an undefined prior."
   941	        )
   942	    beta0, sigma2, XtX_inv = ols_fit(X[idx], y[idx])
   943	    return beta0, XtX_inv, sigma2
   944	
   945	
   946	def _init_state(
   947	    X: np.ndarray, y: np.ndarray, upto: int, sigma2: Optional[float] = None
   948	) -> Tuple[np.ndarray, np.ndarray, float]:
   949	    """State prior at row ``upto``:  beta ~ N(beta_OLS[0,upto), sigma2 (X'X)^-1).
   950	
   951	    ``sigma2`` defaults to the block's own OLS scale; pass the filter's own
   952	    observation variance instead to keep the prior conjugate to THAT filter.
   953	    That is not cosmetic: with a conjugate prior the restricted filter
   954	    (discount=1 / Q=0) reproduces expanding-window OLS exactly, which is the
   955	    nesting the whole Clark-West design rests on.  With a mismatched scale the
   956	    "restriction" only approximates the benchmark and the nesting claim in the
   957	    module docstring would be a statement about intent rather than about code.
   958	
   959	    Returns (beta0, P0, sigma2_ols).
   960	    """
   961	    beta0, XtX_inv, s2_ols = _init_block(X, y, upto)
   962	    s2 = s2_ols if sigma2 is None else float(sigma2)
   963	    return beta0, s2 * XtX_inv, s2_ols
   964	
   965	
   966	def forecast_kalman(
   967	    X: np.ndarray,
   968	    y: np.ndarray,
   969	    origins: np.ndarray,
   970	    init_upto: int,
   971	    hyper_by_origin: Dict[int, Dict],
   972	) -> Tuple[np.ndarray, np.ndarray]:
   973	    """Kalman forecasts, re-running the filter from the initialisation block.
   974	
   975	    The filter is re-run from scratch whenever the hyperparameters change, so
   976	    the state is always the one implied by the currently selected hyperparameters
   977	    applied to past data only.  Within a hyperparameter block the recursion
   978	    proceeds day by day, which is exactly the filter's own past-only recursion.
   979	
   980	    The prior at ``init_upto`` is rebuilt by the SAME rule the estimator used --
   981	    ``sigma2 * XtX_inv`` from the block's own sigma2 -- and the recursion starts
   982	    at ``init_upto`` rather than at row 0, so the initialisation rows are never
   983	    filtered a second time.
   984	    """
   985	    n = len(y)
   986	    mu = np.full(n, np.nan)
   987	    var = np.full(n, np.nan)
   988	    beta0, XtX_inv, _ = _init_block(X, y, init_upto)
   989	
   990	    blocks: List[Tuple[int, int, Dict]] = []
   991	    cur: Optional[Dict] = None
   992	    start = None
   993	    for i in origins:
   994	        h = hyper_by_origin[i]
   995	        if cur is None or h is not cur:
   996	            if cur is not None:
   997	                blocks.append((start, i, cur))
   998	            cur, start = h, i
   999	    if cur is not None:
  1000	        blocks.append((start, int(origins[-1]) + 1, cur))
  1001	
  1002	    for b_start, b_end, hyper in blocks:
  1003	        sigma2 = hyper["sigma2"]
  1004	        Q = hyper.get("Q")
  1005	        disc = hyper.get("discount")
  1006	        Xf = X[:b_end]
  1007	        yf = y[:b_end].copy()
  1008	        # rows whose target is invalid simply carry the state forward (handled
  1009	        # inside the filter by the isfinite check)
  1010	        pm, pv, _ = kalman_filter_har(
  1011	            Xf, yf, beta0, sigma2 * XtX_inv, sigma2, Q=Q, discount=disc, start=init_upto
  1012	        )
  1013	        sel = (origins >= b_start) & (origins < b_end)
  1014	        for i in origins[sel]:
  1015	            mu[i], var[i] = pm[i], pv[i]
  1016	    return mu, var
  1017	
