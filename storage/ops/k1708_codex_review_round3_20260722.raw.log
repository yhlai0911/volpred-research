  1019	# --------------------------------------------------------------------------- #
  1020	# Inner rolling validation (hyperparameters never see outer OOS)
  1021	# --------------------------------------------------------------------------- #
  1022	
  1023	def _qlike_from_log(mu: np.ndarray, var: np.ndarray, actual: np.ndarray, idx: np.ndarray) -> float:
  1024	    f = lognormal_mean(mu[idx], var[idx])
  1025	    a = actual[idx]
  1026	    ok = np.isfinite(f) & np.isfinite(a) & (f > 0) & (a > 0)
  1027	    if ok.sum() < 20:
  1028	        return np.inf
  1029	    return float(np.mean(qlike_pointwise(a[ok], f[ok])))
  1030	
  1031	
  1032	def select_roll_window(
  1033	    X: np.ndarray, y: np.ndarray, actual: np.ndarray, train_end: int
  1034	) -> Tuple[int, Dict]:
  1035	    """Choose the rolling window on an inner validation block INSIDE training."""
  1036	    val_start = max(LAG_M + 100, train_end - INNER_VAL)
  1037	    val_idx = np.arange(val_start, train_end)
  1038	    scores = {}
  1039	    for w in ROLL_GRID:
  1040	        mu, var = forecast_ols(X, y, val_idx, window=w)
  1041	        scores[w] = _qlike_from_log(mu, var, actual, val_idx)
  1042	    if not any(math.isfinite(v) for v in scores.values()):
  1043	        raise SystemExit(
  1044	            "FAIL_METHOD: every rolling-window candidate scored a non-finite inner-validation "
  1045	            f"QLIKE at train_end={train_end}. Selecting the grid's first entry by default would "
  1046	            "be an arbitrary choice dressed up as tuning."
  1047	        )
  1048	    best = min(scores, key=lambda k: scores[k])
  1049	    return best, {"grid": list(ROLL_GRID), "qlike": {str(k): _jsonable(v) for k, v in scores.items()},
  1050	                  "chosen": best, "inner_val_span": [int(val_start), int(train_end)]}
  1051	
  1052	
  1053	def select_discount(
  1054	    X: np.ndarray, y: np.ndarray, actual: np.ndarray, train_end: int, init_upto: int
  1055	) -> Tuple[float, Dict]:
  1056	    """Choose the discount factor on an inner validation block INSIDE training.
  1057	
  1058	    Returns the chosen delta only -- deliberately NOT a sigma2.  The scale used
  1059	    here is fitted on [0, val_start) so that no candidate is ranked using a
  1060	    sigma2 that already saw the block it is being scored on; that makes it a
  1061	    selection-time device and nothing else.  Letting it escape to the outer OOS
  1062	    filter (which an earlier revision did) would run the challenger on a scale
  1063	    252 trading days out of date while the expanding-window benchmark re-fits its
  1064	    own scale at every origin -- an asymmetry between the two sides of the
  1065	    comparison, not a design choice.  sigma2 is a model parameter, so the
  1066	    production one is re-estimated on the FULL training set by the caller, and
  1067	    ``test_discount_filter_gets_the_full_training_scale`` pins that it is that
  1068	    one, not this one, which reaches the forecasts.
  1069	    """
  1070	    val_start = max(LAG_M + 100, train_end - INNER_VAL)
  1071	    if init_upto >= val_start:
  1072	        raise SystemExit(
  1073	            f"FAIL_METHOD: the state-initialisation block [0, {init_upto}) reaches into the "
  1074	            f"inner validation block [{val_start}, {train_end}); the prior would be built from "
  1075	            "the data the candidates are scored on."
  1076	        )
  1077	    val_idx = np.arange(val_start, train_end)
  1078	    _, _, sigma2_sel = _init_block(X, y, val_start)
  1079	    beta0, P0, _ = _init_state(X, y, init_upto, sigma2=sigma2_sel)
  1080	    scores = {}
  1081	    for d in DISCOUNT_GRID:
  1082	        pm, pv, _ = kalman_filter_har(
  1083	            X[:train_end], y[:train_end], beta0, P0, sigma2_sel, discount=d, start=init_upto
  1084	        )
  1085	        mu = np.full(len(y), np.nan); var = np.full(len(y), np.nan)
  1086	        mu[:train_end], var[:train_end] = pm, pv
  1087	        scores[d] = _qlike_from_log(mu, var, actual, val_idx)
  1088	    if not any(math.isfinite(v) for v in scores.values()):
  1089	        raise SystemExit(
  1090	            "FAIL_METHOD: every discount-factor candidate scored a non-finite inner-validation "
  1091	            f"QLIKE at train_end={train_end}. This is the signature of a filter that never "
  1092	            "produced a usable forecast; refusing to fall back to the grid's first entry."
  1093	        )
  1094	    best = min(scores, key=lambda k: scores[k])
  1095	    return best, {"grid": list(DISCOUNT_GRID),
  1096	                  "qlike": {str(k): _jsonable(v) for k, v in scores.items()},
  1097	                  "chosen": best,
  1098	                  "inner_val_span": [int(val_start), int(train_end)],
  1099	                  "state_init_rows": int(init_upto),
  1100	                  "sigma2_selection_only": float(sigma2_sel),
