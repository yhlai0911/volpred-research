  2656	            "stored": None if got is None else round(float(got), 3),
  2657	            "matches": got is not None and abs(round(float(got), 3) - expected) < 5e-4,
  2658	        }
  2659	
  2660	    return {
  2661	        "source": REVIEW_RECORDED_20260717["source"],
  2662	        "checks": checks,
