   494	def _dual_schema_market(nested_t: float = 4.0, fixed_t: float = 2.0,
   495	                        qlike_margin: float = -0.002):
   496	    """A market in the schema a POST-fix rerun actually produces: both comparisons.
   497	
   498	    This shape is what makes the differential tests below mean anything.  The
   499	    legacy gate reads the HAR_FIXED comparison; the current gate reads the
   500	    own-restriction one.  A payload carrying only the new field is INVISIBLE to
   501	    the legacy gate, which returns NULL by default -- and a test built on that
   502	    proves nothing, which is precisely the round-2 finding.  Carrying both lets
   503	    the two gates disagree on the same artifact, so a disagreement is evidence.
   504	    """
   505	    mkt = _passing_market(t_stat=nested_t, qlike_margin=qlike_margin)
   506	    mkt["cw_vs_fixed_descriptive_not_nested"] = {
   507	        "HAR_KF_MLE": {"t_stat": fixed_t, "p_value_one_sided": _one_sided_p(fixed_t),
   508	                       "reject_at_5pct": fixed_t > 1.645},
   509	    }
   510	    return mkt
