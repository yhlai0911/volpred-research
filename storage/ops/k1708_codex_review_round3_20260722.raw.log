  1322	# The restriction each control imposes, as a hyperparameter patch on its model's
  1323	# own fitted block. Kept next to the registry so that "what does this model's
  1324	# null look like" has one answer, and so a test can apply the same patch to the
  1325	# same map and check the production control against it.
  1326	RESTRICTION_PATCH = {
  1327	    "HAR_KF_DISC_AT_DELTA_ONE": lambda h: {"discount": 1.0, "sigma2": h["sigma2"]},
  1328	    "HAR_KF_MLE_AT_Q_ZERO": lambda h: {"Q": np.zeros((N_FEATURES, N_FEATURES)),
  1329	                                       "sigma2": h["sigma2"]},
  1330	    "HAR_S_BM_AT_SIGMA_ETA_ZERO": lambda h: dict(h, sig2_eta=0.0),
  1331	}
