  1334	def build_nesting_controls(
  1335	    X: np.ndarray,
  1336	    y: np.ndarray,
  1337	    origins: np.ndarray,
  1338	    refit_points: Sequence[int],
  1339	    kf_disc_hyper: Dict,
  1340	    kf_mle_hyper: Dict,
  1341	    harsl_hyper: Dict,
  1342	    jensen: bool,
  1343	) -> Tuple[Dict[str, np.ndarray], Dict[str, np.ndarray]]:
  1344	    """Build every control series, each through ITS OWN model's forecast map.
  1345	
  1346	    Extracted from ``run_market`` on 2026-07-19 (round 2) so that the tests can
  1347	    exercise the production generator instead of asserting on the registry's
  1348	    strings.  The round-2 review's point was exact: a test that checks
  1349	    ``spec["forecast_map"] == "forecast_kalman"`` checks a label, and a label is
  1350	    the one thing that survives the mistake it is supposed to catch.  It is a
  1351	    pure extraction -- same calls, same order, no numerical change.
  1352	
  1353	    Returns ``(diagnostic_series, nesting_controls)``: the first is everything
  1354	    including the schedule-cost series, the second is only what the verdict may
  1355	    consume, i.e. exactly the controls named in ``NESTING_REGISTRY``.
  1356	    """
