     1	"""
     2	K1686: Contemporaneous Null Simulation for Volatility Absorption (Paper 8)
     3	
     4	Fixes the identification defect found in the 2026-07-11 fable deep review (P0-1):
     5	
     6	  K897's simulated day-t vol proxy was sqrt(h[t]), which is F_{t-1}-measurable under the
     7	  GJR recursion h[t] = w + (a + g*1{eps_{t-1}<0})*eps_{t-1}^2 + b*h[t-1].  It does not
     8	  react to r_t at all, so the simulated "shock day" lands on the day AFTER a large move.
     9	  The empirical delta_VIX_t, by contrast, is contemporaneous with r_t (VIX spikes on the
    10	  day the market crashes).  The empirical SAR numerator is therefore mechanically inflated
    11	  by same-day co-movement while the simulated one is not -- the two sides are not the same
    12	  statistic, and "empirical decline >> null" may be an artifact of that mismatch.
    13	
    14	  Fix: use sqrt(h[t+1]) as the day-t proxy -- the GARCH forecast formed at the close of day
    15	  t, after r_t is observed.  That is the correct analogue of "closing VIX reflects today's
    16	  information".
    17	
    18	Design (see README.md for the full pre-registered spec):
    19	  - Same GARCH params, same seeds (0..9999), same n_obs (5000) as K897, so the simulated
    20	    return paths r are POINTWISE IDENTICAL to K897's.  Only the proxy timing changes.
    21	  - Built-in K897 replication arm (lagged proxy) computed on the SAME paths.  If it
    22	    reproduces K897's sim_mean_decline = 0.1734, any difference in the contemporaneous arm
    23	    is attributable to the timing fix alone.  This is the experiment's internal placebo.
    24	  - Empirical side reads the PINNED snapshot CSV (K897 used live yfinance -- review P1-3).
    25	  - 5 variants: A fixed (PRIMARY) / B frequency-matched / C relative / D sign-split /
    26	    E ambient-regime.
    27	
    28	Decision rule was pre-registered and committed BEFORE this script was run (git history).
    29	
    30	Data: paper/volatility-absorption/data/spy_gld_tlt_qqq_eem_vix_2005-2026.csv (pinned)
    31	"""
    32	
    33	import json
    34	import warnings
    35	from pathlib import Path
    36	
    37	import numpy as np
    38	import pandas as pd
    39	from concurrent.futures import ProcessPoolExecutor
    40	import multiprocessing
    41	
    42	warnings.filterwarnings("ignore")
    43	
    44	HERE = Path(__file__).resolve().parent
    45	REPO = HERE.parent.parent
    46	PINNED_CSV = REPO / "paper/volatility-absorption/data/spy_gld_tlt_qqq_eem_vix_2005-2026.csv"
    47	
    48	# --- Frozen spec (pre-registered) ---------------------------------------------------
    49	N_SIM = 10_000
    50	N_OBS = 5_000
    51	SEEDS = range(N_SIM)              # identical to K897
    52	SAMPLE_START, SAMPLE_END = "2006-01-01", "2026-04-05"
    53	SHOCK_ABS = 2.0                   # |delta VIX| > 2, same as paper Table 3
    54	ANN = np.sqrt(252.0)
    55	MIN_CELL = 5                      # need n_shock > 5 and n_normal > 5 (K897 convention)
    56	
    57	REGIME_NAMES = ["calm (<15)", "normal (15-20)", "elevated (20-25)", "high (25-30)", "crisis (>=30)"]
    58	REGIME_BOUNDS = [(0, 15), (15, 20), (20, 25), (25, 30), (30, 1e6)]
    59	
    60	# K897 fitted GJR-GARCH(1,1)-t params, reused verbatim so the null DGP is unchanged.
    61	K897_PARAMS = {
    62	    "mu": 0.07641013516248987,
    63	    "ar1": 0.0,
    64	    "omega": 0.022188769677603346,
    65	    "alpha": 0.0,
    66	    "gamma": 0.24422367045225124,
    67	    "beta": 0.8594147336803625,
    68	    "nu": 5.647879075643755,
    69	    "persistence": 0.981526568906488,
    70	}
    71	K897_REFERENCE = {  # for the replication check
    72	    "sim_mean_decline": 0.1734,
    73	    "sim_std_decline": 0.2105,
    74	    "sim_ci_95": [-0.2811, 0.5575],
    75	    "empirical_decline_live_yfinance": 0.8162,
    76	}
    77	
    78	
    79	# ====================================================================================
    80	# SAR core -- one implementation used by BOTH the empirical and the simulated side,
    81	# so the two can never drift apart.
    82	# ====================================================================================
    83	def sar_by_regime(abs_ret, level, shock, bounds=REGIME_BOUNDS):
    84	    """SAR(regime) = mean(|r| | shock, regime) / mean(|r| | normal, regime).
    85	
    86	    abs_ret : |r_t|
    87	    level   : the fear level used to assign day t to a regime (VIX_t or the GARCH proxy)
    88	    shock   : boolean shock flag for day t
    89	    """
    90	    out, occ, shock_n = [], [], []
    91	    for lo, hi in bounds:
    92	        m = (level >= lo) & (level < hi)
    93	        sm, nm = m & shock, m & ~shock
    94	        ns, nn = int(sm.sum()), int(nm.sum())
    95	        occ.append(float(m.mean()))
    96	        shock_n.append(ns)
    97	        if ns > MIN_CELL and nn > MIN_CELL:
    98	            out.append(float(abs_ret[sm].mean() / abs_ret[nm].mean()))
    99	        else:
   100	            out.append(np.nan)
   101	    return np.array(out), np.array(occ), np.array(shock_n)
   102	
   103	
   104	def decay_only_drop_level(params, drop=SHOCK_ABS):
   105	    """Lowest vol level at which the null can produce a `drop`-point one-day FALL.
   106	
   107	    With alpha = 0 a positive return contributes nothing to next-day variance, so the deepest
   108	    possible one-day fall is pure decay: h_next = omega + beta*h.  Solving
   109	        (sqrt(omega + beta*h) - sqrt(h)) * sqrt(252) = -drop
   110	    gives the level below which a "vol-DOWN shock" is IMPOSSIBLE in this null.  That is what
   111	    makes D_down undefined in the lower regimes -- a structural property, not a coding bug.
   112	    """
   113	    from scipy.optimize import brentq
   114	    w, b = params["omega"], params["beta"]
   115	
   116	    def f(P):
   117	        h = (P / ANN) ** 2
   118	        return (np.sqrt(w + b * h) - np.sqrt(h)) * ANN + drop
   119	
   120	    try:
   121	        return float(brentq(f, 1.0, 500.0))
   122	    except ValueError:
   123	        return float("nan")
   124	
   125	
   126	def decline(sars):
   127	    """Primary statistic: SAR(calm) - SAR(high 25-30)."""
   128	    calm, high = sars[0], sars[3]
   129	    if np.isnan(calm) or np.isnan(high):
   130	        return np.nan
   131	    return float(calm - high)
   132	
   133	
   134	def decline_nh(sars):
   135	    """Secondary statistic: SAR(normal 15-20) - SAR(high 25-30).
   136	
   137	    Needed because the calm cell is not always measurable -- in variant F the affine
   138	    recalibration that fixes the level gap also shrinks the increments, so a calm-regime
   139	    shock (2 VIX-scale points) becomes rarer than the minimum cell size. Reporting the
   140	    normal-to-high leg keeps that variant from being silently dropped.
   141	    """
   142	    normal, high = sars[1], sars[3]
   143	    if np.isnan(normal) or np.isnan(high):
   144	        return np.nan
   145	    return float(normal - high)
   146	
   147	
   148	# ====================================================================================
   149	# Simulation: one GJR path -> every variant's SAR (computed on the SAME path)
   150	# ====================================================================================
   151	def simulate_one(args):
   152	    seed, params, n_obs, spec = args
   153	    rng = np.random.RandomState(seed)
   154	
   155	    mu, ar1 = params["mu"], params["ar1"]
   156	    omega, alpha, gamma, beta, nu = (
   157	        params["omega"], params["alpha"], params["gamma"], params["beta"], params["nu"],
   158	    )
   159	
   160	    # Identical draw to K897: same seed, same size, same scaling -> bit-identical z.
   161	    z = rng.standard_t(df=nu, size=n_obs) * np.sqrt((nu - 2) / nu)
   162	
   163	    r = np.zeros(n_obs)
   164	    h = np.zeros(n_obs + 1)          # ONE EXTRA STEP: h[n_obs] needs only eps[n_obs-1]
   165	
   166	    h[0] = omega / (1 - alpha - gamma / 2 - beta)
   167	    r[0] = mu + np.sqrt(h[0]) * z[0]
   168	
   169	    for t in range(1, n_obs):        # recursion identical to K897 (ar1 = 0 here)
   170	        indicator = 1.0 if r[t - 1] - mu < 0 else 0.0
   171	        eps = r[t - 1] - mu - ar1 * (r[t - 2] if t >= 2 else 0)
   172	        h[t] = max(omega + (alpha + gamma * indicator) * eps ** 2 + beta * h[t - 1], 1e-8)
   173	        r[t] = mu + ar1 * r[t - 1] + np.sqrt(h[t]) * z[t]
   174	
   175	    # The extra step that makes a contemporaneous proxy possible at t = n_obs-1.
   176	    indicator = 1.0 if r[n_obs - 1] - mu < 0 else 0.0
   177	    eps = r[n_obs - 1] - mu - ar1 * (r[n_obs - 2] if n_obs >= 2 else 0)
   178	    h[n_obs] = max(omega + (alpha + gamma * indicator) * eps ** 2 + beta * h[n_obs - 1], 1e-8)
   179	
   180	    abs_ret = np.abs(r)
   181	
   182	    # --- the two proxies -------------------------------------------------------------
   183	    p_lag = np.sqrt(h[:n_obs]) * ANN        # K897: sqrt(h[t])   -- F_{t-1}-measurable
   184	    p_con = np.sqrt(h[1:n_obs + 1]) * ANN   # K1686: sqrt(h[t+1]) -- reacts to r_t
   185	
   186	    res = {}
   187	    for tag, P in (("k897_lagged", p_lag), ("contemporaneous", p_con)):
   188	        dP = np.concatenate([[0.0], np.diff(P)])   # K897 convention: t=0 is a normal day
   189	
   190	        # --- A: fixed threshold (PRIMARY) ---
   191	        shock_a = np.abs(dP) > SHOCK_ABS
   192	        sars, occ, ns = sar_by_regime(abs_ret, P, shock_a)
   193	        res[f"{tag}|A"] = sars
   194	        if tag == "contemporaneous":
   195	            res["occ_A"], res["nshock_A"] = occ, ns
   196	            res["shock_rate_A"] = float(shock_a.mean())
   197	        else:
   198	            res["occ_A_lagged"] = occ
   199	            res["shock_rate_A_lagged"] = float(shock_a.mean())
   200	
   201	    # Everything below uses the contemporaneous proxy only.
   202	    P = p_con
   203	    dP = np.concatenate([[0.0], np.diff(P)])
   204	    s = spec["shock_rate"]
   205	
   206	    # --- B: frequency-matched (path-specific quantiles for BOTH shock and regimes) ---
   207	    thr_b = np.quantile(np.abs(dP[1:]), 1.0 - s)
   208	    shock_b = np.abs(dP) > thr_b
   209	    # regime cut-points = this path's own P-quantiles at the empirical VIX regime probabilities
   210	    qs = np.quantile(P, spec["regime_probs"])
   211	    bounds_b = [(-1e9, qs[0]), (qs[0], qs[1]), (qs[1], qs[2]), (qs[2], qs[3]), (qs[3], 1e9)]
   212	    sars_b, occ_b, _ = sar_by_regime(abs_ret, P, shock_b, bounds_b)
   213	    res["contemporaneous|B"] = sars_b
   214	    res["occ_B"] = occ_b
   215	    res["shock_rate_B"] = float(shock_b.mean())
   216	
   217	    # --- C: relative threshold (same unit-free q as empirical) ---
   218	    rel = np.zeros(len(P))
   219	    rel[1:] = np.abs(dP[1:]) / P[:-1]
   220	    shock_c = rel > spec["rel_q"]
   221	    sars_c, _, _ = sar_by_regime(abs_ret, P, shock_c)
   222	    res["contemporaneous|C"] = sars_c
   223	    res["shock_rate_C"] = float(shock_c.mean())
   224	
   225	    # --- D: sign-split (denominator = the shared non-shock set, as in the empirical) ---
   226	    shock_up, shock_dn = dP > SHOCK_ABS, dP < -SHOCK_ABS
   227	    any_shock = np.abs(dP) > SHOCK_ABS
   228	    for sfx, sm_flag in (("D_up", shock_up), ("D_down", shock_dn)):
   229	        vals = []
   230	        for lo, hi in REGIME_BOUNDS:
   231	            m = (P >= lo) & (P < hi)
   232	            sm, nm = m & sm_flag, m & ~any_shock
   233	            if int(sm.sum()) > MIN_CELL and int(nm.sum()) > MIN_CELL:
   234	                vals.append(float(abs_ret[sm].mean() / abs_ret[nm].mean()))
   235	            else:
   236	                vals.append(np.nan)
   237	        res[f"contemporaneous|{sfx}"] = np.array(vals)
   238	    res["shock_rate_D_up"] = float(shock_up.mean())
   239	    res["shock_rate_D_down"] = float(shock_dn.mean())
