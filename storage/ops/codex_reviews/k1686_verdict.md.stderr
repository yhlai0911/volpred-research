   265	    dP_f = np.concatenate([[0.0], np.diff(P_f)])
   266	    shock_f = np.abs(dP_f) > SHOCK_ABS
   267	    sars_f, occ_f, ns_f = sar_by_regime(abs_ret, P_f, shock_f)
   268	    res["contemporaneous|F"] = sars_f
   269	    res["occ_F"] = occ_f
   270	    res["shock_rate_F"] = float(shock_f.mean())
   271	
   272	    return res
   273	
   274	
   275	# ====================================================================================
   276	# Empirical side -- mirrors simulate_one() variant for variant
   277	# ====================================================================================
   278	def filtered_contemporaneous_proxy(returns, params):
   279	    """Run the SAME GJR recursion on the REAL returns and return the day-t contemporaneous
   280	    proxy sqrt(h[t+1])*sqrt(252). Used only to calibrate the null's vol scale onto VIX's
   281	    (variant F) -- it is not used for any SAR computation on the empirical side."""
   282	    mu, ar1 = params["mu"], params["ar1"]
   283	    w, al, g, b = params["omega"], params["alpha"], params["gamma"], params["beta"]
   284	    r = np.asarray(returns, dtype=float)
   285	    n = len(r)
   286	    h = np.zeros(n + 1)
   287	    h[0] = w / (1 - al - g / 2 - b)
   288	    for t in range(1, n + 1):
   289	        ind = 1.0 if r[t - 1] - mu < 0 else 0.0
   290	        eps = r[t - 1] - mu - ar1 * (r[t - 2] if t >= 2 else 0.0)
   291	        h[t] = max(w + (al + g * ind) * eps ** 2 + b * h[t - 1], 1e-8)
   292	    return np.sqrt(h[1:n + 1]) * ANN
   293	
   294	
   295	def empirical_side():
   296	    df = pd.read_csv(PINNED_CSV, parse_dates=["date"])
   297	    df = df[(df.date >= SAMPLE_START) & (df.date <= SAMPLE_END)].copy()
   298	    df["ret"] = np.log(df["spy_adj_close"] / df["spy_adj_close"].shift(1)) * 100
   299	    df = df.dropna(subset=["ret", "vix_close"])
   300	    df["dvix"] = df["vix_close"].diff()
   301	    df = df.dropna(subset=["dvix"]).reset_index(drop=True)
   302	
   303	    a = df["ret"].abs().values
   304	    V = df["vix_close"].values
   305	    dV = df["dvix"].values
   306	
   307	    shock_a = np.abs(dV) > SHOCK_ABS
   308	    s = float(shock_a.mean())
   309	
   310	    # regime probabilities under the empirical VIX -- variant B matches these by construction
   311	    regime_probs = [float((V < b).mean()) for b in (15, 20, 25, 30)]
   312	
   313	    # variant C: the unit-free threshold that reproduces the same shock rate empirically
   314	    rel = np.zeros(len(V))
   315	    rel[1:] = np.abs(dV[1:]) / V[:-1]
   316	    rel_q = float(np.quantile(rel[1:], 1.0 - s))
   317	
   318	    emp = {}
   319	    sars_a, occ_a, ns_a = sar_by_regime(a, V, shock_a)
   320	    emp["A"] = sars_a
   321	
   322	    thr_b = float(np.quantile(np.abs(dV), 1.0 - s))
   323	    shock_b = np.abs(dV) > thr_b
   324	    emp["B"] = sar_by_regime(a, V, shock_b)[0]
   325	
   326	    shock_c = rel > rel_q
   327	    emp["C"] = sar_by_regime(a, V, shock_c)[0]
   328	
   329	    any_shock = np.abs(dV) > SHOCK_ABS
   330	    for sfx, sm_flag in (("D_up", dV > SHOCK_ABS), ("D_down", dV < -SHOCK_ABS)):
   331	        vals = []
   332	        for lo, hi in REGIME_BOUNDS:
   333	            m = (V >= lo) & (V < hi)
   334	            sm, nm = m & sm_flag, m & ~any_shock
   335	            if int(sm.sum()) > MIN_CELL and int(nm.sum()) > MIN_CELL:
   336	                vals.append(float(a[sm].mean() / a[nm].mean()))
   337	            else:
   338	                vals.append(np.nan)
   339	        emp[sfx] = np.array(vals)
   340	
   341	    emp["E"] = sar_by_regime(a[1:], V[:-1], any_shock[1:])[0]
   342	    emp["F"] = emp["A"]   # F changes only the NULL's scale; the data side is variant A
   343	    emp["G"] = sar_by_regime(a[1:], V[:-1], shock_c[1:])[0]   # ambient regime + relative threshold
   344	
   345	    # Variant F calibration: affine map from the null's physical vol scale onto VIX's scale,
   346	    # fitted on the real data (VIX_t ~ a + b * P_t, where P_t is the same contemporaneous GJR
   347	    # proxy the simulation uses). This is what lets the null be judged by the paper's literal
   348	    # 15/20/25/30 thresholds without the variance-risk-premium level gap contaminating it.
   349	    P_emp = filtered_contemporaneous_proxy(df["ret"].values, K897_PARAMS)
   350	    b_vrp, a_vrp = np.polyfit(P_emp, V, 1)
   351	
   352	    spec = {
   353	        "shock_rate": s,
   354	        "regime_probs": regime_probs,
   355	        "rel_q": rel_q,
   356	        "shock_thr_b": thr_b,
   357	        "vrp_a": float(a_vrp),
   358	        "vrp_b": float(b_vrp),
   359	    }
   360	    # Sign composition of the shock bucket, regime by regime. This is what the pooled
   361	    # |dVIX| > 2 definition hides: at low VIX the shock bucket is mostly VIX-DOWN days,
   362	    # and the calm-regime cell that anchors the whole decline is tiny.
   363	    comp = []
   364	    for lo, hi in REGIME_BOUNDS:
   365	        m = (V >= lo) & (V < hi)
   366	        n_up = int((m & (dV > SHOCK_ABS)).sum())
   367	        n_dn = int((m & (dV < -SHOCK_ABS)).sum())
   368	        comp.append({
   369	            "regime": REGIME_NAMES[len(comp)],
   370	            "n_shock_up": n_up,
   371	            "n_shock_down": n_dn,
   372	            "n_normal": int((m & ~shock_a).sum()),
   373	            "up_share_of_shocks": round(n_up / (n_up + n_dn), 4) if (n_up + n_dn) else None,
   374	        })
   375	
   376	    # The up-only calm cell has n=10. A point estimate from 10 observations must not be stated
   377	    # as settled fact (independent review H3), so bootstrap it and report the interval.
   378	    rng_bs = np.random.RandomState(20260712)
   379	    calm_m = (V >= 0) & (V < 15)
   380	    high_m = (V >= 25) & (V < 30)
   381	    cells = {
   382	        "calm_up": a[calm_m & (dV > SHOCK_ABS)], "calm_normal": a[calm_m & ~shock_a],
   383	        "high_up": a[high_m & (dV > SHOCK_ABS)], "high_normal": a[high_m & ~shock_a],
   384	    }
   385	    bs_sar_calm, bs_sar_high, bs_dec = [], [], []
   386	    for _ in range(10_000):
   387	        d = {k: rng_bs.choice(v, size=len(v), replace=True) for k, v in cells.items()}
   388	        sc = d["calm_up"].mean() / d["calm_normal"].mean()
   389	        sh = d["high_up"].mean() / d["high_normal"].mean()
   390	        bs_sar_calm.append(sc), bs_sar_high.append(sh), bs_dec.append(sc - sh)
   391	    up_bs = {
   392	        "n_calm_up_shocks": int(len(cells["calm_up"])),
   393	        "sar_up_calm": round(float(np.mean(bs_sar_calm)), 4),
   394	        "sar_up_calm_ci95": [round(float(np.percentile(bs_sar_calm, 2.5)), 4),
   395	                             round(float(np.percentile(bs_sar_calm, 97.5)), 4)],
   396	        "sar_up_high_ci95": [round(float(np.percentile(bs_sar_high, 2.5)), 4),
   397	                             round(float(np.percentile(bs_sar_high, 97.5)), 4)],
   398	        "up_decline_calm_minus_high": round(float(np.mean(bs_dec)), 4),
   399	        "up_decline_ci95": [round(float(np.percentile(bs_dec, 2.5)), 4),
   400	                            round(float(np.percentile(bs_dec, 97.5)), 4)],
   401	        "up_decline_ci_contains_zero": bool(np.percentile(bs_dec, 2.5) <= 0 <= np.percentile(bs_dec, 97.5)),
   402	        "seed": 20260712,
   403	        "note": ("The calm up-shock cell has only 10 days, so the up-only decline is imprecise. "
   404	                 "What the interval CAN establish is reported; what it cannot is not asserted."),
   405	    }
   406	
   407	    diag = {
   408	        "sample": f"{df.date.min():%Y-%m-%d} to {df.date.max():%Y-%m-%d}",
   409	        "up_shock_bootstrap": up_bs,
   410	        "n_observations": int(len(df)),
   411	        "shock_rate_A": s,
   412	        "n_shock_A": int(shock_a.sum()),
   413	        "regime_occupancy": occ_a.tolist(),
   414	        "n_shock_by_regime": ns_a.tolist(),
   415	        "shock_sign_composition": comp,
   416	        "n_shock_up": int((dV > SHOCK_ABS).sum()),
   417	        "n_shock_down": int((dV < -SHOCK_ABS).sum()),
   418	        "relative_threshold_q": rel_q,
   419	        "abs_threshold_b": thr_b,
   420	    }
   421	    return emp, spec, diag
   422	
   423	
   424	# ====================================================================================
   425	# Inference
   426	# ====================================================================================
   427	def compare(emp_val, sim_vals, label):
   428	    sim = np.asarray([v for v in sim_vals if not np.isnan(v)], dtype=float)
   429	    n = len(sim)
   430	    if n < 100 or emp_val is None or np.isnan(emp_val):
   431	        return {"label": label, "empirical": None if emp_val is None or np.isnan(emp_val) else round(float(emp_val), 4),
   432	                "n_valid_sims": n, "note": "insufficient valid simulations"}
   433	    mean, std = float(sim.mean()), float(sim.std())
   434	    lo, hi = float(np.percentile(sim, 2.5)), float(np.percentile(sim, 97.5))
   435	    frac_above = float((sim >= emp_val).mean())
   436	    frac_below = float((sim <= emp_val).mean())
   437	    # Monte-Carlo empirical p-value (primary; no distributional assumption)
   438	    # (b+1)/(n+1) plug-in rather than a bare 1/n floor -- the unbiased MC p-value (review L3).
   439	    b_side = min(int((sim >= emp_val).sum()), int((sim <= emp_val).sum()))
   440	    p_mc = float(min(1.0, 2.0 * (b_side + 1) / (n + 1)))
   441	    z = float((emp_val - mean) / std) if std > 0 else float("nan")  # standardised distance
   442	    return {
   443	        "label": label,
   444	        "empirical": round(float(emp_val), 4),
   445	        "sim_mean": round(mean, 4),
   446	        "sim_std": round(std, 4),
   447	        "sim_ci_95": [round(lo, 4), round(hi, 4)],
   448	        "in_95_ci": bool(lo <= emp_val <= hi),
   449	        "z_score": round(z, 4),
   450	        "p_value_monte_carlo": round(p_mc, 6),
   451	        "frac_sim_above_empirical": round(frac_above, 4),
   452	        "n_valid_sims": n,
   453	    }
   454	
   455	
   456	def regimewise(emp_sars, sim_matrix, label):
   457	    out, n_out, n_tested = {}, 0, 0
   458	    for i, rn in enumerate(REGIME_NAMES):
   459	        c = compare(emp_sars[i], sim_matrix[:, i], f"{label} :: {rn}")
   460	        out[rn] = c
   461	        if "in_95_ci" in c:
   462	            n_tested += 1
   463	            n_out += (not c["in_95_ci"])
   464	    return out, f"{n_out}/{n_tested}"
   465	
   466	
   467	# ====================================================================================
   468	def main():
   469	    print("=" * 78)
   470	    print("K1686: Contemporaneous null simulation (Paper 8 make-or-break gate)")
   471	    print("=" * 78)
   472	
   473	    print("\n[1/4] Empirical side (PINNED snapshot)...")
   474	    emp, spec, diag = empirical_side()
   475	    print(f"  {diag['sample']}  n={diag['n_observations']}  shock rate={diag['shock_rate_A']:.4f} "
   476	          f"(n_shock={diag['n_shock_A']})")
   477	    for i, rn in enumerate(REGIME_NAMES):
   478	        print(f"    {rn:<18} SAR={emp['A'][i]:.4f}  occupancy={diag['regime_occupancy'][i]:.3f}")
   479	    emp_decline = decline(emp["A"])
   480	    print(f"  EMPIRICAL DECLINE (calm - high) = {emp_decline:.4f}   "

