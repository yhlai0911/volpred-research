import numpy as np, pandas as pd
p='paper/volatility-absorption/data/spy_gld_tlt_qqq_eem_vix_2005-2026.csv'
df=pd.read_csv(p,parse_dates=['date'])
df=df[(df.date>='2006-01-01')&(df.date<='2026-04-05')].copy()
df['ret']=np.log(df.spy_adj_close/df.spy_adj_close.shift(1))*100
df=df.dropna(subset=['ret','vix_close'])
df['dvix']=df.vix_close.diff(); df=df.dropna(subset=['dvix']).reset_index(drop=True)
a=np.abs(df.ret.to_numpy())[1:]; prior=df.vix_close.to_numpy()[:-1]; dv=df.dvix.to_numpy()[1:]
anys=np.abs(dv)>2; up=dv>2; down=dv< -2
bounds=[(0,15),(15,20),(20,25),(25,30),(30,1e6)]
def vec(flag):
 out=[]; counts=[]
 for lo,hi in bounds:
  m=(prior>=lo)&(prior<hi); num=a[m&flag]; den=a[m&~anys]
  out.append(num.mean()/den.mean()); counts.append((len(num),len(den)))
 return np.array(out),counts
for name,flag in [('up',up),('down',down),('pooled',anys)]:
 s,c=vec(flag); print(name, np.round(s,4), 'decline',round(float(s[0]-s[3]),4),'counts',c)
# Recreate stratified iid bootstrap for ambient-up decline, same 4-cell style
ca=(prior<15); hi=(prior>=25)&(prior<30)
cells={'cu':a[ca&up], 'cn':a[ca&~anys], 'hu':a[hi&up], 'hn':a[hi&~anys]}
rng=np.random.RandomState(20260712); z=np.empty(100000)
for b in range(len(z)):
 d={k:rng.choice(v,len(v),replace=True) for k,v in cells.items()}
 z[b]=d['cu'].mean()/d['cn'].mean()-d['hu'].mean()/d['hn'].mean()
