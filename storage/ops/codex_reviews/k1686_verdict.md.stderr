p='paper/volatility-absorption/data/spy_gld_tlt_qqq_eem_vix_2005-2026.csv'; d=pd.read_csv(p)
d=d[(d.date>='2006-01-01')&(d.date<='2026-04-05')].copy(); d['ret']=np.log(d.spy_adj_close/d.spy_adj_close.shift(1))*100; d=d.dropna(subset=['ret','vix_close']); d['dvix']=d.vix_close.diff(); d=d.dropna(subset=['dvix']).reset_index(drop=True)
a=np.abs(d.ret.to_numpy())[1:]; v=d.vix_close.to_numpy()[:-1]; x=d.dvix.to_numpy()[1:]; n=len(a)
def stat(ix):
 aa=a[ix]; vv=v[ix]; xx=x[ix]; sh=np.abs(xx)>2; up=xx>2; ca=vv<15; hi=(vv>=25)&(vv<30)
 return aa[ca&up].mean()/aa[ca&~sh].mean()-aa[hi&up].mean()/aa[hi&~sh].mean()
rng=np.random.RandomState(20260732); L=20; m=(n+L-1)//L; base=np.arange(L); z=[]
for _ in range(10000):
 st=rng.randint(0,n,m); ix=((st[:,None]+base)%n).ravel()[:n]; val=stat(ix)
