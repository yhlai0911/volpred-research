def run(seed,extra):
 n=5000; rng=np.random.RandomState(seed); z=rng.standard_t(df=P['nu'],size=n)*np.sqrt((P['nu']-2)/P['nu']); r=np.zeros(n); h=np.zeros(n+extra); h[0]=P['omega']/(1-P['alpha']-P['gamma']/2-P['beta']); r[0]=P['mu']+np.sqrt(h[0])*z[0]
 for t in range(1,n):
  ind=1.0 if r[t-1]-P['mu']<0 else 0.0; eps=r[t-1]-P['mu']-P['ar1']*(r[t-2] if t>=2 else 0); h[t]=max(P['omega']+(P['alpha']+P['gamma']*ind)*eps**2+P['beta']*h[t-1],1e-8); r[t]=P['mu']+P['ar1']*r[t-1]+np.sqrt(h[t])*z[t]
 if extra:
  ind=1.0 if r[-1]-P['mu']<0 else 0.0; eps=r[-1]-P['mu']-P['ar1']*r[-2]; h[n]=max(P['omega']+(P['alpha']+P['gamma']*ind)*eps**2+P['beta']*h[n-1],1e-8)
 return z,r,h,rng.get_state()[1].copy()
