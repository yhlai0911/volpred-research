   320	# 4. Sensitivity to persistence level
   321	# ============================================================
   322	def simulate_with_persistence(args):
   323	    """Simulate GARCH with modified persistence and compute SAR."""
   324	    seed, base_params, target_persistence, n_obs = args
   325	    params = base_params.copy()
   326	
   327	    # Scale alpha and gamma to achieve target persistence while keeping ratio
   328	    current_p = params['alpha'] + params['gamma'] / 2 + params['beta']
   329	    # Adjust beta to hit target persistence
   330	    params['beta'] = target_persistence - params['alpha'] - params['gamma'] / 2
   331	    if params['beta'] < 0:
   332	        params['beta'] = 0.01
   333	        excess = target_persistence - params['beta']
   334	        params['alpha'] = excess * (params['alpha'] / (params['alpha'] + params['gamma'] / 2))
   335	        params['gamma'] = 2 * (excess - params['alpha'])
   336	
   337	    return simulate_garch_sar_fixed_thresholds((seed, params, n_obs))
