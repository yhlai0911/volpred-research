/bin/zsh -lc "uv run python - <<'PY'
import numpy as np
import pandas as pd
from pathlib import Path
p=Path('paper/volatility-absorption/data/spy_gld_tlt_qqq_eem_vix_2005-2026.csv')
df=pd.read_csv(p,parse_dates=['date'])
df=df[(df.date>='2006-01-01')&(df.date<='2026-04-05')].copy()
df['ret']=np.log(df.spy_adj_close/df.spy_adj_close.shift(1))*100
df=df.dropna(subset=['ret','vix_close'])
df['dvix']=df.vix_close.diff()
df=df.dropna(subset=['dvix']).reset_index(drop=True)
a=np.abs(df.ret.to_numpy()); V=df.vix_close.to_numpy(); dV=df.dvix.to_numpy()
shock=np.abs(dV)>2
calm=V<15; high=(V>=25)&(V<30); up=dV>2; down=dV< -2

def sar(mask_event, reg):
    return a[mask_event&reg].mean()/a[(~shock)&reg].mean()
def stats(idx=None):
    if idx is None:
        aa,VV,dVV=a,V,dV
    else:
        aa,VV,dVV=a[idx],V[idx],dV[idx]
    sh=np.abs(dVV)>2; ca=VV<15; hi=(VV>=25)&(VV<30); uu=dVV>2; dd=dVV< -2
    def s(ev,rg):
        den=aa[(~sh)&rg]
        num=aa[ev&rg]
        if len(num)==0 or len(den)==0:return np.nan
        return num.mean()/den.mean()
    pooled=s(sh,ca)-s(sh,hi)
    upv=s(uu,ca)-s(uu,hi)
    dnv=s(dd,ca)-s(dd,hi)
    return pooled,upv,dnv,pooled-upv
print('point',stats(), 'n', len(df), 'cells', (calm&up).sum(), (calm&down).sum(), (high&up).sum(),(high&down).sum())

def boot_iid(B=10000,seed=20260712):
    rng=np.random.RandomState(seed); out=np.empty((B,4))
    n=len(a)
    for b in range(B): out[b]=stats(rng.randint(0,n,n))
    return out

def boot_mbb(L,B=5000,seed=20260712):
    rng=np.random.RandomState(seed+L); n=len(a); m=(n+L-1)//L; out=np.empty((B,4)); base=np.arange(L)
    for b in range(B):
        starts=rng.randint(0,n,m)
        idx=((starts[:,None]+base)%n).ravel()[:n]
        out[b]=stats(idx)
    return out
for label,x in [('iid-row',boot_iid())]+[(f'mbb{L}',boot_mbb(L)) for L in (5,10,20,40)]:
    print(label,'valid',np.isfinite(x).all(1).sum())
    for j,nm in enumerate(('pooled','up','down','pooled_minus_up')):
        q=np.nanpercentile(x[:,j],[2.5,50,97.5])
        print(nm, np.round(q,4))
