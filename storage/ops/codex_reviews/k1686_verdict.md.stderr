     1	"""
     2	K897: Null Simulation for Volatility Absorption — Does SAR Arise Mechanically from GARCH?
     3	
     4	Purpose:
     5	  Paper 8 (volatility-absorption) R1 found SEVERE S1: "No null simulation — the paper
     6	  does not show the SAR decline cannot arise mechanically from a standard GARCH with
     7	  no absorption."
     8	
     9	  The SAR (Shock Amplification Ratio) = mean(|r_t| on shock days) / mean(|r_t| on normal days)
    10	  within each VIX regime. The paper claims SAR declines from 3.16x (calm) to 2.32x (high),
    11	  revealing a real absorption phenomenon.
    12	
    13	  A critic could argue: GARCH already has mean-reverting variance (persistence < 1),
    14	  so SAR decline is just GARCH mean reversion, not a new phenomenon.
    15	
    16	Methodology:
    17	  1. Fit GJR-GARCH(1,1) with Student-t innovations to SPY returns (2006-2026)
    18	  2. Simulate 10,000 paths of length 5,000 from this fitted GARCH (NO absorption mechanism)
    19	  3. For each simulated path, compute SAR at each VIX regime equivalent
    20	  4. Compare simulated SAR distribution to empirical SAR from real data
    21	
    22	Key Question:
    23	  If simulated GARCH SAR matches empirical SAR → absorption is just GARCH mean reversion (null supported)
    24	  If empirical SAR differs significantly → there IS a real phenomenon beyond GARCH
    25	
    26	Statistical Tests:
    27	  - Mean SAR comparison (simulated vs empirical) at each regime
    28	  - 95% CI from simulation
    29	  - Kolmogorov-Smirnov test
    30	  - Effect size (Cohen's d)
    31	
    32	References:
    33	  - Bollerslev (1986): GARCH model
    34	  - Glosten, Jagannathan, Runkle (1993): GJR-GARCH
    35	  - Engle & Ng (1993): News impact curve
    36	  - Our paper: volatility-absorption, SAR definition (Equation 1)
    37	  - K716: Original SAR computation on real data
    38	
    39	Data Source: yfinance (SPY, ^VIX), 2006-01-01 to 2026-04-04
    40	"""
    41	
    42	import json
    43	import warnings
    44	import numpy as np
    45	import pandas as pd
    46	from scipy import stats
    47	from arch import arch_model
    48	from concurrent.futures import ProcessPoolExecutor
    49	import multiprocessing
    50	
    51	warnings.filterwarnings('ignore')
    52	
    53	# ============================================================
    54	# 1. Download real data and compute empirical SAR
    55	# ============================================================
    56	def get_empirical_data():
    57	    """Download SPY + VIX data and compute empirical SAR."""
    58	    import yfinance as yf
    59	
    60	    spy = yf.download('SPY', start='2006-01-01', end='2026-04-05', progress=False)
    61	    vix = yf.download('^VIX', start='2006-01-01', end='2026-04-05', progress=False)
    62	
    63	    # Handle MultiIndex columns
    64	    if isinstance(spy.columns, pd.MultiIndex):
    65	        spy.columns = spy.columns.get_level_values(0)
    66	    if isinstance(vix.columns, pd.MultiIndex):
    67	        vix.columns = vix.columns.get_level_values(0)
    68	
    69	    # Compute log returns
    70	    spy_ret = np.log(spy['Close'] / spy['Close'].shift(1)).dropna() * 100  # percent
    71	    vix_close = vix['Close'].reindex(spy_ret.index)
    72	
    73	    # Align
    74	    df = pd.DataFrame({
    75	        'ret': spy_ret,
    76	        'vix': vix_close,
    77	    }).dropna()
    78	
    79	    df['abs_ret'] = df['ret'].abs()
    80	    df['delta_vix'] = df['vix'].diff()
    81	    df['shock'] = df['delta_vix'].abs() > 2  # shock threshold = 2
    82	
    83	    return df
    84	
    85	
    86	def compute_sar_from_data(df):
    87	    """Compute SAR for each VIX regime from a DataFrame with 'abs_ret', 'vix', 'shock' columns."""
    88	    regimes = {
    89	        'calm (<15)': (0, 15),
    90	        'normal (15-20)': (15, 20),
    91	        'elevated (20-25)': (20, 25),
    92	        'high (25-30)': (25, 30),
    93	        'crisis (>=30)': (30, 200),
    94	    }
    95	
    96	    results = {}
    97	    for name, (lo, hi) in regimes.items():
    98	        mask = (df['vix'] >= lo) & (df['vix'] < hi)
    99	        shock_mask = mask & df['shock']
   100	        normal_mask = mask & ~df['shock']
   101	
   102	        n_shock = shock_mask.sum()
   103	        n_normal = normal_mask.sum()
   104	
   105	        if n_shock > 5 and n_normal > 5:
   106	            mean_shock = df.loc[shock_mask, 'abs_ret'].mean()
   107	            mean_normal = df.loc[normal_mask, 'abs_ret'].mean()
   108	            sar = mean_shock / mean_normal
   109	        else:
   110	            mean_shock = np.nan
   111	            mean_normal = np.nan
   112	            sar = np.nan
   113	
   114	        results[name] = {
   115	            'n_shock': int(n_shock),
   116	            'n_normal': int(n_normal),
   117	            'mean_shock': float(mean_shock) if not np.isnan(mean_shock) else None,
   118	            'mean_normal': float(mean_normal) if not np.isnan(mean_normal) else None,
   119	            'sar': float(sar) if not np.isnan(sar) else None,
   120	        }
   121	
   122	    return results
   123	
   124	
   125	# ============================================================
   126	# 2. Fit GJR-GARCH to real SPY returns
   127	# ============================================================
   128	def fit_garch(returns):
   129	    """Fit GJR-GARCH(1,1) with Student-t innovations to SPY returns."""
   130	    # returns in percent
   131	    am = arch_model(returns, vol='Garch', p=1, o=1, q=1, dist='t', mean='AR', lags=1)
   132	    res = am.fit(disp='off')
   133	
   134	    params = {
   135	        'mu': res.params.get('Const', 0),
   136	        'ar1': res.params.get('y[1]', 0) if 'y[1]' in res.params else 0,
   137	        'omega': res.params['omega'],
   138	        'alpha': res.params['alpha[1]'],
   139	        'gamma': res.params.get('gamma[1]', 0),
   140	        'beta': res.params['beta[1]'],
   141	        'nu': res.params['nu'],
   142	        'persistence': res.params['alpha[1]'] + res.params.get('gamma[1]', 0) / 2 + res.params['beta[1]'],
   143	    }
   144	
   145	    return res, params
   146	
   147	
   148	# ============================================================
   149	# 3. Simulate GARCH paths and compute SAR
   150	# ============================================================
   151	def simulate_garch_path(args):
   152	    """Simulate one GJR-GARCH path and compute SAR.
   153	
   154	    Since GARCH doesn't have a VIX, we use conditional volatility percentiles
   155	    to define regimes (analogous to VIX regimes).
   156	    """
   157	    seed, params, n_obs, vix_percentiles = args
   158	    rng = np.random.RandomState(seed)
   159	
   160	    mu = params['mu']
   161	    ar1 = params['ar1']
   162	    omega = params['omega']
   163	    alpha = params['alpha']
   164	    gamma = params['gamma']
   165	    beta = params['beta']
   166	    nu = params['nu']
   167	
   168	    # Generate Student-t innovations
   169	    # scipy t distribution: scale by sqrt((nu-2)/nu) to get unit variance
   170	    z = rng.standard_t(df=nu, size=n_obs) * np.sqrt((nu - 2) / nu)
   171	
   172	    # Simulate returns
   173	    r = np.zeros(n_obs)
   174	    h = np.zeros(n_obs)  # conditional variance
   175	
   176	    # Initialize
   177	    unconditional_var = omega / (1 - alpha - gamma / 2 - beta)
   178	    h[0] = unconditional_var
   179	    r[0] = mu + np.sqrt(h[0]) * z[0]
   180	
   181	    for t in range(1, n_obs):
   182	        # GJR-GARCH variance equation
   183	        indicator = 1.0 if r[t-1] - mu < 0 else 0.0
   184	        eps = r[t-1] - mu - ar1 * (r[t-2] if t >= 2 else 0)
   185	        h[t] = omega + (alpha + gamma * indicator) * eps**2 + beta * h[t-1]
   186	        h[t] = max(h[t], 1e-8)  # floor
   187	
   188	        # Return with AR(1)
   189	        r[t] = mu + ar1 * r[t-1] + np.sqrt(h[t]) * z[t]
   190	
   191	    # Compute conditional vol (annualized, to be analogous to VIX)
   192	    # VIX ~ sqrt(h) * sqrt(252) where h is daily variance in decimal
   193	    # Our returns are in percent, so sqrt(h) is daily vol in percent
   194	    # VIX equivalent: sqrt(h) * sqrt(252)
   195	    cond_vol_ann = np.sqrt(h) * np.sqrt(252)
   196	
   197	    # Define "shock" as large absolute change in conditional vol
   198	    # Analogous to |delta_VIX| > 2
   199	    delta_vol = np.diff(cond_vol_ann)
   200	    delta_vol = np.concatenate([[0], delta_vol])
   201	
   202	    # Use empirical VIX percentile thresholds for regime definition
   203	    # This ensures comparable regime sizes
   204	    abs_ret = np.abs(r)
   205	
   206	    # Define regimes based on conditional vol using empirical VIX thresholds
   207	    regimes = {
   208	        'calm (<15)': (0, vix_percentiles[15]),
   209	        'normal (15-20)': (vix_percentiles[15], vix_percentiles[20]),
   210	        'elevated (20-25)': (vix_percentiles[20], vix_percentiles[25]),
   211	        'high (25-30)': (vix_percentiles[25], vix_percentiles[30]),
   212	        'crisis (>=30)': (vix_percentiles[30], 1e6),
   213	    }
   214	
   215	    # Shock threshold: use same percentile as empirical
   216	    # In real data, |delta_VIX| > 2 captures about 15-20% of days
   217	    shock_pct = np.percentile(np.abs(delta_vol[1:]), 80)  # top 20% as shocks
   218	    shock = np.abs(delta_vol) > shock_pct
   219	
   220	    results = {}
   221	    for name, (lo, hi) in regimes.items():
   222	        mask = (cond_vol_ann >= lo) & (cond_vol_ann < hi)
   223	        shock_mask = mask & shock
   224	        normal_mask = mask & ~shock
   225	
   226	        n_shock = shock_mask.sum()
   227	        n_normal = normal_mask.sum()
   228	
   229	        if n_shock > 5 and n_normal > 5:
   230	            mean_shock = abs_ret[shock_mask].mean()
   231	            mean_normal = abs_ret[normal_mask].mean()
   232	            sar = mean_shock / mean_normal
   233	        else:
   234	            sar = np.nan
   235	
   236	        results[name] = sar
   237	
   238	    return results
   239	
   240	
