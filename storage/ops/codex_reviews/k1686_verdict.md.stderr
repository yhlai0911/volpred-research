import numpy as np
from numba import njit
MU=0.07641013516248987; OMEGA=0.022188769677603346; ALPHA=0.0; GAMMA=0.24422367045225124; BETA=0.8594147336803625; NU=5.647879075643755; ANN=np.sqrt(252.0); N=5000
@njit
def one(seed):
 np.random.seed(seed); z=np.random.standard_t(NU,N)*np.sqrt((NU-2.0)/NU); r=np.zeros(N); h=np.zeros(N+1); h[0]=OMEGA/(1-ALPHA-GAMMA/2-BETA); r[0]=MU+np.sqrt(h[0])*z[0]
 for t in range(1,N):
  ind=1.0 if r[t-1]-MU<0 else 0.0; eps=r[t-1]-MU; h[t]=max(OMEGA+(ALPHA+GAMMA*ind)*eps*eps+BETA*h[t-1],1e-8); r[t]=MU+np.sqrt(h[t])*z[t]
 ind=1.0 if r[N-1]-MU<0 else 0.0; eps=r[N-1]-MU; h[N]=max(OMEGA+(ALPHA+GAMMA*ind)*eps*eps+BETA*h[N-1],1e-8)
 P=np.sqrt(h[1:])*ANN; d=np.zeros(N)
 for t in range(1,N): d[t]=P[t]-P[t-1]
 sums=np.zeros((2,2,2)); counts=np.zeros((2,2,2),np.int64) # spec pooled/up, regime calm/high, event/normal
 for t in range(1,N):
  reg=-1
  if P[t-1]<15: reg=0
  elif P[t-1]>=25 and P[t-1]<30: reg=1
  if reg>=0:
   ar=abs(r[t]); anysh=abs(d[t])>2; up=d[t]>2
   if not anysh:
    for sp in range(2): sums[sp,reg,1]+=ar; counts[sp,reg,1]+=1
   if anysh: sums[0,reg,0]+=ar; counts[0,reg,0]+=1
   if up: sums[1,reg,0]+=ar; counts[1,reg,0]+=1
 out=np.empty(2)
 for sp in range(2):
  if counts[sp,0,0]>5 and counts[sp,0,1]>5 and counts[sp,1,0]>5 and counts[sp,1,1]>5:
   out[sp]=sums[sp,0,0]/counts[sp,0,0]/(sums[sp,0,1]/counts[sp,0,1])-sums[sp,1,0]/counts[sp,1,0]/(sums[sp,1,1]/counts[sp,1,1])
  else: out[sp]=np.nan
 return out
@njit
def allruns(nsim):
 x=np.empty((nsim,2))
 for s in range(nsim): x[s]=one(s)
 return x
x=allruns(10000)
for j,name in enumerate(('pooled_E','up_E')):
 y=x[:,j]; y=y[~np.isnan(y)]; print(name,len(y),np.mean(y),np.std(y),np.percentile(y,[2.5,97.5]))
