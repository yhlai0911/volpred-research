{
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "62"
  },
  "permissions": {
    "allow": [
      "Bash(agy --version)",
      "Bash(npm ls *)",
      "Bash(brew list *)",
      "Read(//opt/homebrew/Caskroom/antigravity/1.23.2,4781536860569600/**)",
      "Bash(brew info *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/yhlai0911/volpred-research/scripts/auto_start_codex_loop.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash /Users/yhlai0911/volpred-research/scripts/warm_tcc_authorization.sh",
            "timeout": 35
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/yhlai0911/volpred-research/.claude/hooks/email_pool_reminder.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd /Users/yhlai0911/volpred-research && bash scripts/save_session_state.sh 2>/dev/null || true",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python3 /Users/yhlai0911/volpred-research/scripts/hooks/enforce_final_text.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd /Users/yhlai0911/volpred-research && bash scripts/save_session_state.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/yhlai0911/volpred-research/.claude/hooks/pretooluse-bash-optimizer.sh"
          }
        ]
      }
    ]
  }
}