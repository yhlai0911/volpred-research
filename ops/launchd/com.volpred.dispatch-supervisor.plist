<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.volpred.dispatch-supervisor</string>

  <!-- REAL-RUN (Deliverable 7 cutover, 2026-07-04): --dry-run REMOVED. This is
       now the sole real dispatcher — legacy com.volpred.hourly-dispatch was
       `launchctl disable`d at cutover (boss approved twice via Telegram
       msg124 + msg127). Real-run path verified by isolated worker smoke (real
       claude spawn, exit 0) + PHASE-Z safety-net ported (phase_z.py, Codex
       CONDITIONAL_PASS). History: docs/refactor_plan_hourly_dispatch.md
       §Deliverable 7. INSTANT ROLLBACK if a real fire misbehaves:
         launchctl enable  gui/<UID>/com.volpred.hourly-dispatch   # re-arm legacy
         launchctl bootout gui/<UID>/com.volpred.dispatch-supervisor
         # then re-add <string>--dry-run</string> here + bootstrap to shadow. -->
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/uv</string>
    <string>run</string>
    <string>python</string>
    <string>-m</string>
    <string>scripts.dispatch_supervisor.supervisor</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/yhlai0911/volpred-research</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/yhlai0911/.nvm/versions/node/v22.20.0/bin:/Users/yhlai0911/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>/Users/yhlai0911</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- Plan §7 risk mitigation: rate-limit respawn so a crash-loop doesn't
       spin-restart faster than send_loop_crash's own 300s alert dedup. -->
