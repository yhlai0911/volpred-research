<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.volpred.dispatch-supervisor</string>

  <!-- REAL-RUN (Deliverable 7 cutover, 2026-07-04): the dry-run flag is REMOVED. This is
       now the sole real dispatcher — legacy com.volpred.hourly-dispatch was
       `launchctl disable`d at cutover (boss approved twice via Telegram
       msg124 + msg127). Real-run path verified by isolated worker smoke (real
       claude spawn, exit 0) + PHASE-Z safety-net ported (phase_z.py, Codex
       CONDITIONAL_PASS). History: docs/refactor_plan_hourly_dispatch.md
       §Deliverable 7. Rollback must retain the single supervisor owner; never
       re-arm com.volpred.hourly-dispatch. Writer isolation itself is fail-closed:
       an unavailable workspace requeues the fire instead of falling back to
       shared-main execution. -->
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/uv</string>
    <string>run</string>
    <string>python</string>
    <string>/Users/yhlai0911/.volpred/bin/dispatch-supervisor-stage0.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/yhlai0911/volpred-research</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/yhlai0911/.nvm/versions/node/v22.20.0/bin:/Users/yhlai0911/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>/Users/yhlai0911</string>
    <key>VOLPRED_WRITER_ISOLATION_REQUIRED</key>
    <string>1</string>
    <!-- Shared launchd coalition cannot yet couple Codex reachability
         descendants to provider-auth lease drain. Keep failover mechanically
         off until per-fire custody passes regression + live read-back. -->
    <key>VOLPRED_CODEX_FAILOVER</key>
    <string>0</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- Plan §7 risk mitigation: rate-limit respawn so a crash-loop doesn't
       spin-restart faster than send_loop_crash's own 300s alert dedup. -->
  <key>ThrottleInterval</key>
  <integer>60</integer>

  <key>StandardOutPath</key>
  <string>/Users/yhlai0911/.volpred/logs/dispatch_supervisor_launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/yhlai0911/.volpred/logs/dispatch_supervisor_launchd.err</string>
</dict>
</plist>
