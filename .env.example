# VolPred — 環境變數範本（換機 / 新主機 setup 用）
# .gitignore 排除真正的 .env / .env.local（含密鑰），只追蹤本範本。
# 換機時：複製本檔 → 填入真值 → 分別存成下列三個檔。真值從舊主機 1Password /
# 既有 .env 取得，不要 commit 真值。
#
# ───────────────────────────────────────────────────────────────────
# 檔案 1：專案根目錄 `.env`（email / 一般 API）
# ───────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=VolPred
ADMIN_NOTIFICATION_EMAILS=yihao.lai@gmail.com
GOOGLE_CLOUD_API_KEY=        # gemini_ask.py / Gemini API
OPENAI_API_KEY=              # Codex CLI 備援 / 一般 OpenAI
META_GRAPH_API=              # FB Graph（目前 App Review 卡關，多走 Chrome）
VOLPRED_REMOTE_URL=https://volpred.zeabur.app

# ───────────────────────────────────────────────────────────────────
# 檔案 2：專案根目錄 `.env.local`（Supabase 後端 / Mirror / FRED）
# ───────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=   # service_role（後端寫入；勿外洩）
FRED_API_KEY=                # FRED 總經資料
RESEARCH_MIRROR_TOKEN=       # Mirror API 寫入 token
VOLPRED_MIRROR_URL=          # Mirror API base URL
OPS_ADMIN_TOKEN=             # ops 控制面 admin token

# ───────────────────────────────────────────────────────────────────
# 檔案 3：`frontend-v2-fix/.env.local`（Next.js 前端；獨立 git repo volpred-v2）
# ───────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=   # anon（前端公開可用）
# SUPABASE_SERVICE_ROLE_KEY=       # 前端 server route 用（勿外洩）
# NEXT_PUBLIC_SITE_URL=https://volpred.zeabur.app
# OPS_ADMIN_EMAILS=yihao.lai@gmail.com
