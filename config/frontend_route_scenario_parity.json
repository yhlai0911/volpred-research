{
  "schema_version": "frontend-route-scenario-parity.v1",
  "frontend_target": "frontend-v2-fix",
  "route_rules": [
    {
      "id": "public_home",
      "pattern": "^/$",
      "expected_modes": [
        "original",
        "v3"
      ],
      "access": "public",
      "authoritative_data_owner_refs": [
        "frontend-v2-fix/src/lib/data-server.ts",
        "frontend-v2-fix/src/components/v3/hooks/useV3Data.ts"
      ]
    },
    {
      "id": "public_static",
      "pattern": "^/(about|disclaimer)$",
      "expected_modes": [
        "original",
        "v3"
      ],
      "access": "public",
      "authoritative_data_owner_refs": [
        "frontend-v2-fix/src/app/about/page.tsx",
        "frontend-v2-fix/src/app/disclaimer/page.tsx",
        "frontend-v2-fix/src/app/v3/about/page.tsx",
        "frontend-v2-fix/src/app/v3/disclaimer/page.tsx"
      ]
    },
    {
      "id": "admin",
      "pattern": "^/admin(?:/.*)?$",
      "expected_modes": [
        "original",
        "v3"
      ],
      "access": "admin",
