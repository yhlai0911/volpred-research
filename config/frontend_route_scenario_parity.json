        "frontend-v2-fix/src/lib/admin-auth.ts",
        "frontend-v2-fix/src/lib/admin-ops.ts",
        "frontend-v2-fix/src/app/api/admin/session/route.ts"
      ]
    },
    {
      "id": "auth_callback",
      "pattern": "^/auth/callback$",
      "expected_modes": [
        "shared"
      ],
      "access": "public",
      "authoritative_data_owner_refs": [
        "frontend-v2-fix/src/app/auth/callback/route.ts",
        "frontend-v2-fix/src/lib/supabase-browser.ts"
