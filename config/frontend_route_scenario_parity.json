  "scenarios": [
    {
      "id": "public_first_paint",
      "required_route_rules": [
        "public_home",
        "reports",
        "digest"
      ],
      "required_modes": [
        "original",
        "v3"
      ],
      "evidence": [
        {
          "path": "frontend-v2-fix/src/app/page.tsx",
          "contains": [
            "getFeed",
            "initialFeed"
          ]
        },
        {
          "path": "frontend-v2-fix/src/app/v3/page.tsx",
          "contains": [
            "getFeed",
            "initialData"
          ]
        }
      ]
    },
    {
      "id": "auth_callback",
      "required_route_rules": [
