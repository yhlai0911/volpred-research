        "v3"
      ],
      "access": "public",
      "authoritative_data_owner_refs": [
        "frontend-v2-fix/src/app/v3/brand/page.tsx"
      ],
      "mode_dispositions": {
        "original": {
          "status": "known_gap",
          "reason": "v3-only brand reference surface; T20 decides whether original needs an equivalent"
        }
      }
