{
  "schema_version": "frontend-route-scenario-parity.v1",
  "frontend_target": "frontend-v2-fix",
  "source_revision_policy": {
    "nested_git_required": true
  },
  "required_scenario_ids": [
    "public_first_paint",
    "auth_callback",
    "member_navigation",
    "admin_observer",
    "seo",
    "mobile_navigation",
    "accessibility_navigation"
  ],
  "route_rules": [
    {
      "id": "public_home",
      "pattern": "^/$",
      "expected_modes": [
        "original",
        "v3"
      ],
      "access": "public",
      "capabilities": [
        "feed",
        "strategy_overview",
        "digest"
      ],
      "mode_advantages": {
        "original": [
          "server_authoritative_first_paint"
        ],
        "v3": [
          "editorial_information_architecture"
        ]
      },
      "authoritative_data_owner_refs": {
        "original": [
          "$surface",
          "frontend-v2-fix/src/lib/data-server.ts"
        ],
        "v3": [
          "$surface",
          "frontend-v2-fix/src/components/v3/hooks/useV3Data.ts"
        ]
      }
    },
    {
